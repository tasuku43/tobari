---
import { diagrams } from "../data/diagrams";
import { diagramsJa } from "../data/diagrams.ja";

interface Props {
  headingLevel?: 2 | 3;
  title?: string;
  description?: string;
  compact?: boolean;
  networkDetail?: boolean;
}

const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const {
  headingLevel = 2,
  title = isJapanese
    ? "Gateway が四つの通信経路を仲介する"
    : "Gateway coordinates four conversations",
  description = isJapanese
    ? "コンポーネントの位置は変わりません。通信経路を一つ選ぶと、その境界を越えて送る情報と、送らない情報を確認できます。"
    : "The positions stay fixed. Select one conversation to inspect what crosses that boundary and what does not.",
  compact = false,
  networkDetail = false,
} = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const source = (isJapanese ? diagramsJa : diagrams)["minimal-system"];
const node = (id: string) => source.nodes.find((item) => item.id === id)!;

const conversationsEn = [
  {
    id: "proxy",
    number: "01",
    label: "Proxy",
    from: "Workspace",
    to: "Gateway",
    fromId: "workspace",
    toId: "gateway",
    sent: "HTTP method, URL, headers, and a streaming body",
    withheld: "No caller-supplied project identity becomes trusted",
    result: "Gateway receives the request on the project network",
    failure: "Processing stops before policy or upstream work",
  },
  {
    id: "policy",
    number: "02",
    label: "Policy",
    from: "Gateway",
    to: "OPA",
    fromId: "gateway",
    toId: "opa",
    sent: "Trusted principal and normalized HTTP decision dimensions",
    withheld: "Request body, broker handle, and credential values",
    result: "One structured allow or deny decision",
    failure: "Gateway does not connect upstream",
  },
  {
    id: "credential",
    number: "03",
    label: "Credential",
    from: "Gateway",
    to: "Auth Broker",
    fromId: "gateway",
    toId: "broker",
    sent: "Bound handle and principal for introspection; exact binding after allow",
    withheld: "Secret or renewable provider state from Workspace and OPA",
    result:
      "Non-secret metadata, then the declared post-policy resolve, refresh, or sign action",
    failure: "The request fails closed without fallback",
  },
  {
    id: "egress",
    number: "04",
    label: "Egress",
    from: "Gateway",
    to: "Upstream",
    fromId: "gateway",
    toId: "upstream",
    sent: "The authorized request over a separate connection",
    withheld: "Policy internals, principal registry, and broker handle",
    result: "Upstream receives only the Gateway connection",
    failure: "An upstream error does not change policy",
  },
] as const;
const conversationsJa = [
  {
    id: "proxy",
    number: "01",
    label: "プロキシ",
    from: "Workspace",
    to: "Gateway",
    fromId: "workspace",
    toId: "gateway",
    sent: "HTTP メソッド、URL、ヘッダー、ストリーミングされる本文",
    withheld: "呼び出し元が申告したプロジェクト識別情報は信頼しない",
    result: "Gateway がプロジェクト専用ネットワーク上でリクエストを受け取る",
    failure: "ポリシー判断や接続先の処理より前に停止する",
  },
  {
    id: "policy",
    number: "02",
    label: "ポリシー",
    from: "Gateway",
    to: "OPA",
    fromId: "gateway",
    toId: "opa",
    sent: "信頼済みのプロジェクトプリンシパルと、正規化した HTTP 通信の情報",
    withheld: "リクエスト本文、ブローカーのハンドル、認証情報の値",
    result: "構造化された許可または拒否の判断一つ",
    failure: "Gateway は接続先へ接続しない",
  },
  {
    id: "credential",
    number: "03",
    label: "認証情報",
    from: "Gateway",
    to: "Auth Broker",
    fromId: "gateway",
    toId: "broker",
    sent: "秘密を使わない検査に必要な、結び付いたハンドルとプリンシパル。許可後は対象と完全に一致する結び付き",
    withheld:
      "Workspace と OPA へは秘密情報や更新可能なプロバイダー状態を送らない",
    result:
      "秘密を含まないメタデータを返した後、宣言済みの解決、更新、または署名処理をポリシー許可後に実行する",
    failure: "別方式へフォールバックせず、許可しないまま失敗する",
  },
  {
    id: "egress",
    number: "04",
    label: "外向き通信",
    from: "Gateway",
    to: "Upstream",
    fromId: "gateway",
    toId: "upstream",
    sent: "独立した接続で送る許可済みリクエスト",
    withheld: "ポリシーの内部情報、プリンシパル登録情報、ブローカーのハンドル",
    result: "Upstream が受け取る接続は Gateway からのものだけ",
    failure: "接続先のエラーはポリシーを変更しない",
  },
] as const;
const conversations = isJapanese ? conversationsJa : conversationsEn;
const ui = isJapanese
  ? {
      eyebrow: "コンポーネント図",
      scrollableMap: "横方向にスクロールできるコンポーネント図",
      mapDescription:
        "Workspace と接続先は、ホストが管理する共有クラスターの両側にあります。クラスターの中央に Gateway、その上に OPA、下に Auth Broker があります。",
      cluster: "Tobari 共有クラスター · ホストが管理",
      projectNetwork: "プロジェクト専用の内部ネットワーク",
      egress: "Gateway 所有の外向き通信",
      networkEnforcement: "ネットワーク + 通信制御",
      secretBoundary: "秘密情報の境界",
      external: "外部",
      untrusted: "信頼しない領域",
      control: "制御",
      conversations: "直接対話するコンポーネント",
      conversation: "対話",
      sent: "送る情報",
      notSent: "送らない情報",
      result: "結果",
      failure: "失敗時",
      transcript: "すべての対話をテキストで読む",
    }
  : {
      eyebrow: "Component map",
      scrollableMap: "Scrollable component map",
      mapDescription:
        "Workspace and Upstream sit on opposite sides of a host-owned shared cluster. Gateway is centered in that cluster, with OPA above it and Auth Broker below it.",
      cluster: "Tobari shared cluster · host-owned",
      projectNetwork: "Dedicated internal project network",
      egress: "Gateway-owned egress",
      networkEnforcement: "Network + enforcement",
      secretBoundary: "Secret boundary",
      external: "External",
      untrusted: "Untrusted",
      control: "Control",
      conversations: "Direct conversations",
      conversation: "Conversation",
      sent: "Sent",
      notSent: "Not sent",
      result: "Result",
      failure: "Failure",
      transcript: "Read every conversation as text",
    };
---

<tobari-system-map class:list={["system-map", { compact }]}>
  <figure data-active-conversation="policy">
    <figcaption>
      <span class="eyebrow">{ui.eyebrow}</span>
      <Heading>{title}</Heading>
      <p>{description}</p>
    </figcaption>

    <div class="map-scroll" tabindex="0" aria-label={ui.scrollableMap}>
      <div class="map-stage" role="img" aria-label={ui.mapDescription}>
        <div class="cluster-boundary" aria-hidden="true">
          <span>{ui.cluster}</span>
        </div>
        {
          networkDetail && (
            <>
              <span class="network-label project-network">
                {ui.projectNetwork}
              </span>
              <span class="network-label egress-network">{ui.egress}</span>
            </>
          )
        }
        <svg viewBox="0 0 1000 600" aria-hidden="true">
          <defs>
            <marker
              id="system-map-arrow"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto-start-reverse"
            >
              <path d="M 0 0 L 10 5 L 0 10 z"></path>
            </marker>
          </defs>
          <path
            class="conversation-route route-proxy"
            d="M 300 300 L 420 300"
            marker-end="url(#system-map-arrow)"></path>
          <path
            class="conversation-route route-policy"
            d="M 500 235 L 500 180"
            marker-start="url(#system-map-arrow)"
            marker-end="url(#system-map-arrow)"></path>
          <path
            class="conversation-route route-credential"
            d="M 500 365 L 500 420"
            marker-start="url(#system-map-arrow)"
            marker-end="url(#system-map-arrow)"></path>
          <path
            class="conversation-route route-egress"
            d="M 580 300 L 700 300"
            marker-end="url(#system-map-arrow)"></path>
        </svg>

        {
          conversations.map((conversation) => (
            <span
              class:list={["conversation-number", `number-${conversation.id}`]}
              aria-hidden="true"
            >
              {conversation.number.replace(/^0/, "")}
            </span>
          ))
        }

        {
          ["workspace", "gateway", "opa", "broker", "upstream"].map((id) => {
            const item = node(id);
            return (
              <article
                class:list={[
                  "map-node",
                  `node-${id}`,
                  `kind-${item.kind}`,
                  id === "gateway" && "node-active",
                  id === "opa" && "node-active",
                ]}
                data-node={id}
              >
                <span class="node-kind">
                  {id === "gateway"
                    ? ui.networkEnforcement
                    : id === "broker"
                      ? ui.secretBoundary
                      : id === "upstream"
                        ? ui.external
                        : id === "workspace"
                          ? ui.untrusted
                          : id === "opa"
                            ? ui.control
                            : item.kind}
                </span>
                <h3>{item.label}</h3>
                <p>{item.detail}</p>
              </article>
            );
          })
        }
      </div>
    </div>

    <ol class="conversation-tabs" aria-label={ui.conversations}>
      {
        conversations.map((conversation) => (
          <li>
            <button
              type="button"
              data-conversation={conversation.id}
              aria-pressed={conversation.id === "policy" ? "true" : "false"}
              disabled
            >
              <span>
                {conversation.number} · {conversation.label}
              </span>
              <strong>
                {conversation.from} ↔ {conversation.to}
              </strong>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="conversation-details" aria-live="polite">
      {
        conversations.map((conversation) => (
          <section
            data-conversation-detail={conversation.id}
            hidden={conversation.id !== "policy"}
          >
            <header>
              <span>
                {ui.conversation} {conversation.number}
              </span>
              <strong>{conversation.label}</strong>
            </header>
            <dl>
              <div>
                <dt>{ui.sent}</dt>
                <dd>{conversation.sent}</dd>
              </div>
              <div>
                <dt>{ui.notSent}</dt>
                <dd>{conversation.withheld}</dd>
              </div>
              <div>
                <dt>{ui.result}</dt>
                <dd>{conversation.result}</dd>
              </div>
              <div>
                <dt>{ui.failure}</dt>
                <dd>{conversation.failure}</dd>
              </div>
            </dl>
          </section>
        ))
      }
    </div>

    <details class="map-transcript">
      <summary>{ui.transcript}</summary>
      <ol>
        {
          conversations.map((conversation) => (
            <li>
              <strong>
                {conversation.from} ↔ {conversation.to}
              </strong>
              <dl>
                <div>
                  <dt>{ui.sent}</dt>
                  <dd>{conversation.sent}</dd>
                </div>
                <div>
                  <dt>{ui.notSent}</dt>
                  <dd>{conversation.withheld}</dd>
                </div>
                <div>
                  <dt>{ui.result}</dt>
                  <dd>{conversation.result}</dd>
                </div>
                <div>
                  <dt>{ui.failure}</dt>
                  <dd>{conversation.failure}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
    </details>
  </figure>
</tobari-system-map>

<script>
  class TobariSystemMap extends HTMLElement {
    connectedCallback() {
      const figure = this.querySelector("figure");
      const buttons = this.querySelectorAll<HTMLButtonElement>(
        "[data-conversation]",
      );
      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener("click", () => {
          const id = button.dataset.conversation;
          if (!id || !figure) return;
          figure.dataset.activeConversation = id;
          buttons.forEach((candidate) =>
            candidate.setAttribute(
              "aria-pressed",
              String(candidate === button),
            ),
          );
          this.querySelectorAll<HTMLElement>(
            "[data-conversation-detail]",
          ).forEach((detail) => {
            detail.hidden = detail.dataset.conversationDetail !== id;
          });
          const active = conversationsForMap[id];
          this.querySelectorAll<HTMLElement>("[data-node]").forEach((item) =>
            item.classList.toggle(
              "node-active",
              Boolean(
                active &&
                [active.from, active.to].includes(item.dataset.node || ""),
              ),
            ),
          );
        });
      });
    }
  }

  const conversationsForMap: Record<string, { from: string; to: string }> = {
    proxy: { from: "workspace", to: "gateway" },
    policy: { from: "gateway", to: "opa" },
    credential: { from: "gateway", to: "broker" },
    egress: { from: "gateway", to: "upstream" },
  };

  if (!customElements.get("tobari-system-map"))
    customElements.define("tobari-system-map", TobariSystemMap);
</script>

<style>
  .system-map {
    display: block;
    margin-block: 2rem;
  }
  .system-map figure {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
  }
  .system-map figcaption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
    gap: 0 2rem;
    align-items: end;
    padding: 1.2rem 1.35rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  .system-map figcaption .eyebrow {
    grid-column: 1;
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .system-map figcaption h2,
  .system-map figcaption h3 {
    grid-column: 1;
    margin: 0.25rem 0 0;
  }
  .system-map figcaption p {
    grid-column: 2;
    grid-row: 1 / 3;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .map-scroll {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }
  .map-stage {
    position: relative;
    min-width: 45rem;
    height: 31.5rem;
    overflow: hidden;
    background-image:
      linear-gradient(var(--sl-color-gray-6) 1px, transparent 1px),
      linear-gradient(90deg, var(--sl-color-gray-6) 1px, transparent 1px);
    background-size: 2rem 2rem;
  }
  .cluster-boundary {
    position: absolute;
    inset: 1.6rem 35% 1.6rem;
    border: 1px dashed var(--tobari-diagnostic);
    background: color-mix(in srgb, var(--tobari-diagnostic) 5%, transparent);
  }
  .cluster-boundary span {
    position: absolute;
    inset: -0.7rem auto auto 1rem;
    padding-inline: 0.35rem;
    background: var(--sl-color-gray-7);
    color: var(--tobari-diagnostic);
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .network-label {
    position: absolute;
    z-index: 1;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .project-network {
    inset: auto auto 1rem 3%;
  }
  .egress-network {
    inset: auto 3% 1rem auto;
  }
  .map-stage svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .map-stage marker path {
    fill: context-stroke;
  }
  .conversation-route {
    fill: none;
    stroke: var(--sl-color-gray-3);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .route-credential {
    stroke-dasharray: 7 6;
  }
  [data-active-conversation="proxy"] .route-proxy,
  [data-active-conversation="policy"] .route-policy,
  [data-active-conversation="credential"] .route-credential,
  [data-active-conversation="egress"] .route-egress {
    stroke: var(--tobari-control);
    stroke-width: 3;
  }
  .map-node {
    position: absolute;
    z-index: 2;
    width: 12.5rem;
    min-height: 7.5rem;
    margin: 0;
    padding: 0.9rem;
    transform: translate(-50%, -50%);
    border: 2px solid currentColor;
    background: var(--sl-color-bg);
    box-shadow: 0 0.8rem 1.6rem rgb(0 0 0 / 18%);
  }
  .node-workspace {
    left: 20%;
    top: 50%;
    color: var(--tobari-network);
    border-style: dashed;
  }
  .node-gateway {
    left: 50%;
    top: 50%;
    width: 13.75rem;
    min-height: 9rem;
    color: var(--tobari-control);
  }
  .node-opa {
    left: 50%;
    top: 20%;
    color: var(--tobari-trusted);
  }
  .node-broker {
    left: 50%;
    top: 80%;
    color: var(--tobari-secret);
    border-block-start-style: double;
    border-block-start-width: 4px;
  }
  .node-upstream {
    left: 80%;
    top: 50%;
    color: var(--tobari-network);
    border-style: dashed;
  }
  .map-node.node-active {
    outline: 3px solid var(--tobari-focus);
    outline-offset: 4px;
  }
  .node-kind {
    display: inline-block;
    padding: 0.12rem 0.35rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .map-node h3 {
    margin: 0.55rem 0 0.25rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
  }
  .map-node p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.45;
  }
  .conversation-number {
    position: absolute;
    z-index: 3;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    transform: translate(-50%, -50%);
    border: 1px solid var(--sl-color-gray-3);
    border-radius: 50%;
    background: var(--sl-color-gray-7);
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
  }
  .number-proxy {
    left: 35%;
    top: 50%;
  }
  .number-policy {
    left: 50%;
    top: 34.5%;
  }
  .number-credential {
    left: 50%;
    top: 65.5%;
  }
  .number-egress {
    left: 65%;
    top: 50%;
  }
  [data-active-conversation="proxy"] .number-proxy,
  [data-active-conversation="policy"] .number-policy,
  [data-active-conversation="credential"] .number-credential,
  [data-active-conversation="egress"] .number-egress {
    border: 2px solid var(--tobari-control);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
  .conversation-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--sl-color-gray-5);
    list-style: none;
  }
  .conversation-tabs li {
    min-width: 0;
    margin: 0;
  }
  .conversation-tabs button {
    width: 100%;
    min-height: 5rem;
    padding: 0.8rem 0.9rem;
    border: 0;
    border-inline-end: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
    color: var(--sl-color-gray-2);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .conversation-tabs li:last-child button {
    border-inline-end: 0;
  }
  .conversation-tabs button:disabled {
    cursor: default;
  }
  .conversation-tabs button[aria-pressed="true"] {
    background: var(--sl-color-gray-6);
    box-shadow: inset 0 -0.25rem var(--tobari-control);
    color: var(--sl-color-white);
  }
  .conversation-tabs button span,
  .conversation-tabs button strong {
    display: block;
  }
  .conversation-tabs button span {
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .conversation-tabs button strong {
    margin-top: 0.5rem;
    font-size: var(--sl-text-xs);
  }
  .conversation-details {
    border-block-start: 1px solid var(--sl-color-gray-5);
  }
  .conversation-details section {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
  }
  .conversation-details section[hidden] {
    display: none;
  }
  .conversation-details header {
    padding: 1rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
  .conversation-details header span,
  .conversation-details header strong {
    display: block;
  }
  .conversation-details header span {
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .conversation-details header strong {
    margin-top: 0.5rem;
  }
  .conversation-details dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }
  .conversation-details dl div {
    padding: 1rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
  .conversation-details dl div:last-child {
    border-inline-end: 0;
  }
  .conversation-details dt {
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .conversation-details dd {
    margin: 0.45rem 0 0;
    font-size: var(--sl-text-xs);
  }
  .map-transcript {
    margin: 0;
