---
import { diagrams } from "../data/diagrams";
import { diagramsJa } from "../data/diagrams.ja";

interface Props {
  headingLevel?: 2 | 3;
  title?: string;
  description?: string;
  compact?: boolean;
  networkDetail?: boolean;
}

interface Conversation {
  id: string;
  number: string;
  label: string;
  from: string;
  to: string;
  fromId: string;
  toId: string;
  sent: string;
  withheld: string;
  result: string;
  failure: string;
  optional?: boolean;
}

const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const {
  headingLevel = 2,
  title = isJapanese
    ? "一つのリクエストが Tobari を通る順序"
    : "Follow one request through Tobari",
  description = isJapanese
    ? "番号付きの矢印を追うと、Workspace から始まった通信が、どこで識別・判断され、いつ接続先へ進むかを確認できます。認証情報の経路は、ブローカー方式を使う場合だけ通ります。"
    : "Follow the numbered arrows to see where a Workspace request is identified, authorized, and finally connected upstream. The credential route is conditional on a brokered provider.",
  compact = false,
  networkDetail = false,
} = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const source = (isJapanese ? diagramsJa : diagrams)["minimal-system"];
const node = (id: string) => source.nodes.find((item) => item.id === id)!;

const conversationsEn: Conversation[] = [
  {
    id: "proxy",
    number: "01",
    label: "Request enters Gateway",
    from: "Workspace",
    to: "Gateway",
    fromId: "workspace",
    toId: "gateway",
    sent: "HTTP method, URL, headers, and a streaming body",
    withheld: "Caller-supplied project identity is not trusted",
    result: "Gateway receives the request on the project-specific interface",
    failure: "Processing stops before policy or upstream work",
  },
  {
    id: "policy",
    number: "02",
    label: "Gateway asks OPA",
    from: "Gateway",
    to: "OPA",
    fromId: "gateway",
    toId: "opa",
    sent: "Registry-derived principal and normalized HTTP decision dimensions",
    withheld: "Request body, broker handle, and credential values",
    result: "OPA receives one bounded decision input",
    failure: "Gateway does not connect upstream",
  },
  {
    id: "decision",
    number: "03",
    label: "OPA returns a decision",
    from: "OPA",
    to: "Gateway",
    fromId: "opa",
    toId: "gateway",
    sent: "One structured allow or deny result",
    withheld: "OPA does not open connections or handle credentials",
    result: "Gateway either stops the request or continues",
    failure: "Missing or malformed policy results fail closed",
  },
  {
    id: "credential",
    number: "04",
    label: "Credential work, when required",
    from: "Gateway",
    to: "Auth Broker",
    fromId: "gateway",
    toId: "broker",
    sent: "Bound handle and principal for introspection; exact binding after allow",
    withheld: "Workspace and OPA do not receive broker-managed secret state",
    result: "The declared resolve, refresh, or sign operation runs after allow",
    failure:
      "The request fails closed without switching to another credential mode",
    optional: true,
  },
  {
    id: "egress",
    number: "05",
    label: "Gateway connects upstream",
    from: "Gateway",
    to: "Upstream",
    fromId: "gateway",
    toId: "upstream",
    sent: "The authorized request over a separate connection",
    withheld: "Policy internals, principal registry, and broker handle",
    result: "Upstream sees a connection owned by Gateway",
    failure: "An upstream error does not change policy",
  },
];
const conversationsJa: Conversation[] = [
  {
    id: "proxy",
    number: "01",
    label: "リクエストが Gateway に入る",
    from: "Workspace",
    to: "Gateway",
    fromId: "workspace",
    toId: "gateway",
    sent: "HTTP メソッド、URL、ヘッダー、ストリーミングされる本文",
    withheld: "呼び出し元が申告したプロジェクト識別情報は信頼しない",
    result:
      "Gateway がプロジェクト固有のインターフェースでリクエストを受け取る",
    failure: "ポリシー判断や接続先の処理より前に停止する",
  },
  {
    id: "policy",
    number: "02",
    label: "Gateway が OPA に問い合わせる",
    from: "Gateway",
    to: "OPA",
    fromId: "gateway",
    toId: "opa",
    sent: "登録情報から導出したプリンシパルと、正規化した HTTP 通信の情報",
    withheld: "リクエスト本文、ブローカーのハンドル、認証情報の値",
    result: "OPA が上限を定めた判断入力を一つ受け取る",
    failure: "Gateway は接続先へ接続しない",
  },
  {
    id: "decision",
    number: "03",
    label: "OPA が判断を返す",
    from: "OPA",
    to: "Gateway",
    fromId: "opa",
    toId: "gateway",
    sent: "構造化された許可または拒否の結果一つ",
    withheld: "OPA は外部接続を作らず、認証情報も扱わない",
    result: "Gateway がリクエストを止めるか、次の処理へ進める",
    failure: "判断を取得できない、または応答が不正な場合は拒否する",
  },
  {
    id: "credential",
    number: "04",
    label: "必要な場合だけ認証情報を処理する",
    from: "Gateway",
    to: "Auth Broker",
    fromId: "gateway",
    toId: "broker",
    sent: "秘密を使わない検査に必要なハンドルとプリンシパル。許可後は完全一致する結び付き",
    withheld: "Workspace と OPA へ、ブローカー管理の秘密情報を送らない",
    result: "宣言済みの解決、更新、または署名処理を許可後に実行する",
    failure: "別の認証方式へ切り替えず、許可しないまま失敗する",
    optional: true,
  },
  {
    id: "egress",
    number: "05",
    label: "Gateway が接続先へ接続する",
    from: "Gateway",
    to: "接続先",
    fromId: "gateway",
    toId: "upstream",
    sent: "独立した接続で送る許可済みリクエスト",
    withheld: "ポリシーの内部情報、プリンシパル登録情報、ブローカーのハンドル",
    result: "接続先から見ると、接続元は Gateway だけ",
    failure: "接続先のエラーはポリシーを変更しない",
  },
];
const conversations = isJapanese ? conversationsJa : conversationsEn;
const ui = isJapanese
  ? {
      eyebrow: "通信フロー",
      scrollableMap: "横方向にスクロールできる通信フロー図",
      mapDescription:
        "左の Workspace から中央の Gateway へ通信が入り、Gateway が上の OPA に判断を求めます。ブローカー方式では下の Auth Broker を使い、許可後に右の接続先へ進みます。Workspace から接続先への直接経路はありません。",
      cluster: "Tobari 共有クラスター · ホストが管理",
      projectNetwork: "プロジェクト専用の内部ネットワーク",
      egress: "Gateway 所有の外向き通信",
      networkEnforcement: "通信経路の制御",
      secretBoundary: "認証情報の境界",
      external: "外部",
      untrusted: "信頼しない領域",
      control: "ポリシー判断",
      flowSteps: "番号順に処理を見る",
      step: "ステップ",
      optional: "条件付き",
      sent: "送る情報",
      notSent: "送らない情報",
      result: "結果",
      failure: "失敗時",
      transcript: "通信フローを文章で読む",
      directBlocked: "直接経路なし",
    }
  : {
      eyebrow: "Request flow",
      scrollableMap: "Scrollable request-flow diagram",
      mapDescription:
        "A request moves from Workspace to Gateway, Gateway asks OPA above it, optionally uses Auth Broker below it, and only after allow reaches Upstream on the right. Workspace has no direct route to Upstream.",
      cluster: "Tobari shared cluster · host-owned",
      projectNetwork: "Dedicated internal project network",
      egress: "Gateway-owned egress",
      networkEnforcement: "Network enforcement",
      secretBoundary: "Credential boundary",
      external: "External",
      untrusted: "Untrusted",
      control: "Policy decision",
      flowSteps: "Read the processing order",
      step: "Step",
      optional: "Conditional",
      sent: "Sent",
      notSent: "Not sent",
      result: "Result",
      failure: "Failure",
      transcript: "Read the request flow as text",
      directBlocked: "No direct route",
    };
---

<tobari-system-map class:list={["system-map", { compact }]}>
  <figure data-active-conversation="proxy">
    <figcaption>
      <span class="eyebrow">{ui.eyebrow}</span>
      <Heading>{title}</Heading>
      <p>{description}</p>
    </figcaption>

    <div class="map-scroll" tabindex="0" aria-label={ui.scrollableMap}>
      <div class="map-stage" role="img" aria-label={ui.mapDescription}>
        <div class="cluster-boundary" aria-hidden="true">
          <span>{ui.cluster}</span>
        </div>
        {
          networkDetail && (
            <>
              <span class="network-label project-network">
                {ui.projectNetwork}
              </span>
              <span class="network-label egress-network">{ui.egress}</span>
            </>
          )
        }
        <svg viewBox="0 0 1000 600" aria-hidden="true">
          <defs>
            <marker
              id="system-map-arrow"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto-start-reverse"
            >
              <path d="M 0 0 L 10 5 L 0 10 z"></path>
            </marker>
            <marker
              id="system-map-stop"
              viewBox="0 0 12 12"
              refX="8"
              refY="6"
              markerWidth="8"
              markerHeight="8"
              orient="auto"
            >
              <path d="M 3 1 L 3 11 M 7 1 L 7 11"></path>
            </marker>
          </defs>
          <path
            class="direct-blocked"
            d="M 300 330 C 440 470 620 470 700 330"
            marker-end="url(#system-map-stop)"></path>
          <path
            class="conversation-route route-proxy"
            d="M 300 300 L 420 300"
            marker-end="url(#system-map-arrow)"></path>
          <path
            class="conversation-route route-policy"
            d="M 475 235 C 450 215 450 195 475 180"
            marker-end="url(#system-map-arrow)"></path>
          <path
            class="conversation-route route-decision"
            d="M 525 180 C 550 200 550 220 525 235"
            marker-end="url(#system-map-arrow)"></path>
          <path
            class="conversation-route route-credential"
            d="M 500 365 L 500 420"
            marker-start="url(#system-map-arrow)"
            marker-end="url(#system-map-arrow)"></path>
          <path
            class="conversation-route route-egress"
            d="M 580 300 L 700 300"
            marker-end="url(#system-map-arrow)"></path>
        </svg>

        <span class="direct-blocked-label" aria-hidden="true"
          >× {ui.directBlocked}</span
        >

        {
          conversations.map((conversation) => (
            <span
              class:list={["conversation-number", `number-${conversation.id}`]}
              aria-hidden="true"
            >
              {conversation.number.replace(/^0/, "")}
            </span>
          ))
        }

        {
          ["workspace", "gateway", "opa", "broker", "upstream"].map((id) => {
            const item = node(id);
            return (
              <article
                class:list={[
                  "map-node",
                  `node-${id}`,
                  `kind-${item.kind}`,
                  ["workspace", "gateway"].includes(id) && "node-active",
                ]}
                data-node={id}
              >
                <span class="node-kind">
                  {id === "gateway"
                    ? ui.networkEnforcement
                    : id === "broker"
                      ? ui.secretBoundary
                      : id === "upstream"
                        ? ui.external
                        : id === "workspace"
                          ? ui.untrusted
                          : ui.control}
                </span>
                <h3>{item.label}</h3>
                <p>{item.detail}</p>
              </article>
            );
          })
        }
      </div>
    </div>

    <ol class="conversation-tabs" aria-label={ui.flowSteps}>
      {
        conversations.map((conversation) => (
          <li>
            <button
              type="button"
              data-conversation={conversation.id}
              aria-pressed={conversation.id === "proxy" ? "true" : "false"}
              disabled
            >
              <span>
                {conversation.number}
                {" · "}
                {conversation.optional ? `${ui.optional} · ` : ""}
                {conversation.label}
              </span>
              <strong>
                {conversation.from} → {conversation.to}
              </strong>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="conversation-details" aria-live="polite">
      {
        conversations.map((conversation) => (
          <section
            data-conversation-detail={conversation.id}
            hidden={conversation.id !== "proxy"}
          >
            <header>
              <span>
                {ui.step} {conversation.number}
              </span>
              <strong>{conversation.label}</strong>
            </header>
            <dl>
              <div>
                <>
                  <dt>{ui.sent}</dt>
                  <dd>{conversation.sent}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>{ui.notSent}</dt>
                  <dd>{conversation.withheld}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>{ui.result}</dt>
                  <dd>{conversation.result}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>{ui.failure}</dt>
                  <dd>{conversation.failure}</dd>
                </>
              </div>
            </dl>
          </section>
        ))
      }
    </div>

    <details class="map-transcript">
      <summary>{ui.transcript}</summary>
      <ol>
        {
          conversations.map((conversation) => (
            <li>
              <strong>
                {conversation.number} · {conversation.from} → {conversation.to}
              </strong>
              <p>{conversation.label}</p>
              <dl>
                <div>
                  <>
                    <dt>{ui.sent}</dt>
                    <dd>{conversation.sent}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{ui.notSent}</dt>
                    <dd>{conversation.withheld}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{ui.result}</dt>
                    <dd>{conversation.result}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{ui.failure}</dt>
                    <dd>{conversation.failure}</dd>
                  </>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
    </details>
  </figure>
</tobari-system-map>

<script>
  class TobariSystemMap extends HTMLElement {
    connectedCallback() {
      const figure = this.querySelector("figure");
      const buttons = this.querySelectorAll<HTMLButtonElement>(
        "[data-conversation]",
      );
      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener("click", () => {
          const id = button.dataset.conversation;
          if (!id || !figure) return;
          figure.dataset.activeConversation = id;
          buttons.forEach((candidate) =>
            candidate.setAttribute(
              "aria-pressed",
              String(candidate === button),
            ),
          );
          this.querySelectorAll<HTMLElement>(
            "[data-conversation-detail]",
          ).forEach((detail) => {
            detail.hidden = detail.dataset.conversationDetail !== id;
          });
          const active = conversationsForMap[id];
          this.querySelectorAll<HTMLElement>("[data-node]").forEach((item) =>
            item.classList.toggle(
              "node-active",
              Boolean(
                active &&
                [active.from, active.to].includes(item.dataset.node || ""),
              ),
            ),
          );
        });
      });
    }
  }

  const conversationsForMap: Record<string, { from: string; to: string }> = {
    proxy: { from: "workspace", to: "gateway" },
    policy: { from: "gateway", to: "opa" },
    decision: { from: "opa", to: "gateway" },
    credential: { from: "gateway", to: "broker" },
    egress: { from: "gateway", to: "upstream" },
  };

  if (!customElements.get("tobari-system-map"))
    customElements.define("tobari-system-map", TobariSystemMap);
</script>

<style>
  .system-map {
    display: block;
    margin-block: 2rem;
  }
  .system-map figure {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
  }
  .system-map figcaption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
    gap: 0 2rem;
    align-items: end;
    padding: 1.2rem 1.35rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  .system-map figcaption .eyebrow {
    grid-column: 1;
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .system-map figcaption h2,
  .system-map figcaption h3 {
    grid-column: 1;
    margin: 0.25rem 0 0;
  }
  .system-map figcaption p {
    grid-column: 2;
    grid-row: 1 / 3;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .map-scroll {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }
  .map-stage {
    position: relative;
    min-width: 45rem;
    height: 31.5rem;
    overflow: hidden;
    background-image:
      linear-gradient(var(--sl-color-gray-6) 1px, transparent 1px),
      linear-gradient(90deg, var(--sl-color-gray-6) 1px, transparent 1px);
    background-size: 2rem 2rem;
  }
  .cluster-boundary {
    position: absolute;
    inset: 1.6rem 35% 1.6rem;
    border: 1px dashed var(--tobari-diagnostic);
    background: color-mix(in srgb, var(--tobari-diagnostic) 5%, transparent);
  }
  .cluster-boundary span {
    position: absolute;
    inset: -0.7rem auto auto 1rem;
    padding-inline: 0.35rem;
    background: var(--sl-color-gray-7);
    color: var(--tobari-diagnostic);
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .network-label {
    position: absolute;
    z-index: 1;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .project-network {
    inset: auto auto 1rem 3%;
  }
  .egress-network {
    inset: auto 3% 1rem auto;
  }
  .map-stage svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .map-stage marker path {
    fill: context-stroke;
    stroke: context-stroke;
    stroke-width: 1.5;
  }
  .conversation-route {
    fill: none;
    stroke: var(--sl-color-gray-3);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .route-credential {
    stroke-dasharray: 7 6;
  }
  .direct-blocked {
    fill: none;
    stroke: var(--tobari-denied);
    stroke-width: 2.5;
    stroke-dasharray: 4 6;
    opacity: 0.8;
    vector-effect: non-scaling-stroke;
  }
  .direct-blocked-label {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 78%;
    transform: translateX(-50%);
    color: var(--tobari-denied);
    font-family: var(--sl-font-mono);
    font-size: 0.64rem;
    font-weight: 800;
  }
  [data-active-conversation="proxy"] .route-proxy,
  [data-active-conversation="policy"] .route-policy,
  [data-active-conversation="decision"] .route-decision,
  [data-active-conversation="credential"] .route-credential,
  [data-active-conversation="egress"] .route-egress {
    stroke: var(--tobari-control);
    stroke-width: 3.2;
  }
  .map-node {
    position: absolute;
    z-index: 2;
    width: 12.5rem;
    min-height: 7.5rem;
    margin: 0;
    padding: 0.9rem;
    transform: translate(-50%, -50%);
    border: 2px solid currentColor;
    background: var(--sl-color-bg);
    box-shadow: 0 0 0 0.3rem var(--sl-color-bg);
  }
  .node-workspace {
    left: 20%;
    top: 50%;
    color: var(--tobari-network);
    border-style: dashed;
  }
  .node-gateway {
    left: 50%;
    top: 50%;
    width: 13.75rem;
    min-height: 9rem;
    color: var(--tobari-control);
  }
  .node-opa {
    left: 50%;
    top: 20%;
    color: var(--tobari-trusted);
  }
  .node-broker {
    left: 50%;
    top: 80%;
    color: var(--tobari-secret);
    border-block-start-style: double;
    border-block-start-width: 4px;
  }
  .node-upstream {
    left: 80%;
    top: 50%;
    color: var(--tobari-network);
    border-style: dashed;
  }
  .map-node.node-active {
    outline: 3px solid currentColor;
    outline-offset: 4px;
  }
  .node-kind {
    display: inline-block;
    padding: 0.12rem 0.35rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .map-node h3 {
    margin: 0.55rem 0 0.25rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
  }
  .map-node p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.45;
  }
  .conversation-number {
    position: absolute;
    z-index: 3;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    transform: translate(-50%, -50%);
    border: 2px solid var(--tobari-control);
    border-radius: 50%;
    background: var(--sl-color-bg);
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 850;
  }
  .number-proxy {
    left: 35%;
    top: 50%;
  }
  .number-policy {
    left: 46.5%;
    top: 34.5%;
  }
  .number-decision {
    left: 53.5%;
    top: 34.5%;
  }
  .number-credential {
    left: 50%;
    top: 65.5%;
  }
  .number-egress {
    left: 65%;
    top: 50%;
  }
