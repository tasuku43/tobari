---
import { diagrams } from "../data/diagrams";
import { diagramsJa } from "../data/diagrams.ja";

interface Props {
  headingLevel?: 2 | 3;
  title?: string;
  description?: string;
  compact?: boolean;
  networkDetail?: boolean;
}

interface Conversation {
  id: "proxy" | "policy" | "decision" | "credential" | "egress";
  number: string;
  label: string;
  from: string;
  to: string;
  sent: string;
  withheld: string;
  result: string;
  failure: string;
  optional?: boolean;
}

interface Participant {
  id: "workspace" | "gateway" | "opa" | "broker" | "upstream";
  location: string;
  networks: string;
}

interface Message {
  id: string;
  number: string;
  phase: Conversation["id"];
  from: Participant["id"];
  to: Participant["id"];
  label: string;
  kind: "network" | "control" | "handle" | "allowed";
  optional?: boolean;
  response?: boolean;
}

const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const {
  headingLevel = 2,
  title = isJapanese
    ? "Workspace から接続先まで、一つのリクエストを追う"
    : "Follow one request from Workspace to its destination",
  description = isJapanese
    ? "列はコンポーネントが存在する場所、上から下は処理の時間です。横向きの矢印を番号順に追うと、どこで識別・判断・認証処理・外部接続が行われるかが分かります。"
    : "Columns show where each component exists; time moves from top to bottom. Follow the numbered messages to see where identity, policy, credentials, and the external connection are handled.",
  compact = false,
  networkDetail = false,
} = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const source = (isJapanese ? diagramsJa : diagrams)["minimal-system"];
const node = (id: string) => source.nodes.find((item) => item.id === id)!;

const participantsEn: Participant[] = [
  {
    id: "workspace",
    location: "Project runtime · untrusted",
    networks: "project network only",
  },
  {
    id: "gateway",
    location: "Shared cluster · host-managed",
    networks: "project + control + egress",
  },
  {
    id: "opa",
    location: "Shared cluster · host-managed",
    networks: "control only",
  },
  {
    id: "broker",
    location: "Shared cluster · host-managed",
    networks: "control + bounded egress",
  },
  {
    id: "upstream",
    location: "External service",
    networks: "reached only from Gateway",
  },
];
const participantsJa: Participant[] = [
  {
    id: "workspace",
    location: "プロジェクトの実行環境 · 信頼しない",
    networks: "プロジェクト専用ネットワークだけ",
  },
  {
    id: "gateway",
    location: "共有クラスター · ホストが管理",
    networks: "プロジェクト / 制御 / 外向き",
  },
  {
    id: "opa",
    location: "共有クラスター · ホストが管理",
    networks: "制御ネットワークだけ",
  },
  {
    id: "broker",
    location: "共有クラスター · ホストが管理",
    networks: "制御 + 限定された外向き通信",
  },
  {
    id: "upstream",
    location: "外部サービス",
    networks: "Gateway からだけ到達",
  },
];
const participants = isJapanese ? participantsJa : participantsEn;

const messagesEn: Message[] = [
  {
    id: "request",
    number: "01",
    phase: "proxy",
    from: "workspace",
    to: "gateway",
    label: "Guarded HTTP/HTTPS request",
    kind: "network",
  },
  {
    id: "principal",
    number: "02",
    phase: "proxy",
    from: "gateway",
    to: "gateway",
    label: "Derive principal from the Workspace source endpoint",
    kind: "control",
  },
  {
    id: "policy-input",
    number: "03",
    phase: "policy",
    from: "gateway",
    to: "opa",
    label: "Body-free, secret-free policy input",
    kind: "control",
  },
  {
    id: "policy-result",
    number: "04",
    phase: "decision",
    from: "opa",
    to: "gateway",
    label: "One allow or deny result",
    kind: "control",
    response: true,
  },
  {
    id: "credential-request",
    number: "05",
    phase: "credential",
    from: "gateway",
    to: "broker",
    label: "Credential operation, only when required and allowed",
    kind: "handle",
    optional: true,
  },
  {
    id: "credential-result",
    number: "06",
    phase: "credential",
    from: "broker",
    to: "gateway",
    label: "Resolve one same-revision static credential",
    kind: "handle",
    optional: true,
    response: true,
  },
  {
    id: "upstream-request",
    number: "07",
    phase: "egress",
    from: "gateway",
    to: "upstream",
    label: "Open a separate connection and forward",
    kind: "allowed",
  },
  {
    id: "upstream-response",
    number: "08",
    phase: "egress",
    from: "upstream",
    to: "gateway",
    label: "Destination response",
    kind: "network",
    response: true,
  },
  {
    id: "workspace-response",
    number: "09",
    phase: "egress",
    from: "gateway",
    to: "workspace",
    label: "Return the response to Workspace",
    kind: "network",
    response: true,
  },
];
const messagesJa: Message[] = [
  {
    id: "request",
    number: "01",
    phase: "proxy",
    from: "workspace",
    to: "gateway",
    label: "保護済みの HTTP/HTTPS リクエスト",
    kind: "network",
  },
  {
    id: "principal",
    number: "02",
    phase: "proxy",
    from: "gateway",
    to: "gateway",
    label: "Workspace の送信元エンドポイントから通信主体を確立",
    kind: "control",
  },
  {
    id: "policy-input",
    number: "03",
    phase: "policy",
    from: "gateway",
    to: "opa",
    label: "本文と秘密情報を除いた判断入力",
    kind: "control",
  },
  {
    id: "policy-result",
    number: "04",
    phase: "decision",
    from: "opa",
    to: "gateway",
    label: "許可または拒否の結果一つ",
    kind: "control",
    response: true,
  },
  {
    id: "credential-request",
    number: "05",
    phase: "credential",
    from: "gateway",
    to: "broker",
    label: "必要な場合だけ、許可後の認証処理",
    kind: "handle",
    optional: true,
  },
  {
    id: "credential-result",
    number: "06",
    phase: "credential",
    from: "broker",
    to: "gateway",
    label: "解決・更新・署名の結果",
    kind: "handle",
    optional: true,
    response: true,
  },
  {
    id: "upstream-request",
    number: "07",
    phase: "egress",
    from: "gateway",
    to: "upstream",
    label: "別の接続を開いて転送",
    kind: "allowed",
  },
  {
    id: "upstream-response",
    number: "08",
    phase: "egress",
    from: "upstream",
    to: "gateway",
    label: "外部サービスの応答",
    kind: "network",
    response: true,
  },
  {
    id: "workspace-response",
    number: "09",
    phase: "egress",
    from: "gateway",
    to: "workspace",
    label: "応答を Workspace へ返す",
    kind: "network",
    response: true,
  },
];
const messages = isJapanese ? messagesJa : messagesEn;

const conversationsEn: Conversation[] = [
  {
    id: "proxy",
    number: "01–02",
    label: "Receive and identify the request",
    from: "Workspace",
    to: "Gateway",
    sent: "HTTP method, URL, headers, and a streaming body",
    withheld: "Caller-supplied project identity is not trusted",
    result:
      "Gateway receives the request from the registered Workspace source endpoint and derives the principal from host-owned registration",
    failure: "Processing stops before policy or external work",
  },
  {
    id: "policy",
    number: "03",
    label: "Ask OPA",
    from: "Gateway",
    to: "OPA",
    sent: "Registry-derived principal and normalized HTTP decision dimensions",
    withheld: "Request body, broker handle, and credential values",
    result: "OPA receives one bounded decision input",
    failure: "Gateway does not connect to the destination",
  },
  {
    id: "decision",
    number: "04",
    label: "Enforce the decision",
    from: "OPA",
    to: "Gateway",
    sent: "One structured allow or deny result",
    withheld: "OPA does not open connections or handle credentials",
    result: "Gateway either returns a local denial or continues",
    failure: "Missing or malformed policy results fail closed",
  },
  {
    id: "credential",
    number: "05–06",
    label: "Use brokered credentials when required",
    from: "Gateway",
    to: "Auth Broker",
    sent: "A bound handle and the exact post-allow operation",
    withheld: "Workspace and OPA do not receive the brokered primary secret",
    result: "The declared static header replacement completes once",
    failure: "The request fails without switching credential modes",
    optional: true,
  },
  {
    id: "egress",
    number: "07–09",
    label: "Create the external connection and relay the response",
    from: "Gateway",
    to: "Destination",
    sent: "The authorized request over a separate Gateway-owned connection",
    withheld: "Policy internals, principal registry, and broker handle",
    result: "The response returns through Gateway to Workspace",
    failure: "A destination error does not change policy",
  },
];
const conversationsJa: Conversation[] = [
  {
    id: "proxy",
    number: "01–02",
    label: "リクエストを受け取り、通信主体を確立する",
    from: "Workspace",
    to: "Gateway",
    sent: "HTTP メソッド、URL、ヘッダー、ストリーミングされる本文",
    withheld: "呼び出し元が申告したプロジェクト識別情報は信頼しない",
    result:
      "Gateway がプロジェクト側のインターフェースで受け取り、ホスト管理の登録情報から通信主体を確立する",
    failure: "ポリシー判断や外部接続より前に停止する",
  },
  {
    id: "policy",
    number: "03",
    label: "OPA に判断を求める",
    from: "Gateway",
    to: "OPA",
    sent: "登録情報から導出した通信主体と、正規化した HTTP 通信の情報",
    withheld: "リクエスト本文、ブローカーのハンドル、認証情報の値",
    result: "OPA が上限を定めた判断入力を一つ受け取る",
    failure: "Gateway は接続先へ接続しない",
  },
  {
    id: "decision",
    number: "04",
    label: "判断を通信経路へ反映する",
    from: "OPA",
    to: "Gateway",
    sent: "構造化された許可または拒否の結果一つ",
    withheld: "OPA は外部接続を作らず、認証情報も扱わない",
    result: "Gateway がローカルで拒否を返すか、次の処理へ進む",
    failure: "判断を取得できない、または応答が不正な場合は拒否する",
  },
  {
    id: "credential",
    number: "05–06",
    label: "必要な場合だけ、ブローカー管理の認証情報を使う",
    from: "Gateway",
    to: "Auth Broker",
    sent: "プロジェクトに結び付いたハンドルと、許可後の完全一致する操作",
    withheld: "Workspace と OPA へ、ブローカー管理の秘密情報を送らない",
    result: "宣言済みの静的ヘッダー置換を一度だけ完了する",
    failure: "別の認証方式へ切り替えずに失敗する",
    optional: true,
  },
  {
    id: "egress",
    number: "07–09",
    label: "外部接続を作り、応答を中継する",
    from: "Gateway",
    to: "接続先",
    sent: "Gateway が所有する別接続で、許可済みリクエストを送る",
    withheld: "ポリシーの内部情報、プリンシパル登録情報、ブローカーのハンドル",
    result: "応答が Gateway を通って Workspace へ戻る",
    failure: "接続先のエラーはポリシーを変更しない",
  },
];
const conversations = isJapanese ? conversationsJa : conversationsEn;

const laneX: Record<Participant["id"], number> = {
  workspace: 120,
  gateway: 390,
  opa: 630,
  broker: 870,
  upstream: 1110,
};
const messageY = [275, 360, 445, 530, 625, 700, 795, 870, 945];
const messageGeometry = messages.map((message, index) => {
  const fromX = laneX[message.from];
  const toX = laneX[message.to];
  const y = messageY[index];
  if (message.from === message.to) {
    return {
      ...message,
      y,
      path: `M ${fromX} ${y} C ${fromX + 105} ${y}, ${fromX + 105} ${y + 58}, ${fromX} ${y + 58}`,
      labelX: fromX + 112,
      labelY: y + 28,
      self: true,
    };
  }
  return {
    ...message,
    y,
    path: `M ${fromX} ${y} L ${toX} ${y}`,
    labelX: (fromX + toX) / 2,
    labelY: y,
    self: false,
  };
});

const ui = isJapanese
  ? {
      eyebrow: "通信フロー",
      scrollableMap: "横方向にスクロールできるシーケンス図",
      mapDescription:
        "左から Workspace、Gateway、OPA、Auth Broker、外部の接続先が並び、時間は上から下へ進みます。番号付きの矢印が一つのリクエストの処理順序を示します。",
      zoneWorkspace: "プロジェクトの実行環境",
      zoneCluster: "Tobari 共有クラスター · ホスト管理",
      zoneExternal: "外部",
      place: "存在場所",
      network: "接続範囲",
      legendLocation: "背景 = 存在場所",
      legendLane: "縦線 = コンポーネント",
      legendMessage: "番号付き矢印 = 処理とデータの移動",
      legendStop: "赤い停止線 = 経路を作らない",
      flowSteps: "処理を段階ごとに確認する",
      step: "段階",
      optional: "条件付き",
      sent: "送る情報",
      notSent: "送らない情報",
      result: "結果",
      failure: "失敗時",
      transcript: "通信フローを文章で読む",
      directBlocked: "Workspace から接続先への直接経路はない",
      deniedBranch:
        "拒否: Gateway がローカルで応答し、接続先への接続を作らない",
    }
  : {
      eyebrow: "Request flow",
      scrollableMap: "Horizontally scrollable sequence diagram",
      mapDescription:
        "Workspace, Gateway, OPA, Auth Broker, and the external destination are arranged from left to right; time moves downward. Numbered messages show one request in processing order.",
      zoneWorkspace: "Project runtime",
      zoneCluster: "Tobari shared cluster · host-managed",
      zoneExternal: "External",
      place: "Location",
      network: "Network reach",
      legendLocation: "Background = location",
      legendLane: "Lifeline = component",
      legendMessage: "Numbered arrow = processing and data movement",
      legendStop: "Red stop = no route is created",
      flowSteps: "Inspect each phase",
      step: "Phase",
      optional: "Conditional",
      sent: "Sent",
      notSent: "Not sent",
      result: "Result",
      failure: "Failure",
      transcript: "Read the request flow as text",
      directBlocked: "Workspace has no direct route to the destination",
      deniedBranch:
        "Deny: Gateway responds locally and creates no destination connection",
    };
---

<tobari-system-map
  class:list={["system-map", { compact, "network-detail": networkDetail }]}
>
  <figure data-active-conversation="proxy">
    <figcaption>
      <span class="eyebrow">{ui.eyebrow}</span>
      <Heading>{title}</Heading>
      <p>{description}</p>
    </figcaption>

    <div
      class="map-legend"
      aria-label={isJapanese ? "図の読み方" : "Diagram key"}
    >
      <span>{ui.legendLocation}</span>
      <span>{ui.legendLane}</span>
      <span>{ui.legendMessage}</span>
      <span class="legend-stop">{ui.legendStop}</span>
    </div>

    <div
      class="map-scroll"
      tabindex="0"
      role="region"
      aria-label={ui.scrollableMap}
    >
      <div class="map-stage" role="img" aria-label={ui.mapDescription}>
        <div class="map-zone zone-workspace" aria-hidden="true">
          <span>{ui.zoneWorkspace}</span>
        </div>
        <div class="map-zone zone-cluster" aria-hidden="true">
          <span>{ui.zoneCluster}</span>
        </div>
        <div class="map-zone zone-external" aria-hidden="true">
          <span>{ui.zoneExternal}</span>
        </div>

        {
          participants.map((participant) => {
            const item = node(participant.id);
            return (
              <>
                <article
                  class:list={[
                    "map-node",
                    `node-${participant.id}`,
                    `kind-${item.kind}`,
                    ["workspace", "gateway"].includes(participant.id) &&
                      "node-active",
                  ]}
                  data-node={participant.id}
                  style={`--lane-x:${(laneX[participant.id] / 1230) * 100}%`}
                >
                  <span class="node-location">
                    {ui.place} · {participant.location}
                  </span>
                  <h3>{item.label}</h3>
                  <p>{item.detail}</p>
                  <span class="node-network">
                    {ui.network} · {participant.networks}
                  </span>
                </article>
                <span
                  class={`lifeline lifeline-${participant.id}`}
                  style={`--lane-x:${(laneX[participant.id] / 1230) * 100}%`}
                  aria-hidden="true"
                />
              </>
            );
          })
        }

        <svg viewBox="0 0 1230 1070" aria-hidden="true">
          <defs>
            <marker
              id="system-map-arrow"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto-start-reverse"
            >
              <path d="M 0 0 L 10 5 L 0 10 z"></path>
            </marker>
            <marker
              id="system-map-stop"
              viewBox="0 0 12 12"
              refX="8"
              refY="6"
              markerWidth="8"
              markerHeight="8"
              orient="auto"
            >
              <path d="M 3 1 L 3 11 M 7 1 L 7 11"></path>
            </marker>
          </defs>

          {
            messageGeometry.map((message) => (
              <path
                class:list={[
                  "message-route",
                  `message-${message.id}`,
                  `phase-${message.phase}`,
                  `kind-${message.kind}`,
                  message.optional && "is-optional",
                  message.response && "is-response",
                ]}
                data-message-route={message.id}
                d={message.path}
                marker-end="url(#system-map-arrow)"
              />
            ))
          }

          <path
            class="denied-branch"
            d="M 390 575 L 120 575"
            marker-end="url(#system-map-arrow)"></path>
          <path
            class="direct-blocked"
            d="M 120 1020 L 1110 1020"
            marker-end="url(#system-map-stop)"></path>
        </svg>

        {
          messageGeometry.map((message) => (
            <span
              class:list={[
                "message-label",
                `message-label-${message.id}`,
                `phase-${message.phase}`,
                `kind-${message.kind}`,
                message.optional && "is-optional",
              ]}
              data-message-label={message.id}
              style={`--message-x:${(message.labelX / 1230) * 100}%;--message-y:${(message.labelY / 1070) * 100}%`}
              aria-hidden="true"
            >
              <strong>{message.number}</strong>
              <span>{message.label}</span>
            </span>
          ))
        }

        <span class="denied-label" aria-hidden="true">{ui.deniedBranch}</span>
        <span class="direct-blocked-label" aria-hidden="true">
          × {ui.directBlocked}
        </span>
      </div>
    </div>

    <ol class="conversation-tabs" aria-label={ui.flowSteps}>
      {
        conversations.map((conversation) => (
          <li>
            <button
              type="button"
              data-conversation={conversation.id}
              aria-pressed={conversation.id === "proxy" ? "true" : "false"}
              disabled
            >
              <span>
                {conversation.number}
                {" · "}
                {conversation.optional ? `${ui.optional} · ` : ""}
                {conversation.label}
              </span>
              <strong>
                {conversation.from} → {conversation.to}
              </strong>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="conversation-details" aria-live="polite">
      {
        conversations.map((conversation) => (
          <section
            data-conversation-detail={conversation.id}
            hidden={conversation.id !== "proxy"}
          >
            <header>
              <span>
                {ui.step} {conversation.number}
              </span>
              <strong>{conversation.label}</strong>
            </header>
            <dl>
              <div>
                <dt>{ui.sent}</dt>
                <dd>{conversation.sent}</dd>
              </div>
              <div>
                <dt>{ui.notSent}</dt>
                <dd>{conversation.withheld}</dd>
              </div>
              <div>
                <dt>{ui.result}</dt>
                <dd>{conversation.result}</dd>
              </div>
              <div>
                <dt>{ui.failure}</dt>
                <dd>{conversation.failure}</dd>
              </div>
            </dl>
          </section>
        ))
      }
    </div>

    <details class="map-transcript">
      <summary>{ui.transcript}</summary>
      <ol>
        {
          messages.map((message) => (
            <li>
              <strong>
                {message.number} · {node(message.from).label}
                <span aria-hidden="true"> → </span>
                {node(message.to).label}
              </strong>
              <p>{message.label}</p>
            </li>
          ))
        }
      </ol>
      <p class="transcript-denied">{ui.deniedBranch}</p>
      <p class="transcript-blocked">{ui.directBlocked}</p>
    </details>
  </figure>
</tobari-system-map>

<script>
  class TobariSystemMap extends HTMLElement {
    connectedCallback() {
      const figure = this.querySelector("figure");
      const buttons = this.querySelectorAll<HTMLButtonElement>(
        "[data-conversation]",
      );
      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener("click", () => {
          const id = button.dataset.conversation;
          if (!id || !figure) return;
          figure.dataset.activeConversation = id;
          buttons.forEach((candidate) =>
            candidate.setAttribute(
              "aria-pressed",
              String(candidate === button),
            ),
          );
          this.querySelectorAll<HTMLElement>(
            "[data-conversation-detail]",
          ).forEach((detail) => {
            detail.hidden = detail.dataset.conversationDetail !== id;
          });
          const active = conversationsForMap[id];
          this.querySelectorAll<HTMLElement>("[data-node]").forEach((item) =>
            item.classList.toggle(
              "node-active",
              Boolean(
                active &&
                [active.from, active.to].includes(item.dataset.node || ""),
              ),
            ),
          );
        });
      });
    }
