---
import config from "virtual:starlight/user-config";
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import {
  navigationLabel,
  navigationPath,
  primarySections,
} from "../navigation.mjs";
import LearningProgress from "./LearningProgress.astro";
import ThemeSelect from "./ThemeSelect.astro";

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
const locale = Astro.locals.starlightRoute.locale === "ja" ? "ja" : "en";
const labels =
  locale === "ja"
    ? {
        primary: "主要ナビゲーション",
        primaryMenu: "主要ナビゲーションメニュー",
        menu: "メニュー",
      }
    : {
        primary: "Primary",
        primaryMenu: "Primary navigation menu",
        menu: "Menu",
      };
const withBase = (href: string) =>
  `${import.meta.env.BASE_URL}${href.replace(/^\//, "")}`;
const hrefFor = (href: string) => withBase(navigationPath(href, locale));
---

<div class="tobari-header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
    <LearningProgress variant="badge" />
  </div>
  <nav aria-label={labels.primary} class="primary-nav print:hidden">
    {
      primarySections.map((section) => (
        <a href={hrefFor(section.link)}>{navigationLabel(section, locale)}</a>
      ))
    }
  </nav>
  <div class="search sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="right-group sl-hidden md:sl-flex print:hidden">
    <div class="social-icons sl-flex"><SocialIcons /></div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
  <details class="mobile-primary print:hidden">
    <summary>
      <span class="menu-word">{labels.menu}</span>
      <span aria-hidden="true" class="menu-mark menu-open">☰</span>
      <span aria-hidden="true" class="menu-mark menu-close">×</span>
    </summary>
    <div class="mobile-primary-panel">
      <nav aria-label={labels.primaryMenu}>
        {
          primarySections.map((section) => (
            <a href={hrefFor(section.link)}>
              {navigationLabel(section, locale)}
            </a>
          ))
        }
      </nav>
      <div class="mobile-primary-meta">
        <ThemeSelect />
        <LanguageSelect />
        <a href="https://github.com/tasuku43/tobari">GitHub</a>
      </div>
    </div>
  </details>
</div>

<style>
  @layer starlight.core {
    .tobari-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: "title search menu";
      align-items: center;
      gap: 0.5rem 1rem;
      height: 100%;
    }
    .title-wrapper {
      grid-area: title;
      min-width: 0;
      align-items: center;
      gap: 0.75rem;
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
    }
    .primary-nav {
      display: none;
      grid-area: nav;
      gap: 1.1rem;
      align-items: center;
      font-size: var(--sl-text-sm);
      white-space: nowrap;
    }
    .primary-nav a {
      color: var(--sl-color-gray-2);
      text-decoration: none;
      text-underline-offset: 0.3em;
    }
    .primary-nav a:hover,
    .primary-nav a:focus-visible {
      color: var(--sl-color-white);
      text-decoration: underline;
    }
    .search {
      grid-area: search;
      justify-content: center;
      min-width: 0;
    }
    .right-group {
      grid-area: right;
      gap: 1rem;
      align-items: center;
    }
    .social-icons {
      gap: 1rem;
      align-items: center;
    }
    .social-icons::after {
      content: "";
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }
    .mobile-primary {
      grid-area: menu;
      margin: 0;
    }
    .mobile-primary summary {
      display: flex;
      min-width: 2.75rem;
      min-height: 2.75rem;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--sl-color-gray-4);
      cursor: pointer;
      list-style: none;
    }
    .mobile-primary summary::-webkit-details-marker {
      display: none;
    }
    .menu-word {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .menu-mark {
      font-size: 1.15rem;
      line-height: 1;
    }
    .menu-close,
    .mobile-primary[open] .menu-open {
      display: none;
    }
    .mobile-primary[open] .menu-close {
      display: inline;
    }
    .mobile-primary-panel {
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset: var(--sl-nav-height) 0 auto;
      padding: 1rem var(--sl-nav-pad-x) 1.25rem;
      border-block-end: 1px solid var(--sl-color-gray-5);
      background: var(--sl-color-bg-nav);
      box-shadow: var(--sl-shadow-md);
    }
    .mobile-primary-panel nav {
      display: grid;
    }
    .mobile-primary-panel nav a {
      padding: 0.85rem 0;
      border-block-end: 1px solid var(--sl-color-gray-5);
      color: var(--sl-color-white);
      font-weight: 700;
      text-decoration: none;
    }
    .mobile-primary-meta {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 1rem;
      padding-top: 1rem;
    }
    .mobile-primary-meta > :last-child {
      margin-inline-start: auto;
    }
    :global(:root[data-has-sidebar]) .mobile-primary {
      display: none;
    }
    @media (min-width: 50rem) {
      .tobari-header {
        grid-template-columns: auto minmax(18rem, 1fr) auto;
        grid-template-areas: "title search menu";
      }
    }
    @media (min-width: 72rem) {
      .tobari-header {
        grid-template-columns: auto auto minmax(15rem, 1fr) auto;
        grid-template-areas: "title nav search right";
      }
      .primary-nav {
        display: flex;
      }
      .mobile-primary {
        display: none;
      }
    }
  }
</style>
