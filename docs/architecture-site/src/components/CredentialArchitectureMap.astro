---
import {
  credentialNodes,
  credentialRoutes,
  credentialScenarios,
  textFor,
  type SiteLocale,
} from "../data/credentialArchitecture";

interface Props {
  headingLevel?: 2 | 3;
  title?: string;
  initial?: string;
}

const isJapanese = /(?:^|\/)ja(?:\/|$)/.test(Astro.url.pathname);
const locale: SiteLocale = isJapanese ? "ja" : "en";
const {
  headingLevel = 2,
  title = isJapanese
    ? "認証情報を使う処理の順序"
    : "Follow the credential-processing path",
  initial = "static",
} = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const initialScenario =
  credentialScenarios.find((scenario) => scenario.id === initial) ??
  credentialScenarios[0];
const nodeById = Object.fromEntries(
  credentialNodes.map((node) => [node.id, node]),
);
const routeById = Object.fromEntries(
  credentialRoutes.map((route) => [route.id, route]),
);
const locationIdByNode: Record<
  string,
  "host" | "workspace" | "cluster" | "external"
> = {
  "host-cli": "host",
  companion: "host",
  workspace: "workspace",
  opa: "cluster",
  gateway: "cluster",
  broker: "cluster",
  vault: "cluster",
  "provider-login": "external",
  upstream: "external",
  "datadog-token": "external",
  "openai-token": "external",
};
const ui = isJapanese
  ? {
      eyebrow: "認証情報フロー",
      intro:
        "方式を選ぶと、Workspace または信頼するホストから始まる処理を、実際に通る順番で示します。各段階には、処理するコンポーネント、その場所、次へ渡す情報を表示します。自動再生はありません。",
      routes: "確認する方式",
      routeOrder: "処理の順序",
      sent: "送る情報",
      withheld: "送らない情報",
      result: "成功時",
      failure: "失敗時",
      transcript: "全方式を文章で読む",
      locations: {
        host: "信頼するホスト",
        workspace: "Workspace",
        cluster: "ホスト管理クラスター",
        external: "外部サービス",
      },
      direction: "次の処理",
    }
  : {
      eyebrow: "Credential flow",
      intro:
        "Choose a plan to follow the actual processing order from the Workspace or trusted host. Every step names the component, where it runs, and the information passed to the next component. Nothing plays automatically.",
      routes: "Flow to inspect",
      routeOrder: "Processing order",
      sent: "Information sent",
      withheld: "Information not sent",
      result: "On success",
      failure: "On failure",
      transcript: "Read every flow as text",
      locations: {
        host: "Trusted host",
        workspace: "Workspace",
        cluster: "Host-managed cluster",
        external: "External service",
      },
      direction: "Next operation",
    };
const localizedScenarios = credentialScenarios.map((scenario) => ({
  id: scenario.id,
  routes: scenario.routes,
  summary: textFor(scenario.summary, locale),
  sent: textFor(scenario.sent, locale),
  withheld: textFor(scenario.withheld, locale),
  result: textFor(scenario.result, locale),
  failure: textFor(scenario.failure, locale),
}));
const localizedNodes = Object.fromEntries(
  credentialNodes.map((node) => [
    node.id,
    {
      label: textFor(node.label, locale),
      role: textFor(node.role, locale),
      detail: textFor(node.detail, locale),
      kind: node.kind,
      location: ui.locations[locationIdByNode[node.id] ?? "cluster"],
    },
  ]),
);
const localizedRoutes = Object.fromEntries(
  credentialRoutes.map((route) => [
    route.id,
    {
      id: route.id,
      from: route.from,
      to: route.to,
      label: textFor(route.label, locale),
      kind: route.kind,
    },
  ]),
);
---

<tobari-credential-map
  data-scenarios={JSON.stringify(localizedScenarios)}
  data-nodes={JSON.stringify(localizedNodes)}
  data-routes={JSON.stringify(localizedRoutes)}
  data-initial={initialScenario.id}
  data-direction-label={ui.direction}
>
  <figure class="credential-architecture">
    <figcaption>
      <span class="eyebrow">{ui.eyebrow}</span>
      <Heading>{title}</Heading>
      <p>{ui.intro}</p>
    </figcaption>

    <div class="credential-scenario-tabs" role="group" aria-label={ui.routes}>
      {
        credentialScenarios.map((scenario) => (
          <button
            type="button"
            data-scenario={scenario.id}
            aria-pressed={scenario.id === initialScenario.id ? "true" : "false"}
            disabled
          >
            {textFor(scenario.label, locale)}
          </button>
        ))
      }
    </div>

    <section class="credential-flow" aria-label={ui.routeOrder}>
      <h3>{ui.routeOrder}</h3>
      <ol data-field="route-order">
        {
          initialScenario.routes.map((routeId, index) => {
            const route = routeById[routeId];
            const from = nodeById[route.from];
            const to = nodeById[route.to];
            return (
              <li class:list={["credential-flow-step", `route-${route.kind}`]}>
                <article
                  class:list={["flow-actor", `kind-${from.kind}`]}
                  data-node={from.id}
                >
                  <span class="actor-location">
                    {ui.locations[locationIdByNode[from.id] ?? "cluster"]}
                  </span>
                  <strong>{textFor(from.label, locale)}</strong>
                  <small>{textFor(from.role, locale)}</small>
                </article>
                <div class="flow-transfer" aria-label={ui.direction}>
                  <span class="flow-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="flow-arrow" aria-hidden="true">
                    →
                  </span>
                  <p>{textFor(route.label, locale)}</p>
                </div>
                <article
                  class:list={["flow-actor", `kind-${to.kind}`]}
                  data-node={to.id}
                >
                  <span class="actor-location">
                    {ui.locations[locationIdByNode[to.id] ?? "cluster"]}
                  </span>
                  <strong>{textFor(to.label, locale)}</strong>
                  <small>{textFor(to.role, locale)}</small>
                </article>
              </li>
            );
          })
        }
      </ol>
    </section>

    <section
      class="credential-scenario-detail"
      aria-live="polite"
      aria-atomic="true"
    >
      <p data-field="summary">{textFor(initialScenario.summary, locale)}</p>
      <dl>
        <div>
          <dt>{ui.sent}</dt>
          <dd data-field="sent">{textFor(initialScenario.sent, locale)}</dd>
        </div>
        <div>
          <dt>{ui.withheld}</dt>
          <dd data-field="withheld">
            {textFor(initialScenario.withheld, locale)}
          </dd>
        </div>
        <div>
          <dt>{ui.result}</dt>
          <dd data-field="result">{textFor(initialScenario.result, locale)}</dd>
        </div>
        <div>
          <dt>{ui.failure}</dt>
          <dd data-field="failure">
            {textFor(initialScenario.failure, locale)}
          </dd>
        </div>
      </dl>
    </section>

    <details class="credential-map-transcript" open>
      <summary>{ui.transcript}</summary>
      <ol>
        {
          credentialScenarios.map((scenario) => (
            <li>
              <h3>{textFor(scenario.label, locale)}</h3>
              <p>{textFor(scenario.summary, locale)}</p>
              <ol class="transcript-routes">
                {scenario.routes.map((routeId, index) => {
                  const route = routeById[routeId];
                  return (
                    <li>
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      <strong>
                        {textFor(nodeById[route.from].label, locale)}
                      </strong>
                      {" → "}
                      <strong>
                        {textFor(nodeById[route.to].label, locale)}
                      </strong>
                      {": "}
                      {textFor(route.label, locale)}
                    </li>
                  );
                })}
              </ol>
              <dl>
                <div>
                  <dt>{ui.sent}</dt>
                  <dd>{textFor(scenario.sent, locale)}</dd>
                </div>
                <div>
                  <dt>{ui.withheld}</dt>
                  <dd>{textFor(scenario.withheld, locale)}</dd>
                </div>
                <div>
                  <dt>{ui.result}</dt>
                  <dd>{textFor(scenario.result, locale)}</dd>
                </div>
                <div>
                  <dt>{ui.failure}</dt>
                  <dd>{textFor(scenario.failure, locale)}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
    </details>
  </figure>
</tobari-credential-map>

<script>
  interface ScenarioView {
    id: string;
    routes: string[];
    summary: string;
    sent: string;
    withheld: string;
    result: string;
    failure: string;
  }

  interface NodeView {
    label: string;
    role: string;
    detail: string;
    kind: string;
    location: string;
  }

  interface RouteView {
    id: string;
    from: string;
    to: string;
    label: string;
    kind: string;
  }

  class TobariCredentialMap extends HTMLElement {
    scenarios: ScenarioView[] = [];
    nodes: Record<string, NodeView> = {};
    routes: Record<string, RouteView> = {};

    connectedCallback() {
      this.querySelector<HTMLDetailsElement>(
        ".credential-map-transcript",
      )?.removeAttribute("open");
      try {
        this.scenarios = JSON.parse(this.dataset.scenarios || "[]");
        this.nodes = JSON.parse(this.dataset.nodes || "{}");
        this.routes = JSON.parse(this.dataset.routes || "{}");
      } catch {
        return;
      }
      const buttons =
        this.querySelectorAll<HTMLButtonElement>("[data-scenario]");
      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener("click", () => {
          const scenario = this.scenarios.find(
            ({ id }) => id === button.dataset.scenario,
          );
          if (!scenario) return;
          buttons.forEach((candidate) =>
            candidate.setAttribute(
              "aria-pressed",
              String(candidate === button),
            ),
          );
          this.render(scenario);
        });
      });
    }

    actor(nodeId: string) {
      const node = this.nodes[nodeId];
      const actor = document.createElement("article");
      actor.className = `flow-actor kind-${node.kind}`;
      actor.dataset.node = nodeId;
      const location = document.createElement("span");
      location.className = "actor-location";
      location.textContent = node.location;
      const label = document.createElement("strong");
      label.textContent = node.label;
      const role = document.createElement("small");
      role.textContent = node.role;
      actor.append(location, label, role);
      return actor;
    }

    render(scenario: ScenarioView) {
      const list = this.querySelector<HTMLOListElement>(
        '[data-field="route-order"]',
      );
      if (!list) return;
      list.replaceChildren();
      scenario.routes.forEach((routeId, index) => {
        const route = this.routes[routeId];
        if (!route) return;
        const item = document.createElement("li");
        item.className = `credential-flow-step route-${route.kind}`;
        const transfer = document.createElement("div");
        transfer.className = "flow-transfer";
        transfer.setAttribute(
          "aria-label",
          this.dataset.directionLabel || "Next operation",
        );
        const number = document.createElement("span");
        number.className = "flow-number";
        number.textContent = String(index + 1).padStart(2, "0");
        const arrow = document.createElement("span");
        arrow.className = "flow-arrow";
        arrow.setAttribute("aria-hidden", "true");
        arrow.textContent = "→";
        const label = document.createElement("p");
        label.textContent = route.label;
        transfer.append(number, arrow, label);
        item.append(this.actor(route.from), transfer, this.actor(route.to));
        list.append(item);
      });
      for (const field of [
        "summary",
        "sent",
        "withheld",
        "result",
        "failure",
      ] as const) {
        const target = this.querySelector(`[data-field="${field}"]`);
        if (target) target.textContent = scenario[field];
      }
    }
  }

  if (!customElements.get("tobari-credential-map"))
    customElements.define("tobari-credential-map", TobariCredentialMap);
</script>

<style>
  tobari-credential-map {
    display: block;
    margin-block: 2rem;
    scroll-margin-block-start: 5rem;
  }
  .credential-architecture {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
  }
  figcaption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
    gap: 0 2rem;
    align-items: end;
    padding: 1.2rem 1.35rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  figcaption .eyebrow {
    grid-column: 1;
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  figcaption :is(h2, h3) {
    grid-column: 1;
    margin: 0.25rem 0 0;
  }
  figcaption p {
    grid-column: 2;
    grid-row: 1 / 3;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .credential-scenario-tabs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  .credential-scenario-tabs button {
    min-width: 0;
    padding: 0.75rem 0.65rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-weight: 700;
  }
  .credential-scenario-tabs button + button {
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }
  .credential-scenario-tabs button[aria-pressed="true"] {
    background: color-mix(in srgb, var(--tobari-control) 10%, transparent);
    box-shadow: inset 0 -0.22rem var(--tobari-control);
    color: var(--sl-color-white);
  }
  .credential-scenario-tabs button:focus-visible {
    outline: 3px solid var(--sl-color-accent-high);
    outline-offset: -3px;
  }
  .credential-flow {
    padding: 1.1rem 1.2rem 1.3rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
    background-image:
      linear-gradient(var(--sl-color-gray-6) 1px, transparent 1px),
      linear-gradient(90deg, var(--sl-color-gray-6) 1px, transparent 1px);
    background-size: 2rem 2rem;
  }
  .credential-flow > h3 {
    margin: 0 0 0.8rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .credential-flow ol {
    display: grid;
    gap: 0.72rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .credential-flow-step {
    display: grid;
    grid-template-columns: minmax(9.5rem, 0.9fr) minmax(9rem, 0.7fr) minmax(
        9.5rem,
        0.9fr
      );
    gap: 0.75rem;
    align-items: stretch;
  }
  .flow-actor {
    display: grid;
    min-width: 0;
    padding: 0.75rem 0.85rem;
    align-content: center;
    border: 1px solid currentColor;
    background: var(--sl-color-bg);
    box-shadow: 0 0.35rem 0.9rem rgb(0 0 0 / 8%);
  }
  .flow-actor .actor-location {
    color: currentColor;
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .flow-actor strong {
    margin-top: 0.25rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .flow-actor small {
    margin-top: 0.15rem;
    color: var(--sl-color-gray-2);
    line-height: 1.35;
  }
  .flow-transfer {
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr);
    grid-template-rows: auto auto;
    gap: 0.15rem 0.45rem;
    min-width: 0;
    padding: 0.6rem 0.25rem;
    align-content: center;
    color: var(--tobari-control);
    text-align: center;
  }
  .flow-number {
    display: grid;
    grid-row: 1 / 3;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    align-self: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--sl-color-bg);
    font-family: var(--sl-font-mono);
    font-size: 0.67rem;
    font-weight: 850;
  }
  .flow-arrow {
    position: relative;
    overflow: hidden;
    color: currentColor;
    font-size: 1.45rem;
    line-height: 1;
  }
  .flow-arrow::before {
    position: absolute;
    top: 50%;
    right: 1.05rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
  }
  .flow-transfer p {
    grid-column: 2;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.7rem;
    line-height: 1.35;
  }
  .route-control .flow-transfer,
  .route-metadata .flow-transfer {
    color: var(--tobari-control);
  }
  .route-handle .flow-transfer {
    color: var(--tobari-handle);
  }
  .route-secret .flow-transfer {
    color: var(--tobari-secret);
  }
  .route-network .flow-transfer {
    color: var(--tobari-network);
  }
  .kind-trusted {
    color: var(--tobari-trusted);
  }
  .kind-untrusted {
    color: var(--tobari-untrusted);
    border-style: dashed;
  }
  .kind-control {
    color: var(--tobari-control);
  }
  .kind-secret {
    color: var(--tobari-secret);
    border-block-start-style: double;
    border-block-start-width: 4px;
  }
  .kind-external {
    color: var(--tobari-network);
    border-style: dashed;
  }
  .credential-scenario-detail {
    padding: 1.15rem 1.3rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  .credential-scenario-detail > p {
    margin: 0 0 1rem;
    font-weight: 700;
  }
  .credential-scenario-detail dl,
  .credential-map-transcript dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
  }
  .credential-scenario-detail dl div,
  .credential-map-transcript dl div {
    min-width: 0;
    padding: 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
  }
  .credential-scenario-detail dt,
  .credential-map-transcript dt {
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
  }
  .credential-scenario-detail dd,
  .credential-map-transcript dd {
    margin: 0.35rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .credential-map-transcript {
    margin: 0;
    border: 0;
  }
  .credential-map-transcript > summary {
    padding: 0.9rem 1.2rem;
    cursor: pointer;
    font-weight: 750;
  }
  .credential-map-transcript > ol {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0 1.2rem 1.2rem 2.5rem;
  }
  .credential-map-transcript h3,
  .credential-map-transcript p {
    margin-block: 0;
  }
  .credential-map-transcript p {
    margin-top: 0.35rem;
  }
  .transcript-routes {
    display: grid;
    gap: 0.25rem;
    margin: 0.75rem 0;
    padding: 0;
    list-style: none;
  }
  .transcript-routes li > span {
    display: inline-block;
    min-width: 2.3rem;
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
  }
  @media (max-width: 48rem) {
    figcaption {
      grid-template-columns: 1fr;
    }
    figcaption p {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0.65rem;
    }
    .credential-flow-step {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }
    .flow-transfer {
      grid-template-columns: auto minmax(0, 1fr);
      min-height: 4rem;
      padding: 0.25rem 0.75rem;
      text-align: start;
    }
    .flow-arrow {
      transform: rotate(90deg);
      transform-origin: center;
    }
  }
  @media (max-width: 38rem) {
    .credential-scenario-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .credential-scenario-tabs button:nth-child(3) {
      border-block-start: 1px solid var(--sl-color-gray-5);
      border-inline-start: 0;
    }
    .credential-scenario-tabs button:nth-child(4) {
      border-block-start: 1px solid var(--sl-color-gray-5);
    }
    .credential-scenario-detail dl,
    .credential-map-transcript dl {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      scroll-behavior: auto !important;
    }
  }
  @media print {
    .credential-scenario-tabs {
      display: none;
    }
    .credential-map-transcript {
      display: block;
    }
    .credential-map-transcript > summary {
      display: none;
    }
  }
</style>
