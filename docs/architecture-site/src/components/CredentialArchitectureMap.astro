---
import {
  credentialNodes,
  credentialRoutes,
  credentialScenarios,
  textFor,
  type SiteLocale,
} from "../data/credentialArchitecture";

interface Props {
  headingLevel?: 2 | 3;
  title?: string;
  initial?: string;
}

const isJapanese = /(?:^|\/)ja(?:\/|$)/.test(Astro.url.pathname);
const locale: SiteLocale = isJapanese ? "ja" : "en";
const {
  headingLevel = 2,
  title = isJapanese
    ? "認証情報が動く範囲を固定配置で見る"
    : "See the credential boundary as one fixed map",
  initial = "static",
} = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const initialScenario =
  credentialScenarios.find((scenario) => scenario.id === initial) ??
  credentialScenarios[0];
const localizedScenarios = credentialScenarios.map((scenario) => ({
  id: scenario.id,
  routes: scenario.routes,
  summary: textFor(scenario.summary, locale),
  sent: textFor(scenario.sent, locale),
  withheld: textFor(scenario.withheld, locale),
  result: textFor(scenario.result, locale),
  failure: textFor(scenario.failure, locale),
}));
const initialNodeIds = new Set(
  credentialRoutes
    .filter((route) => initialScenario.routes.includes(route.id))
    .flatMap((route) => [route.from, route.to]),
);
const ui = isJapanese
  ? {
      eyebrow: "固定コンポーネントマップ",
      intro:
        "コンポーネントの位置は変わりません。経路を切り替えると、その方式で実際に会話する境界だけが強調されます。自動再生はありません。",
      mapLabel:
        "左に信頼するホストの CLI、Workspace、AWS コンパニオン、中央のホスト所有の共有 cluster に OPA、Gateway、Auth Broker、暗号化された Context vault、右に外部エンドポイントと接続先を配置した認証アーキテクチャ図。",
      trustedHost: "信頼するホスト側",
      cluster: "共有 cluster · ホスト所有",
      external: "外部サービス",
      routes: "表示する経路",
      sent: "送る情報",
      withheld: "送らない情報",
      result: "成功時",
      failure: "失敗時",
      legend: "線の意味",
      control: "制御 / 固定処理",
      handle: "秘密ではない不透明なハンドル",
      metadata: "秘密を含まないメタデータ",
      secret: "秘密情報を扱う許可後の経路",
      network: "外部ネットワーク",
      transcript: "全経路を文章で読む",
      noPositionChange:
        "切り替えても箱の位置は変わりません。強調されていない箱も同じアーキテクチャに存在します。",
    }
  : {
      eyebrow: "Fixed component map",
      intro:
        "Component positions never move. Switch routes to highlight only the conversations that occur for that credential plan. Nothing plays automatically.",
      mapLabel:
        "Credential architecture with trusted-host CLI, Workspace, and AWS companion on the left; OPA, Gateway, Auth Broker, and encrypted vault in the shared cluster; and external endpoints and upstream on the right.",
      trustedHost: "Trusted host side",
      cluster: "Shared cluster · host-owned",
      external: "External services",
      routes: "Route to inspect",
      sent: "Information sent",
      withheld: "Information not sent",
      result: "On success",
      failure: "On failure",
      legend: "Line meaning",
      control: "Control / fixed operation",
      handle: "Opaque handle",
      metadata: "Secret-free metadata",
      secret: "Post-allow secret path",
      network: "External network",
      transcript: "Read every route as text",
      noPositionChange:
        "Boxes keep the same position when you switch. Dimmed boxes still exist in the architecture.",
    };
---

<tobari-credential-map
  data-scenarios={JSON.stringify(localizedScenarios)}
  data-initial={initialScenario.id}
>
  <figure class="credential-architecture">
    <figcaption>
      <span class="eyebrow">{ui.eyebrow}</span>
      <Heading>{title}</Heading>
      <p>{ui.intro}</p>
    </figcaption>

    <div class="credential-map-scroll" tabindex="0">
      <div class="credential-map-stage" role="img" aria-label={ui.mapLabel}>
        <div class="zone zone-host" aria-hidden="true">
          <span>{ui.trustedHost}</span>
        </div>
        <div class="zone zone-cluster" aria-hidden="true">
          <span>{ui.cluster}</span>
        </div>
        <div class="zone zone-external" aria-hidden="true">
          <span>{ui.external}</span>
        </div>

        <svg viewBox="0 0 1000 720" aria-hidden="true">
          <defs>
            <marker
              id="credential-map-arrow"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto-start-reverse"
            >
              <path d="M 0 0 L 10 5 L 0 10 z"></path>
            </marker>
          </defs>
          {
            credentialRoutes.map((route) => (
              <g
                class:list={[
                  "credential-route",
                  `route-${route.kind}`,
                  initialScenario.routes.includes(route.id) && "route-active",
                ]}
                data-route={route.id}
              >
                <path
                  id={`credential-route-${route.id}`}
                  d={route.path}
                  marker-end="url(#credential-map-arrow)"
                  marker-start={
                    route.bidirectional
                      ? "url(#credential-map-arrow)"
                      : undefined
                  }
                />
                <text>
                  <textPath
                    href={`#credential-route-${route.id}`}
                    startOffset="50%"
                    text-anchor="middle"
                  >
                    {textFor(route.label, locale)}
                  </textPath>
                </text>
              </g>
            ))
          }
        </svg>

        {
          credentialNodes.map((node) => (
            <article
              class:list={[
                "credential-node",
                `node-${node.id}`,
                `kind-${node.kind}`,
                initialNodeIds.has(node.id) && "node-active",
              ]}
              data-node={node.id}
            >
              <span class="node-role">{textFor(node.role, locale)}</span>
              <h3>{textFor(node.label, locale)}</h3>
              <p>{textFor(node.detail, locale)}</p>
            </article>
          ))
        }
      </div>
    </div>

    <p class="position-note">{ui.noPositionChange}</p>

    <div class="credential-scenario-tabs" role="group" aria-label={ui.routes}>
      {
        credentialScenarios.map((scenario) => (
          <button
            type="button"
            data-scenario={scenario.id}
            aria-pressed={scenario.id === initialScenario.id ? "true" : "false"}
            disabled
          >
            {textFor(scenario.label, locale)}
          </button>
        ))
      }
    </div>

    <section
      class="credential-scenario-detail"
      aria-live="polite"
      aria-atomic="true"
    >
      <p data-field="summary">{textFor(initialScenario.summary, locale)}</p>
      <dl>
        <div>
          <dt>{ui.sent}</dt>
          <dd data-field="sent">{textFor(initialScenario.sent, locale)}</dd>
        </div>
        <div>
          <dt>{ui.withheld}</dt>
          <dd data-field="withheld">
            {textFor(initialScenario.withheld, locale)}
          </dd>
        </div>
        <div>
          <dt>{ui.result}</dt>
          <dd data-field="result">{textFor(initialScenario.result, locale)}</dd>
        </div>
        <div>
          <dt>{ui.failure}</dt>
          <dd data-field="failure">
            {textFor(initialScenario.failure, locale)}
          </dd>
        </div>
      </dl>
    </section>

    <div class="credential-route-legend" aria-label={ui.legend}>
      <strong>{ui.legend}</strong>
      <span class="legend-control">{ui.control}</span>
      <span class="legend-handle">{ui.handle}</span>
      <span class="legend-metadata">{ui.metadata}</span>
      <span class="legend-secret">{ui.secret}</span>
      <span class="legend-network">{ui.network}</span>
    </div>

    <details class="credential-map-transcript" open>
      <summary>{ui.transcript}</summary>
      <ol>
        {
          credentialScenarios.map((scenario) => (
            <li>
              <h3>{textFor(scenario.label, locale)}</h3>
              <p>{textFor(scenario.summary, locale)}</p>
              <dl>
                <div>
                  <dt>{ui.sent}</dt>
                  <dd>{textFor(scenario.sent, locale)}</dd>
                </div>
                <div>
                  <dt>{ui.withheld}</dt>
                  <dd>{textFor(scenario.withheld, locale)}</dd>
                </div>
                <div>
                  <dt>{ui.result}</dt>
                  <dd>{textFor(scenario.result, locale)}</dd>
                </div>
                <div>
                  <dt>{ui.failure}</dt>
                  <dd>{textFor(scenario.failure, locale)}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
    </details>
  </figure>
</tobari-credential-map>

<script>
  interface ScenarioView {
    id: string;
    routes: string[];
    summary: string;
    sent: string;
    withheld: string;
    result: string;
    failure: string;
  }

  class TobariCredentialMap extends HTMLElement {
    scenarios: ScenarioView[] = [];

    connectedCallback() {
      this.querySelector<HTMLDetailsElement>(
        ".credential-map-transcript",
      )?.removeAttribute("open");
      try {
        this.scenarios = JSON.parse(
          this.dataset.scenarios || "[]",
        ) as ScenarioView[];
      } catch {
        return;
      }
      const buttons =
        this.querySelectorAll<HTMLButtonElement>("[data-scenario]");
      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener("click", () => {
          const scenario = this.scenarios.find(
            ({ id }) => id === button.dataset.scenario,
          );
          if (!scenario) return;
          buttons.forEach((candidate) =>
            candidate.setAttribute(
              "aria-pressed",
              String(candidate === button),
            ),
          );
          this.render(scenario);
        });
      });
    }

    render(scenario: ScenarioView) {
      const activeRoutes = new Set(scenario.routes);
      const activeNodes = new Set<string>();
      this.querySelectorAll<SVGGElement>("[data-route]").forEach((route) => {
        const active = activeRoutes.has(route.dataset.route || "");
        route.classList.toggle("route-active", active);
        if (!active) return;
        const routeId = route.dataset.route;
        const definition = routeDefinitions[routeId || ""];
        if (definition) {
          activeNodes.add(definition.from);
          activeNodes.add(definition.to);
        }
      });
      this.querySelectorAll<HTMLElement>("[data-node]").forEach((node) =>
        node.classList.toggle(
          "node-active",
          activeNodes.has(node.dataset.node || ""),
        ),
      );
      for (const field of [
        "summary",
        "sent",
        "withheld",
        "result",
        "failure",
      ] as const) {
        const target = this.querySelector(`[data-field="${field}"]`);
        if (target) target.textContent = scenario[field];
      }
    }
  }

  const routeDefinitions: Record<string, { from: string; to: string }> = {
    "acquire-provider": { from: "host-cli", to: "provider-login" },
    "commit-control": { from: "host-cli", to: "broker" },
    "vault-state": { from: "broker", to: "vault" },
    "workspace-proxy": { from: "workspace", to: "gateway" },
    policy: { from: "gateway", to: "opa" },
    "broker-introspect": { from: "gateway", to: "broker" },
    "upstream-request": { from: "gateway", to: "upstream" },
    "aws-companion": { from: "broker", to: "companion" },
    "aws-provider": { from: "companion", to: "provider-login" },
    "datadog-refresh": { from: "broker", to: "datadog-token" },
  };

  if (!customElements.get("tobari-credential-map"))
    customElements.define("tobari-credential-map", TobariCredentialMap);
</script>

<style>
  tobari-credential-map {
    display: block;
    margin-block: 2rem;
    scroll-margin-block-start: 5rem;
  }
  .credential-architecture {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
  }
  figcaption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
    gap: 0 2rem;
    align-items: end;
    padding: 1.2rem 1.35rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  figcaption .eyebrow {
    grid-column: 1;
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  figcaption :is(h2, h3) {
    grid-column: 1;
    margin: 0.25rem 0 0;
  }
  figcaption p {
    grid-column: 2;
    grid-row: 1 / 3;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .credential-map-scroll {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }
  .credential-map-stage {
    position: relative;
    width: 100%;
    min-width: 44rem;
    height: 46rem;
    overflow: hidden;
    background-image:
      linear-gradient(var(--sl-color-gray-6) 1px, transparent 1px),
      linear-gradient(90deg, var(--sl-color-gray-6) 1px, transparent 1px);
    background-size: 2rem 2rem;
  }
  .zone {
    position: absolute;
    inset-block: 1.5rem;
    border: 1px dashed currentColor;
    background: color-mix(in srgb, currentColor 4%, transparent);
  }
  .zone span {
    position: absolute;
    inset: -0.7rem auto auto 0.8rem;
    padding-inline: 0.35rem;
    background: var(--sl-color-gray-7);
    font-family: var(--sl-font-mono);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .zone-host {
    inset-inline: 1.5% 72.5%;
    color: var(--tobari-trusted);
  }
  .zone-cluster {
    inset-inline: 32% 32%;
    color: var(--tobari-control);
  }
  .zone-external {
    inset-inline: 72.5% 1.5%;
    color: var(--tobari-network);
  }
  svg {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  marker path {
    fill: context-stroke;
  }
  .credential-route {
    color: var(--sl-color-gray-4);
    opacity: 0.12;
    transition: opacity 160ms ease;
  }
  .credential-route.route-active {
    opacity: 1;
  }
  .credential-route path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    vector-effect: non-scaling-stroke;
  }
  .credential-route text {
    fill: currentColor;
    font-family: var(--sl-font-mono);
    font-size: 11px;
    font-weight: 750;
    paint-order: stroke;
    stroke: var(--sl-color-bg);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .route-control {
    color: var(--tobari-control);
  }
  .route-control path {
    stroke-dasharray: 10 5;
  }
  .route-handle {
    color: var(--tobari-handle);
  }
  .route-handle path {
    stroke-dasharray: 2 5;
    stroke-width: 3;
  }
  .route-metadata {
    color: var(--tobari-diagnostic);
  }
  .route-metadata path {
    stroke-dasharray: 7 4 2 4;
  }
  .route-secret {
    color: var(--tobari-secret);
  }
  .route-secret path {
    stroke-width: 3.5;
  }
  .route-network {
    color: var(--tobari-network);
  }
  .credential-node {
    position: absolute;
    z-index: 2;
    width: 11.5rem;
    min-height: 7rem;
    margin: 0;
    padding: 0.8rem;
    transform: translate(-50%, -50%);
    border: 1px solid currentColor;
    background: var(--sl-color-bg);
    box-shadow: 0 0.7rem 1.4rem rgb(0 0 0 / 14%);
    opacity: 0.52;
    transition:
      opacity 160ms ease,
      outline-color 160ms ease;
  }
  .credential-node.node-active {
    outline: 3px solid currentColor;
    outline-offset: 3px;
    opacity: 1;
  }
  .credential-node .node-role {
    display: inline-block;
    padding: 0.1rem 0.3rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-family: var(--sl-font-mono);
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .credential-node h3 {
    margin: 0.45rem 0 0.2rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .credential-node p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.68rem;
    line-height: 1.4;
  }
  .kind-trusted {
    color: var(--tobari-trusted);
  }
  .kind-untrusted {
    color: var(--tobari-untrusted);
    border-style: dashed;
  }
  .kind-control {
    color: var(--tobari-control);
  }
  .kind-secret {
    color: var(--tobari-secret);
    border-block-start-style: double;
    border-block-start-width: 4px;
  }
  .kind-external {
    color: var(--tobari-network);
    border-style: dashed;
  }
  .node-host-cli {
    left: 14%;
    top: 15%;
  }
  .node-workspace {
    left: 14%;
    top: 50%;
  }
  .node-companion {
    left: 14%;
    top: 85%;
  }
  .node-opa {
    left: 50%;
    top: 15%;
  }
  .node-gateway {
    left: 50%;
    top: 50%;
    width: 12.5rem;
  }
  .node-broker {
    left: 50%;
    top: 74%;
    width: 12.5rem;
  }
  .node-vault {
    left: 50%;
    top: 90%;
    min-height: 5.2rem;
    padding: 0.65rem;
  }
  .node-vault h3 {
    margin-top: 0.3rem;
    font-size: 0.76rem;
  }
  .node-vault p {
    font-size: 0.61rem;
    line-height: 1.3;
  }
  .node-provider-login {
    left: 86%;
    top: 15%;
  }
  .node-upstream {
    left: 86%;
    top: 50%;
  }
  .node-datadog-token {
    left: 86%;
    top: 85%;
  }
  .position-note {
    margin: 0;
    padding: 0.65rem 1rem;
    border-block: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
  .credential-scenario-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .credential-scenario-tabs button {
    min-height: 3.6rem;
    padding: 0.7rem;
    border: 0;
    border-inline-end: 1px solid var(--sl-color-gray-5);
    border-block-end: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 700;
    cursor: pointer;
  }
  .credential-scenario-tabs button:last-child {
    border-inline-end: 0;
  }
  .credential-scenario-tabs button:disabled {
    cursor: default;
  }
  .credential-scenario-tabs button[aria-pressed="true"] {
    background: var(--sl-color-gray-6);
    box-shadow: inset 0 -0.25rem var(--tobari-control);
    color: var(--sl-color-white);
  }
  .credential-scenario-detail {
    padding: 1rem;
  }
  .credential-scenario-detail > p {
    margin-top: 0;
    font-weight: 650;
  }
  .credential-scenario-detail dl,
  .credential-map-transcript dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-bottom: 0;
  }
  .credential-scenario-detail dl > div,
  .credential-map-transcript dl > div {
    padding: 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
  }
  dt {
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  dd {
    margin: 0.3rem 0 0;
    font-size: var(--sl-text-sm);
  }
  .credential-route-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    padding: 0.75rem 1rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
  }
  .credential-route-legend span::before {
    display: inline-block;
    width: 1.8rem;
    margin-inline-end: 0.35rem;
    border-block-start: 2px solid currentColor;
    content: "";
    vertical-align: middle;
  }
  .legend-control {
    color: var(--tobari-control);
  }
  .legend-control::before {
    border-block-start-style: dashed !important;
  }
  .legend-handle {
    color: var(--tobari-handle);
  }
  .legend-handle::before {
    border-block-start-style: dotted !important;
    border-block-start-width: 3px !important;
  }
  .legend-metadata {
    color: var(--tobari-diagnostic);
  }
  .legend-metadata::before {
    border-block-start-style: dashed !important;
  }
  .legend-secret {
    color: var(--tobari-secret);
  }
  .legend-secret::before {
    border-block-start-style: double !important;
    border-block-start-width: 4px !important;
  }
  .legend-network {
    color: var(--tobari-network);
  }
  .credential-map-transcript {
    margin: 0;
    padding: 0.15rem 1rem 0.7rem;
    border: 0;
    border-block-start: 1px solid var(--sl-color-gray-5);
  }
  .credential-map-transcript summary {
    padding-block: 0.7rem;
    cursor: pointer;
    font-weight: 700;
  }
  .credential-map-transcript li {
    margin-block: 1.2rem;
  }
  .credential-map-transcript h3 {
    margin-bottom: 0.25rem;
  }
  @media (max-width: 48rem) {
    figcaption {
      grid-template-columns: 1fr;
    }
    figcaption p {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0.7rem;
    }
    .credential-map-stage {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.7rem;
      min-width: 0;
      height: auto;
      padding: 1rem;
      overflow: visible;
      background-image: none;
    }
    .credential-map-stage svg,
    .zone {
      display: none;
    }
    .credential-node {
      position: static;
      width: auto;
      min-height: 0;
      transform: none;
      opacity: 0.72;
    }
    .credential-node.node-active {
