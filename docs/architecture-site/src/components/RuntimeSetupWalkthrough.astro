---
const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const t = <T,>(english: T, japanese: T) => (isJapanese ? japanese : english);
const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}${isJapanese ? "ja/" : ""}${path.replace(/^\//, "")}`;
const evidenceHref = (path: string) =>
  `${__TOBARI_DOCS_REPOSITORY__}/blob/${__TOBARI_DOCS_COMMIT__}/${path}`;

const flow = [
  {
    from: t("Trusted host", "信頼するホスト"),
    to: t("Runtime source", "Runtime ソース"),
    title: t("Create one reusable Runtime", "再利用できる Runtime を作る"),
    detail: t(
      "runtime create creates an owner-only complete build context. It does not build or change a Workspace Manifest.",
      "runtime create は所有者専用の完全なビルドコンテキストを作ります。ビルドも Workspace Manifest の変更もしません。",
    ),
    kind: "control",
  },
  {
    from: t("Runtime source", "Runtime ソース"),
    to: t("Host Docker build", "ホストの Docker ビルド"),
    title: t(
      "Install the agent and toolchain",
      "エージェントと開発ツールを追加する",
    ),
    detail: t(
      "Edit Dockerfile and adjacent files, then run runtime build. Tobari validates and snapshots the complete source tree first.",
      "Dockerfile と付属ファイルを編集し、runtime build を実行します。Tobari は完全なソースツリーを検証して先にスナップショットします。",
    ),
    kind: "trusted",
  },
  {
    from: t("Host Docker build", "ホストの Docker ビルド"),
    to: t("Compatibility check", "互換性検査"),
    title: t("Validate the resulting image", "生成したイメージを検査する"),
    detail: t(
      "Tobari checks the runtime API, lifetime capability, entrypoint, user, architecture, and immutable local digest.",
      "Tobari はランタイム API、寿命管理機能、エントリーポイント、ユーザー、アーキテクチャ、不変なローカルダイジェストを確認します。",
    ),
    kind: "diagnostic",
  },
  {
    from: t("Compatibility check", "互換性検査"),
    to: t("Runtime history", "Runtime 履歴"),
    title: t(
      "Append only a compatible revision",
      "互換リビジョンだけを追加する",
    ),
    detail: t(
      "A successful build appends immutable history. Failed and unchanged builds leave history and every Workspace Manifest unchanged.",
      "成功したビルドだけが不変履歴を追加します。失敗または同一内容なら履歴も全 Workspace Manifest も変わりません。",
    ),
    kind: "allowed",
  },
  {
    from: t("Runtime history", "Runtime 履歴"),
    to: t("Workspace Manifest binding", "Workspace Manifest の参照"),
    title: t("Select one exact revision", "正確な一つのリビジョンを選ぶ"),
    detail: t(
      "manifest runtime set explicitly pins standard or name@ordinal. Builds never roll Workspace Manifests forward.",
      "manifest runtime set で standard または name@ordinal を明示的に固定します。ビルドで Workspace Manifest は自動更新されません。",
    ),
    kind: "allowed",
  },
  {
    from: t("Workspace Manifest binding", "Workspace Manifest の参照"),
    to: "Workspace",
    title: t("Reconcile on the next entry", "次の入室時に反映する"),
    detail: t(
      "The next tobari entry creates or replaces only the work container that has runtime drift. Project files, Workspace identity, home, and learned policy remain.",
      "次に tobari で入るとき、ランタイムに差分がある作業コンテナだけを作成または置き換えます。プロジェクトファイル、Workspace の識別情報、ホーム、学習済みポリシーは残ります。",
    ),
    kind: "network",
  },
];

const steps = [
  {
    title: t("Create one reusable Runtime", "再利用できる Runtime を作る"),
    location: t("Trusted host", "信頼するホスト"),
    command: `tobari runtime create --name coding\ntobari runtime show --name coding`,
    expected: t(
      "The report gives the stable Runtime ID and owner-only source path. Creation changes no Workspace Manifest.",
      "安定した Runtime ID と所有者専用ソースパスが表示されます。作成では Workspace Manifest は変わりません。",
    ),
    note: t(
      "Runtime names are installation-wide. Use runtime list before choosing another unique name.",
      "Runtime 名はインストール全体で固有です。別名を決める前に runtime list を確認します。",
    ),
  },
  {
    title: t(
      "Edit the complete Runtime source tree",
      "Runtime ソースツリー全体を編集する",
    ),
    location: t("Trusted host", "信頼するホスト"),
    command: t(
      `<editor> <source-path>/Dockerfile`,
      `<エディタ> <source-path>/Dockerfile`,
    ),
    expected: t(
      "Dockerfile, scripts, manifests, and configuration are managed together under source/. Editing creates no revision.",
      "Dockerfile、スクリプト、マニフェスト、設定を source/ 配下で一緒に管理します。編集だけではリビジョンを作りません。",
    ),
    note: t(
      "Never place access tokens, host credentials, or private package configuration in build source or image layers.",
      "アクセストークン、ホスト認証情報、非公開パッケージ設定をビルドソースやイメージ層へ入れません。",
    ),
  },
  {
    title: t(
      "Build and inspect immutable history",
      "不変履歴をビルドして確認する",
    ),
    location: t("Trusted host", "信頼するホスト"),
    command: t(
      `tobari runtime build --name coding\ntobari runtime history --name coding`,
      `tobari runtime build --name coding\ntobari runtime history --name coding`,
    ),
    expected: t(
      "A compatible build appends coding@1. The build uses an immutable full-tree snapshot and changes no Workspace Manifest.",
      "互換ビルドが coding@1 を追加します。不変なツリー全体のスナップショットを使い、Workspace Manifest は変えません。",
    ),
    note: t(
      "A failed or unchanged build appends no ordinal. Review every base image and download used by the host build.",
      "失敗または同一内容のビルドでは ordinal を追加しません。ホストビルドが使うベースと取得元を確認します。",
    ),
  },
  {
    title: t(
      "Bind the ready revision to a Workspace Manifest",
      "準備済みリビジョンを Workspace Manifest に固定する",
    ),
    location: t("Trusted host", "信頼するホスト"),
    command: `tobari manifest runtime set --runtime coding@1\ntobari manifest show`,
    expected: t(
      "The selected Workspace Manifest reports coding@1. The same revision may be selected by another Manifest.",
      "選択した Workspace Manifest に coding@1 が表示されます。同じリビジョンを別 Manifest でも選べます。",
    ),
    note: t(
      "Building coding@2 later does not upgrade this Manifest. Select a different ordinal explicitly for upgrade or rollback.",
      "後で coding@2 をビルドしてもこの Manifest は更新されません。更新やロールバックでは別 ordinal を明示的に選びます。",
    ),
  },
  {
    title: t(
      "Enter a real project and verify the executable",
      "実際のプロジェクトへ入り、実行ファイルを確認する",
    ),
    location: t("Trusted host → Workspace", "信頼するホスト → Workspace"),
    command: t(
      `cd /path/to/your/project\ntobari\n\n# Inside the Workspace\ncommand -v <agent-command>\n<agent-command> --version`,
      `cd /path/to/your/project\ntobari\n\n# Workspace 内\ncommand -v <エージェントのコマンド>\n<エージェントのコマンド> --version`,
    ),
    expected: t(
      "The agent executable and required toolchain are available inside the Workspace. Existing Workspaces may recreate only their work container on this entry.",
      "Workspace 内でエージェントの実行ファイルと必要なツールチェーンを利用できます。既存 Workspace では、この入室時に作業コンテナだけを再作成する場合があります。",
    ),
    note: t(
      "Replace the placeholders with the command installed by your chosen agent. Authentication and outbound permissions are configured separately; installing the binary grants neither.",
      "プレースホルダーは、利用するエージェントの実際のコマンドへ置き換えてください。認証と外部通信の許可は別に設定します。実行ファイルを追加しただけでは、どちらの権限も増えません。",
    ),
  },
];

const dockerfileExample = `# Keep the generated FROM line and USER transitions.\n# Add commands like these between USER root and USER tobari.\n\nRUN apt-get update \\\n    && apt-get install -y --no-install-recommends \\\n       nodejs npm ripgrep \\\n    && rm -rf /var/lib/apt/lists/*\n\n# Replace both placeholders with the official, version-pinned\n# package for the coding agent you use.\nRUN npm install --global <coding-agent-package>@<version>`;

const installChecklist = t(
  [
    "The coding-agent executable and its language runtime",
    "The compiler, package manager, test runner, and search tools used by the project",
    "A non-root execution path that works as the tobari user",
    "Pinned or otherwise reviewable versions for externally downloaded tools",
  ],
  [
    "コーディングエージェントの実行ファイルと、その実行に必要な言語ランタイム",
    "プロジェクトで使うコンパイラー、パッケージマネージャー、テストランナー、検索ツール",
    "tobari ユーザーで動作する非 root の実行経路",
    "外部から取得するツールの、固定またはレビュー可能なバージョン",
  ],
);

const limits = t(
  [
    "The build context is the immutable snapshot of Runtime source/, not the current project. COPY cannot read arbitrary project or host files.",
    "Do not replace the generated base, entrypoint, final user, or required runtime labels unless you are intentionally implementing the exact runtime contract.",
    "Do not bake secrets into Dockerfile instructions, build arguments, package configuration, image layers, or shell history.",
    "A compatible image supplies tools only. Tobari still fixes mounts, network, capabilities, resources, project identity, and Workspace lifetime.",
  ],
  [
    "ビルドコンテキストは Runtime source/ の不変スナップショットです。現在のプロジェクトや任意のホストファイルを COPY することはできません。",
    "完全なランタイム契約を意図的に実装する場合を除き、生成されたベース、エントリーポイント、最後のユーザー、必須ラベルを置き換えないでください。",
    "Dockerfile、ビルド引数、パッケージ設定、イメージレイヤー、シェル履歴へ秘密情報を入れないでください。",
    "互換イメージが提供するのはツールです。マウント、ネットワーク、capability、リソース、プロジェクトの識別、Workspace の寿命は引き続き Tobari が固定します。",
  ],
);
---

<div class="runtime-setup">
  <section class="runtime-intro">
    <p class="runtime-eyebrow">
      {
        t(
          "Required before real project work",
          "実際のプロジェクトで使う前に必要",
        )
      }
    </p>
    <h2>
      {
        t(
          "Quickstart verifies policy control; it does not install a coding agent",
          "クイックスタートで確認するのは通信制御です。コーディングエージェントは入りません",
        )
      }
    </h2>
    <p>
      {
        t(
          "The standard Runtime is intentionally minimal. Quickstart uses its curl command directly so you can verify denial, review, allow, and retry without choosing an agent. For real work, build one reusable Runtime and explicitly select its ready revision for the Workspace Manifests that need it.",
          "標準 Runtime は意図的に最小限です。クイックスタートでは curl を使い、エージェントを選ばずに拒否、レビュー、許可、再実行を確認します。実作業では再利用できる Runtime をビルドし、必要な Workspace Manifest へ準備済みリビジョンを明示的に選択します。",
        )
      }
    </p>
    <aside class="runtime-required">
      <strong>{t("Practical completion condition", "実用開始の条件")}</strong>
      <span>
        {
          t(
            "Do not treat Quickstart completion as agent setup. You are ready for real work only after the intended agent command succeeds inside the Workspace.",
            "クイックスタート完了を、エージェント導入完了とは扱わないでください。Workspace 内で利用予定のエージェントコマンドを実行できた時点で、実作業へ進めます。",
          )
        }
      </span>
    </aside>
  </section>

  <section class="runtime-section">
    <p class="runtime-eyebrow">
      {t("One controlled build path", "ランタイムを採用する流れ")}
    </p>
    <h2>
      {
        t(
          "Follow source, revision, binding, and Workspace",
          "ソース、リビジョン、参照、Workspace を順に追う",
        )
      }
    </h2>
    <p class="runtime-section-intro">
      {
        t(
          "Runtime source and immutable history are installation-wide. Build never changes a Workspace Manifest; explicit selection pins one ready revision, and Workspaces observe it on their next entry.",
          "Runtime ソースと不変履歴はインストール全体に属します。ビルドは Workspace Manifest を変えず、明示的な選択で準備済みリビジョンを固定し、Workspace は次の入室時に反映します。",
        )
      }
    </p>
    <ol
      class="runtime-flow"
      aria-label={t(
        "Custom runtime setup flow",
        "カスタムランタイムの導入フロー",
      )}
    >
      {
        flow.map((item, index) => (
          <li class={`runtime-flow-${item.kind}`}>
            <span class="runtime-flow-number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <p class="runtime-route">
              <>
                <strong>{item.from}</strong>
                <b aria-hidden="true">→</b>
                <strong>{item.to}</strong>
              </>
            </p>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </li>
        ))
      }
    </ol>
    <p class="runtime-failure">
      <strong
        >{
          t("If build or validation fails:", "ビルドまたは検査に失敗した場合:")
        }</strong
      >{" "}
      {
        t(
          "no revision is appended and every Workspace Manifest binding stays unchanged. Inspect the build output and runtime show.",
          "リビジョンは追加されず、すべての Workspace Manifest 参照が変わりません。ビルド出力と runtime show を確認してください。",
        )
      }
    </p>
  </section>

  <section class="runtime-section">
    <p class="runtime-eyebrow">
      {t("Do this once per tooling profile", "ツール構成ごとに一度行う")}
    </p>
    <h2>
      {t("Build the runtime in five steps", "五つの手順でランタイムを用意する")}
    </h2>
    <ol class="runtime-steps">
      {
        steps.map((step, index) => (
          <li>
            <header>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <>
                  <p>{step.location}</p>
                  <h3>{step.title}</h3>
                </>
              </div>
            </header>
            <pre>
              <code>{step.command}</code>
            </pre>
            <dl>
              <div>
                <>
                  <dt>{t("Expected result", "期待する結果")}</dt>
                  <dd>{step.expected}</dd>
                </>
              </div>
              <div>
                <>
                  <dt>{t("Important", "重要")}</dt>
                  <dd>{step.note}</dd>
                </>
              </div>
            </dl>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="runtime-section runtime-recipe">
    <p class="runtime-eyebrow">
      {t("Dockerfile pattern", "Dockerfile の基本形")}
    </p>
    <h2>
      {
        t(
          "Extend the generated base; do not replace its contract",
          "生成されたベースを拡張し、契約は置き換えない",
        )
      }
    </h2>
    <p>
      {
        t(
          "The generated file already contains FROM, USER root, and the final USER tobari. Insert the installation commands between the two USER lines. This example represents an npm-distributed agent; use the official installation method for the agent you actually choose.",
          "生成ファイルには FROM、USER root、最後の USER tobari がすでにあります。二つの USER 行の間へインストール処理を追加します。次は npm で配布されるエージェントの例です。実際には、利用するエージェントの公式な導入方法を使ってください。",
        )
      }
    </p>
    <pre><code>{dockerfileExample}</code></pre>
    <p class="runtime-caption">
      {
        t(
          "The placeholders are intentional: Tobari does not prescribe one coding agent. Replace them with a reviewed package name and version, then verify the installed command inside the Workspace.",
          "プレースホルダーは意図的です。Tobari は特定のコーディングエージェントを指定しません。確認済みのパッケージ名とバージョンへ置き換え、Workspace 内で実行コマンドを検証してください。",
        )
      }
    </p>
  </section>

  <section class="runtime-section runtime-two-column">
    <div>
      <h2>
        {
          t(
            "Include what the agent needs",
            "エージェントが必要とするものを入れる",
          )
        }
      </h2>
      <ul>{installChecklist.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div class="runtime-limits">
      <h2>{t("Keep these boundaries", "維持する境界")}</h2>
      <ul>{limits.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="runtime-section runtime-next">
    <h2>
      {t("After the agent command works", "エージェントの実行を確認した後")}
    </h2>
    <p>
      {
        t(
          "Configure authentication only for providers you need, then allow outbound effects as they are observed. Runtime contents, service authentication, and network authorization remain three separate concerns.",
          "必要な外部サービスだけ認証を設定し、外部通信は観測された通信条件ごとに許可します。ランタイムに入れるツール、外部サービスの認証、ネットワーク通信の許可は、それぞれ別に管理します。",
        )
      }
    </p>
    <nav
      aria-label={t(
        "Next runtime documentation",
        "ランタイム導入後に読むページ",
      )}
    >
      <a href={withBase("/guides/authentication/")}
        >{t("Configure authentication", "認証を設定する")} →</a
      >
      <a href={withBase("/start/first-denial/")}
        >{t("Review denied communication", "拒否された通信をレビューする")} →</a
      >
      <a href={withBase("/guides/runtime-customization/")}
        >{t("Read detailed runtime behavior", "ランタイムの詳細動作を読む")} →</a
      >
      <a href={withBase("/reference/runtime-image-contract/")}
        >{t("Open the exact image contract", "正確なイメージ契約を確認する")} →</a
      >
    </nav>
  </section>

  <details class="runtime-evidence">
    <summary
      >{
        t("Implementation and contract references", "実装と契約を確認する")
      }</summary
    >
    <ul>
      <li>
        <a
          href={evidenceHref("internal/infra/dockerruntime/runtime_library.go")}
          >{
            t(
              "Runtime source, snapshot, build, validation, and history",
              "Runtime ソース、スナップショット、ビルド、検査、履歴",
            )
          }</a
        >
      </li>
      <li>
        <a
          href={evidenceHref("internal/infra/dockerruntime/project_runtime.go")}
          >{
            t("Workspace runtime reconciliation", "Workspace ランタイムの調整")
          }</a
        >
      </li>
      <li>
        <a href={evidenceHref("internal/cli/runtime_catalog.go")}
          >{
            t(
              "Runtime catalog and Workspace Manifest selection command contracts",
              "Runtime Catalog と Workspace Manifest 選択のコマンド契約",
            )
          }</a
        >
      </li>
      <li>
        <a href={evidenceHref("runtimes/base/Dockerfile")}
          >{t("Official base runtime", "公式ベースランタイム")}</a
        >
      </li>
      <li>
        <a href={evidenceHref("tools/runtimecheck/main.go")}
          >{t("Runtime compatibility checker", "ランタイム互換性検査")}</a
        >
      </li>
    </ul>
  </details>
</div>

<style>
  .runtime-setup {
    display: grid;
    gap: 2.5rem;
  }
  .runtime-intro,
  .runtime-section {
    min-width: 0;
  }
  .runtime-eyebrow {
    margin: 0 0 0.45rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 760;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }
  .runtime-intro h2,
  .runtime-section > h2 {
    margin: 0;
    max-width: 28ch;
    font-size: clamp(1.55rem, 3.5vw, 2.35rem);
    line-height: 1.18;
  }
  .runtime-intro > p:not(.runtime-eyebrow),
  .runtime-section-intro {
    max-width: 72ch;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
  }
  .runtime-required,
  .runtime-failure {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.25rem;
    padding: 1rem 1.1rem;
    border-inline-start: 0.28rem solid var(--sl-color-orange);
    background: color-mix(in srgb, var(--sl-color-orange-low) 65%, transparent);
  }
  .runtime-flow {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .runtime-flow li {
    position: relative;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-nav);
  }
  .runtime-flow li:not(:last-child)::after {
    content: "→";
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-end: -0.68rem;
    z-index: 2;
    display: grid;
    width: 1.3rem;
    height: 1.3rem;
    place-items: center;
    border-radius: 50%;
    background: var(--sl-color-bg);
    color: var(--sl-color-text-accent);
    font-weight: 800;
  }
  .runtime-flow-number {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font-size: var(--sl-text-xs);
    font-weight: 800;
  }
  .runtime-route {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0.75rem 0 0.4rem;
    font-size: var(--sl-text-xs);
  }
  .runtime-route b {
    color: var(--sl-color-text-accent);
  }
  .runtime-flow h3 {
    margin: 0.45rem 0;
    font-size: var(--sl-text-lg);
    line-height: 1.25;
  }
  .runtime-flow li > p:last-child {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .runtime-flow-allowed {
    border-block-start: 0.22rem solid var(--sl-color-green) !important;
  }
