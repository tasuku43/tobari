---
import { diagrams, type DiagramKind } from "../data/diagrams";
import { diagramsJa } from "../data/diagrams.ja";

interface Props {
  name: keyof typeof diagrams;
  headingLevel?: 2 | 3;
}

const { name, headingLevel = 2 } = Astro.props;
const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const localizedDiagrams = isJapanese ? diagramsJa : diagrams;
const diagram = localizedDiagrams[name];
if (!diagram) throw new Error(`Unknown Tobari diagram: ${String(name)}`);
const Heading = `h${headingLevel}` as "h2" | "h3";
const kindLabels: Record<DiagramKind, string> = isJapanese
  ? {
      trusted: "信頼する領域",
      untrusted: "信頼しない領域",
      control: "制御",
      network: "通信",
      persistent: "永続状態",
      secret: "秘密情報",
      handle: "秘密ではないハンドル",
      allowed: "許可",
      denied: "拒否",
      diagnostic: "診断情報",
    }
  : {
      trusted: "Trusted",
      untrusted: "Untrusted",
      control: "Control",
      network: "Network",
      persistent: "Persistent",
      secret: "Secret",
      handle: "Non-secret handle",
      allowed: "Allowed",
      denied: "Denied",
      diagnostic: "Diagnostic",
    };
const ui = isJapanese
  ? {
      conceptual: "概念図：",
      conceptualNote:
        "実行時の構成と障害時の動作は、リンク先の詳細ページで確認してください。",
      connections: "接続関係",
      transcript: "この図をテキストで読む",
      meaning: "分類",
      separator: "：",
      sentenceEnd: "。",
    }
  : {
      conceptual: "Conceptual view:",
      conceptualNote:
        "follow the linked detail page for runtime topology and failure semantics.",
      connections: "Connections",
      transcript: "Read this diagram as text",
      meaning: "Meaning",
      separator: ": ",
      sentenceEnd: ".",
    };
---

<figure class="concept-diagram" data-diagram={name}>
  <figcaption>
    <Heading>{diagram.title}</Heading>
    <p>{diagram.description}</p>
    {
      diagram.conceptual && (
        <p class="concept-note">
          <strong>{ui.conceptual}</strong> {ui.conceptualNote}
        </p>
      )
    }
  </figcaption>
  <div
    class="diagram-canvas"
    role="img"
    aria-label={`${diagram.title}. ${diagram.description}`}
  >
    <div class="diagram-nodes">
      {
        diagram.nodes.map((node) => (
          <article
            class:list={[
              "diagram-node",
              `kind-${node.kind}`,
              `shape-${node.shape || "box"}`,
            ]}
          >
            <span class="kind-label">{kindLabels[node.kind]}</span>
            <h3>{node.label}</h3>
            <p>{node.detail}</p>
          </article>
        ))
      }
    </div>
    <ol class="diagram-edges" aria-label={ui.connections}>
      {
        diagram.edges.map((edge) => (
          <li
            class:list={[`kind-${edge.kind}`, `edge-${edge.style || "solid"}`]}
          >
            <span class="edge-from">
              {diagram.nodes.find(({ id }) => id === edge.from)?.label ||
                edge.from}
            </span>
            <span class="edge-arrow" aria-hidden="true">
              {edge.style === "blocked" ? "⊣" : "→"}
            </span>
            <span class="edge-to">
              {diagram.nodes.find(({ id }) => id === edge.to)?.label || edge.to}
            </span>
            <span class="edge-label">{edge.label}</span>
            <span class="edge-kind">{kindLabels[edge.kind]}</span>
          </li>
        ))
      }
    </ol>
  </div>
  <details class="diagram-transcript">
    <summary>{ui.transcript}</summary>
    <ol>
      {
        diagram.edges.map((edge) => (
          <li>
            <strong>
              {diagram.nodes.find(({ id }) => id === edge.from)?.label ||
                edge.from}
            </strong>
            {" → "}
            <strong>
              {diagram.nodes.find(({ id }) => id === edge.to)?.label || edge.to}
            </strong>
            {ui.separator}
            {edge.label}
            {ui.sentenceEnd}{" "}
            <span class="transcript-kind">
              {ui.meaning}
              {ui.separator}
              {kindLabels[edge.kind]}
              {ui.sentenceEnd}
            </span>
          </li>
        ))
      }
    </ol>
  </details>
</figure>

<style>
  .concept-diagram {
    margin: 2rem 0;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.15rem;
    background: var(--sl-color-gray-7);
  }
  .concept-diagram figcaption h2,
  .concept-diagram figcaption h3 {
    margin: 0 0 0.35rem;
  }
  .concept-diagram figcaption > p {
    margin: 0.3rem 0;
    color: var(--sl-color-gray-2);
  }
  .concept-note {
    font-size: var(--sl-text-sm);
  }
  .diagram-canvas {
    margin-top: 1.2rem;
  }
  .diagram-nodes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 0.7rem;
  }
  .diagram-nodes > * {
    height: 100%;
    margin: 0;
  }
  [data-diagram="code-layers"] .diagram-nodes {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .diagram-node {
    display: grid;
    grid-template-rows: auto auto 1fr;
    min-width: 0;
    min-height: 9.5rem;
    padding: 0.8rem;
    border: 2px solid currentColor;
    background: var(--sl-color-bg);
  }
  .diagram-node.kind-untrusted,
  .diagram-node.kind-handle,
  .diagram-node.kind-diagnostic {
    border-style: dashed;
  }
  .diagram-node.kind-secret,
  .diagram-node.kind-persistent {
    border-block-start-style: double;
    border-block-start-width: 4px;
  }
  .diagram-node.kind-denied {
    border-style: double;
  }
  .diagram-node.shape-store {
    border-radius: 1rem 1rem 0.25rem 0.25rem;
    box-shadow: inset 0 0.32rem 0 -0.16rem currentColor;
  }
  .diagram-node.shape-boundary {
    border-style: dashed;
  }
  .diagram-node h3 {
    margin: 0.3rem 0 0;
    color: inherit;
    font-size: var(--sl-text-base);
  }
  .diagram-node p {
    margin: 0.35rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .kind-label,
  .edge-kind {
    display: inline-block;
    width: fit-content;
    padding: 0.12rem 0.35rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .diagram-edges {
    display: grid;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .diagram-edges li {
    display: grid;
    grid-template-columns:
      minmax(7rem, 1fr) auto minmax(7rem, 1fr) minmax(11rem, 2fr)
      auto;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.55rem 0.7rem;
    border-inline-start: 0.3rem solid currentColor;
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
  }
  .diagram-edges li.edge-dashed {
    border-inline-start-style: dashed;
  }
  .diagram-edges li.edge-blocked {
    border-inline-start-style: double;
    text-decoration-color: currentColor;
  }
  .diagram-edges li.kind-network,
  .diagram-edges li.kind-diagnostic {
    border-inline-start-style: dotted;
  }
  .diagram-edges li.kind-handle,
  .diagram-edges li.kind-untrusted {
    border-inline-start-style: dashed;
  }
  .diagram-edges li.kind-secret,
  .diagram-edges li.kind-denied {
    border-inline-start-style: double;
    border-inline-start-width: 0.45rem;
  }
  .edge-arrow {
    font-size: 1.25rem;
    font-weight: 900;
  }
  .edge-label {
    color: var(--sl-color-gray-2);
  }
  .edge-kind {
    justify-self: end;
    white-space: nowrap;
  }
  .transcript-kind {
    font-weight: 700;
  }
  .kind-trusted {
    color: var(--tobari-trusted);
  }
  .kind-untrusted {
    color: var(--tobari-untrusted);
  }
  .kind-control {
    color: var(--tobari-control);
  }
  .kind-network {
    color: var(--tobari-network);
  }
  .kind-persistent {
    color: var(--tobari-persistent);
  }
  .kind-secret {
    color: var(--tobari-secret);
  }
  .kind-handle {
    color: var(--tobari-handle);
  }
  .kind-allowed {
    color: var(--tobari-allowed);
  }
  .kind-denied {
    color: var(--tobari-denied);
  }
  .kind-diagnostic {
    color: var(--tobari-diagnostic);
  }
  .diagram-transcript {
    margin-top: 1rem;
  }
  .diagram-transcript summary {
    cursor: pointer;
    font-weight: 700;
  }
  @media (max-width: 42rem) {
    .diagram-nodes,
    [data-diagram="code-layers"] .diagram-nodes {
      grid-template-columns: 1fr;
    }
    .diagram-node {
      min-height: 0;
    }
    .diagram-edges li {
      grid-template-columns: 1fr auto 1fr;
    }
    .edge-label,
    .edge-kind {
      grid-column: 1 / -1;
      justify-self: start;
    }
    .edge-label {
      padding-top: 0.25rem;
      border-top: 1px dotted currentColor;
    }
  }
  @media print {
    .concept-diagram {
      border-color: #222;
      background: transparent;
      break-inside: avoid;
    }
    .diagram-node,
    .diagram-edges li {
      color: #000 !important;
      background: transparent;
    }
    .diagram-transcript {
      display: block;
    }
    .diagram-transcript > * {
      display: block !important;
    }
    .diagram-transcript summary {
      display: none !important;
    }
  }
</style>
