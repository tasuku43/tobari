---
import { diagramLayouts, type DiagramRegion } from "../data/diagramLayouts";
import { diagrams, type DiagramEdge, type DiagramKind } from "../data/diagrams";
import { diagramsJa } from "../data/diagrams.ja";

interface Props {
  name: keyof typeof diagrams;
  headingLevel?: 2 | 3;
}

interface Point {
  x: number;
  y: number;
}

const { name, headingLevel = 2 } = Astro.props;
const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const diagram = (isJapanese ? diagramsJa : diagrams)[name];
const layout = diagramLayouts[name];
if (!diagram) throw new Error(`Unknown Tobari diagram: ${String(name)}`);
if (!layout) throw new Error(`Missing Tobari diagram layout: ${String(name)}`);

const Heading = `h${headingLevel}` as "h2" | "h3";
const markerKey = String(name).replace(/[^a-z0-9_-]/gi, "-");
const arrowMarker = `flow-arrow-${markerKey}`;
const blockedMarker = `flow-blocked-${markerKey}`;
const hasRegions = Boolean(layout.regions?.length);

const kindLabels: Record<DiagramKind, string> = isJapanese
  ? {
      trusted: "ホストが管理",
      untrusted: "信頼しない入力",
      control: "判断・制御",
      network: "通信",
      persistent: "永続状態",
      secret: "秘密情報",
      allowed: "許可後",
      denied: "拒否",
      diagnostic: "確認・診断",
    }
  : {
      trusted: "Host-owned",
      untrusted: "Untrusted input",
      control: "Decision / control",
      network: "Network",
      persistent: "Persistent state",
      secret: "Secret material",
      allowed: "After allow",
      denied: "Denied",
      diagnostic: "Review / diagnostic",
    };

const modeLabels = isJapanese
  ? {
      sequence: "処理の順序",
      relationship: "配置と関係",
      state: "状態の遷移",
    }
  : {
      sequence: "Processing order",
      relationship: "Placement and relationships",
      state: "State transitions",
    };

const ui = isJapanese
  ? {
      reading: hasRegions
        ? "背景の領域で存在場所を確認し、番号付きの矢印を追って、何がどこへ移動するかを読みます。箱は構成要素や状態の位置を示します。"
        : "番号付きの矢印を追って、何がどこへ移動するか、または状態がどう変わるかを読みます。箱は構成要素や状態の位置を示します。",
      mapLabel: "横方向にスクロールできる図",
      legendRegion: "背景 = 存在場所・所有範囲",
      legendNode: "箱 = 構成要素または状態",
      legendArrow: "番号付き矢印 = 処理・通信・依存関係",
      legendStop: "赤い停止線 = 経路または依存を作らない",
      steps: "番号順に読む",
      blocked: "ここで停止",
      conceptual: "この図は理解のために経路を単純化しています。",
      location: "存在場所",
    }
  : {
      reading: hasRegions
        ? "Use the background regions to locate each concept, then follow the numbered arrows to see what moves where. Boxes anchor components or states."
        : "Follow the numbered arrows to see what moves where or how state changes. Boxes anchor components or states.",
      mapLabel: "Horizontally scrollable diagram",
      legendRegion: "Background = location or ownership",
      legendNode: "Box = component or state",
      legendArrow: "Numbered arrow = processing, traffic, or dependency",
      legendStop: "Red stop = no route or dependency",
      steps: "Read in number order",
      blocked: "stops here",
      conceptual: "This view simplifies the route for explanation.",
      location: "Location",
    };

const nodeById = Object.fromEntries(
  diagram.nodes.map((node) => [node.id, node]),
);

const regionLabel = (region: DiagramRegion) =>
  isJapanese ? region.japaneseLabel : region.label;

const regionForNode = (nodeId: string) => {
  const position = layout.nodes[nodeId];
  if (!position) return undefined;
  return layout.regions?.find(
    (region) =>
      position.x >= region.x &&
      position.x <= region.x + region.width &&
      position.y >= region.y &&
      position.y <= region.y + region.height,
  );
};

const edgePairKey = (edge: DiagramEdge) =>
  edge.from === edge.to
    ? `self:${edge.from}`
    : [edge.from, edge.to].sort().join("|");
const edgeGroups = new Map<string, number[]>();
diagram.edges.forEach((edge, index) => {
  const key = edgePairKey(edge);
  edgeGroups.set(key, [...(edgeGroups.get(key) ?? []), index]);
});

const boxEdge = (
  center: Point,
  target: Point,
  width: number,
  height: number,
): Point => {
  const dx = target.x - center.x;
  const dy = target.y - center.y;
  const length = Math.hypot(dx, dy) || 1;
  const ux = dx / length;
  const uy = dy / length;
  const scale =
    1 / Math.max(Math.abs(ux) / (width / 2), Math.abs(uy) / (height / 2));
  return { x: center.x + ux * scale, y: center.y + uy * scale };
};

const quadraticPoint = (
  start: Point,
  control: Point,
  end: Point,
  t: number,
): Point => {
  const inverse = 1 - t;
  return {
    x:
      inverse * inverse * start.x + 2 * inverse * t * control.x + t * t * end.x,
    y:
      inverse * inverse * start.y + 2 * inverse * t * control.y + t * t * end.y,
  };
};

const clamp = (value: number, min: number, max: number) =>
  Math.min(max, Math.max(min, value));

const routeGeometry = (edge: DiagramEdge, index: number) => {
  const fromPosition = layout.nodes[edge.from];
  const toPosition = layout.nodes[edge.to];
  if (!fromPosition || !toPosition) {
    throw new Error(
      `Missing node position for ${String(name)} edge ${edge.from} -> ${edge.to}`,
    );
  }

  const from = { x: fromPosition.x, y: fromPosition.y };
  const to = { x: toPosition.x, y: toPosition.y };
  const fromWidth = fromPosition.width ?? 190;
  const fromHeight = fromPosition.height ?? 96;
  const toWidth = toPosition.width ?? 190;
  const toHeight = toPosition.height ?? 96;

  if (edge.from === edge.to) {
    const start = {
      x: from.x + fromWidth * 0.28,
      y: from.y - fromHeight / 2,
    };
    const end = {
      x: from.x - fromWidth * 0.28,
      y: from.y - fromHeight / 2,
    };
    const top = from.y - fromHeight / 2 - Math.max(82, fromHeight * 0.92);
    return {
      path: `M ${start.x} ${start.y} C ${start.x + 82} ${top}, ${end.x - 82} ${top}, ${end.x} ${end.y}`,
      label: {
        x: clamp(from.x, 110, layout.width - 110),
        y: clamp(top - 24, 30, layout.height - 30),
      },
    };
  }

  const group = edgeGroups.get(edgePairKey(edge)) ?? [index];
  const positionInGroup = group.indexOf(index);
  const offset = (positionInGroup - (group.length - 1) / 2) * 58;
  const [stableFromId, stableToId] = [edge.from, edge.to].sort();
  const stableFrom = layout.nodes[stableFromId];
  const stableTo = layout.nodes[stableToId];
  const stableDx = stableTo.x - stableFrom.x;
  const stableDy = stableTo.y - stableFrom.y;
  const stableLength = Math.hypot(stableDx, stableDy) || 1;
  const perpendicular = {
    x: -stableDy / stableLength,
    y: stableDx / stableLength,
  };
  const control = {
    x: (from.x + to.x) / 2 + perpendicular.x * offset,
    y: (from.y + to.y) / 2 + perpendicular.y * offset,
  };
  const start = boxEdge(
    from,
    offset === 0 ? to : control,
    fromWidth,
    fromHeight,
  );
  const end = boxEdge(to, offset === 0 ? from : control, toWidth, toHeight);
  const midpoint =
    offset === 0
      ? { x: (start.x + end.x) / 2, y: (start.y + end.y) / 2 }
      : quadraticPoint(start, control, end, 0.5);
  const mostlyVertical =
    Math.abs(end.y - start.y) > Math.abs(end.x - start.x) * 0.8;

  return {
    path:
      offset === 0
        ? `M ${start.x} ${start.y} L ${end.x} ${end.y}`
        : `M ${start.x} ${start.y} Q ${control.x} ${control.y} ${end.x} ${end.y}`,
    label: {
      x: clamp(midpoint.x + (mostlyVertical ? 96 : 0), 110, layout.width - 110),
      y: clamp(midpoint.y + (mostlyVertical ? 0 : -27), 30, layout.height - 30),
    },
  };
};

const routes = diagram.edges.map((edge, index) => ({
  edge,
  index,
  ...routeGeometry(edge, index),
}));
const stageMinWidth = Math.max(760, Math.round(layout.width * 0.76));
---

<figure
  class="concept-diagram"
  data-diagram={name}
  data-flow-mode={layout.mode}
  data-has-regions={String(hasRegions)}
>
  <figcaption>
    <span class="diagram-eyebrow">{modeLabels[layout.mode]}</span>
    <Heading>{diagram.title}</Heading>
    <p>{diagram.description}</p>
    <p class="diagram-reading">{ui.reading}</p>
    {diagram.conceptual && <p class="concept-note">{ui.conceptual}</p>}
  </figcaption>

  <div
    class="diagram-legend"
    aria-label={isJapanese ? "図の読み方" : "Diagram key"}
  >
    {hasRegions && <span>{ui.legendRegion}</span>}
    <span>{ui.legendNode}</span>
    <span>{ui.legendArrow}</span>
    <span class="legend-stop">{ui.legendStop}</span>
  </div>

  <div
    class="flow-map-scroll"
    tabindex="0"
    role="region"
    aria-label={ui.mapLabel}
  >
    <div
      class="flow-map-stage"
      style={`--flow-min-width:${stageMinWidth}px;--flow-aspect:${layout.width}/${layout.height};`}
      aria-hidden="true"
    >
      {
        layout.regions?.map((region) => (
          <section
            class:list={["flow-region", `region-${region.kind}`]}
            style={`--region-x:${(region.x / layout.width) * 100}%;--region-y:${(region.y / layout.height) * 100}%;--region-width:${(region.width / layout.width) * 100}%;--region-height:${(region.height / layout.height) * 100}%;`}
          >
            <span>{regionLabel(region)}</span>
          </section>
        ))
      }

      <svg
        viewBox={`0 0 ${layout.width} ${layout.height}`}
        preserveAspectRatio="none"
      >
        <defs>
          <marker
            id={arrowMarker}
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto-start-reverse"
          >
            <path d="M 0 0 L 10 5 L 0 10 z"></path>
          </marker>
          <marker
            id={blockedMarker}
            viewBox="0 0 12 12"
            refX="8"
            refY="6"
            markerWidth="8"
            markerHeight="8"
            orient="auto"
          >
            <path d="M 3 1 L 3 11 M 7 1 L 7 11"></path>
          </marker>
        </defs>
        {
          routes.map(({ edge, path }) => (
            <path
              class:list={[
                "flow-route",
                `kind-${edge.kind}`,
                edge.style && `route-${edge.style}`,
              ]}
              d={path}
              marker-end={`url(#${edge.style === "blocked" ? blockedMarker : arrowMarker})`}
            />
          ))
        }
      </svg>

      {
        routes.map(({ edge, label, index }) => (
          <span
            class:list={[
              "route-label",
              `kind-${edge.kind}`,
              edge.style && `route-${edge.style}`,
            ]}
            style={`--route-x:${(label.x / layout.width) * 100}%;--route-y:${(label.y / layout.height) * 100}%;`}
          >
            <strong>{String(index + 1).padStart(2, "0")}</strong>
            <span>{edge.label}</span>
          </span>
        ))
      }

      {
        diagram.nodes.map((node) => {
          const position = layout.nodes[node.id];
          if (!position) return null;
          const region = regionForNode(node.id);
          return (
            <article
              class:list={[
                "flow-node",
                `kind-${node.kind}`,
                `shape-${node.shape || "box"}`,
              ]}
              data-node={node.id}
              style={`--node-x:${(position.x / layout.width) * 100}%;--node-y:${(position.y / layout.height) * 100}%;--node-width:${((position.width ?? 190) / layout.width) * 100}%;`}
            >
              {region && (
                <span class="node-region">
                  {ui.location} · {regionLabel(region)}
                </span>
              )}
              <span class="node-kind">{kindLabels[node.kind]}</span>
              <h3>{node.label}</h3>
              <p>{node.detail}</p>
            </article>
          );
        })
      }
    </div>
  </div>

  <section class="flow-step-section" aria-label={ui.steps}>
    <h3>{ui.steps}</h3>
    <ol class="flow-step-list">
      {
        diagram.edges.map((edge, index) => (
          <li
            class:list={[
              `kind-${edge.kind}`,
              edge.style && `route-${edge.style}`,
            ]}
          >
            <span class="step-number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <strong>
                {nodeById[edge.from]?.label ?? edge.from}
                <span aria-hidden="true">
                  {edge.style === "blocked" ? " ⊣ " : " → "}
                </span>
                {nodeById[edge.to]?.label ?? edge.to}
              </strong>
              <p>{edge.label}</p>
            </div>
            <span class="step-kind">
              {edge.style === "blocked" ? ui.blocked : kindLabels[edge.kind]}
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</figure>

<style>
  .concept-diagram {
    margin: 2rem 0;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
  }
  .concept-diagram figcaption {
    padding: clamp(1rem, 3vw, 1.35rem);
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  .diagram-eyebrow {
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .concept-diagram figcaption h2,
  .concept-diagram figcaption h3 {
    margin: 0.25rem 0 0.35rem;
  }
  .concept-diagram figcaption > p {
    max-width: 65rem;
    margin: 0.3rem 0 0;
    color: var(--sl-color-gray-2);
  }
  .diagram-reading {
    font-size: var(--sl-text-sm);
  }
  .concept-note {
    font-size: var(--sl-text-xs);
  }
  .diagram-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.2rem;
    padding: 0.7rem clamp(1rem, 3vw, 1.35rem);
    border-block-end: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.64rem;
  }
  .diagram-legend span::before {
    content: "•";
    margin-inline-end: 0.35rem;
    color: var(--tobari-control);
  }
  .diagram-legend .legend-stop::before {
    color: var(--tobari-denied);
  }
  .flow-map-scroll {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }
  .flow-map-stage {
    position: relative;
    width: 100%;
    min-width: var(--flow-min-width);
    aspect-ratio: var(--flow-aspect);
    overflow: hidden;
    background-image:
      linear-gradient(var(--sl-color-gray-6) 1px, transparent 1px),
      linear-gradient(90deg, var(--sl-color-gray-6) 1px, transparent 1px);
    background-size: 2rem 2rem;
  }
  .flow-region {
    position: absolute;
    z-index: 0;
    left: var(--region-x);
    top: var(--region-y);
    width: var(--region-width);
    height: var(--region-height);
    border: 1px dashed var(--sl-color-gray-4);
    background: color-mix(in srgb, var(--sl-color-gray-6) 62%, transparent);
  }
  .flow-region > span {
    position: absolute;
    top: 0.45rem;
    left: 0.55rem;
    max-width: calc(100% - 1.1rem);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-transform: uppercase;
  }
  .flow-region.region-workspace {
    border-color: color-mix(
      in srgb,
      var(--tobari-network) 55%,
      var(--sl-color-gray-4)
    );
    background: color-mix(in srgb, var(--tobari-network) 4%, transparent);
  }
  .flow-region.region-host,
  .flow-region.region-installation {
    border-color: color-mix(
      in srgb,
      var(--tobari-trusted) 55%,
      var(--sl-color-gray-4)
    );
    background: color-mix(in srgb, var(--tobari-trusted) 4%, transparent);
  }
  .flow-region.region-cluster,
  .flow-region.region-runtime {
    border-color: color-mix(
      in srgb,
      var(--tobari-diagnostic) 60%,
      var(--sl-color-gray-4)
    );
    background: color-mix(in srgb, var(--tobari-diagnostic) 4%, transparent);
  }
  .flow-region.region-external {
    border-color: color-mix(
      in srgb,
      var(--tobari-untrusted) 55%,
      var(--sl-color-gray-4)
    );
  }
  .flow-region.region-source,
  .flow-region.region-logical,
  .flow-region.region-pipeline {
    border-color: color-mix(
      in srgb,
      var(--tobari-persistent) 55%,
      var(--sl-color-gray-4)
    );
    background: color-mix(in srgb, var(--tobari-persistent) 4%, transparent);
  }
  .flow-map-stage svg {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .flow-map-stage marker path {
    fill: context-stroke;
    stroke: context-stroke;
    stroke-width: 1.5;
  }
  .flow-route {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.35;
    color: var(--sl-color-gray-3);
    vector-effect: non-scaling-stroke;
  }
  .flow-route.route-dashed {
    stroke-dasharray: 8 6;
  }
  .flow-route.route-blocked {
    stroke-dasharray: 4 5;
    stroke-width: 3;
  }
  .route-label {
    position: absolute;
    z-index: 3;
    left: var(--route-x);
    top: var(--route-y);
    display: inline-flex;
    width: max-content;
    max-width: 13rem;
    gap: 0.35rem;
    align-items: center;
    transform: translate(-50%, -50%);
    padding: 0.22rem 0.4rem;
    border: 1px solid
      color-mix(in srgb, currentColor 45%, var(--sl-color-gray-5));
    background: color-mix(in srgb, var(--sl-color-bg) 94%, transparent);
    color: var(--sl-color-gray-2);
    font-size: 0.6rem;
    line-height: 1.25;
    text-align: center;
    pointer-events: none;
  }
  .route-label > strong {
    display: grid;
    flex: 0 0 auto;
    width: 1.45rem;
    height: 1.45rem;
    place-items: center;
    border-radius: 50%;
    background: var(--sl-color-gray-6);
    color: currentColor;
    font-family: var(--sl-font-mono);
    font-size: 0.54rem;
  }
  .route-label > span {
    display: -webkit-box;
    overflow: hidden;
    color: var(--sl-color-gray-2);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .route-label.route-blocked {
    color: var(--tobari-denied);
  }
  .flow-node {
    position: absolute;
    z-index: 4;
    left: var(--node-x);
    top: var(--node-y);
    width: min(var(--node-width), 13.5rem);
    min-height: 6rem;
    margin: 0;
    padding: 0.72rem 0.8rem;
    transform: translate(-50%, -50%);
    border: 1.5px solid currentColor;
    background: var(--sl-color-bg);
    box-shadow: 0 0 0 0.24rem var(--sl-color-bg);
  }
  .flow-node.kind-untrusted,
  .flow-node.kind-diagnostic,
  .flow-node.shape-boundary {
    border-style: dashed;
  }
  .flow-node.kind-secret,
  .flow-node.kind-persistent,
  .flow-node.shape-store {
    border-block-start-style: double;
    border-block-start-width: 4px;
  }
  .flow-node > span {
    display: block;
    font-family: var(--sl-font-mono);
    font-size: 0.56rem;
    font-weight: 800;
    line-height: 1.25;
  }
  .flow-node .node-region {
    margin: -0.1rem 0 0.35rem;
    padding-bottom: 0.32rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
  }
  .flow-node .node-kind {
    color: inherit;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .flow-node h3 {
    margin: 0.25rem 0 0;
    color: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1.25;
  }
  .flow-node p {
    display: -webkit-box;
    margin: 0.3rem 0 0;
    overflow: hidden;
    color: var(--sl-color-gray-2);
    font-size: 0.68rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .flow-step-section {
    padding: 1rem clamp(1rem, 3vw, 1.35rem) 1.25rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
  }
  .flow-step-section > h3 {
    margin: 0 0 0.7rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .flow-step-list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow-step-list li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: start;
    min-width: 0;
    padding: 0.65rem 0.75rem;
    border-inline-start: 0.24rem solid currentColor;
    background: var(--sl-color-gray-6);
  }
  .flow-step-list li.route-dashed {
    border-inline-start-style: dashed;
  }
  .flow-step-list li.route-blocked {
    border-inline-start-style: double;
  }
  .step-number {
    color: inherit;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 850;
  }
  .flow-step-list strong {
    display: block;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .flow-step-list p {
