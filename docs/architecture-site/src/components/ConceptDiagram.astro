---
import { diagramLayouts } from "../data/diagramLayouts";
import { diagrams, type DiagramEdge, type DiagramKind } from "../data/diagrams";
import { diagramsJa } from "../data/diagrams.ja";

interface Props {
  name: keyof typeof diagrams;
  headingLevel?: 2 | 3;
}

interface Point {
  x: number;
  y: number;
}

const { name, headingLevel = 2 } = Astro.props;
const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const localizedDiagrams = isJapanese ? diagramsJa : diagrams;
const diagram = localizedDiagrams[name];
const layout = diagramLayouts[name];
if (!diagram) throw new Error(`Unknown Tobari diagram: ${String(name)}`);
if (!layout) throw new Error(`Missing Tobari diagram layout: ${String(name)}`);
const Heading = `h${headingLevel}` as "h2" | "h3";
const markerKey = String(name).replace(/[^a-z0-9_-]/gi, "-");
const arrowMarker = `flow-arrow-${markerKey}`;
const blockedMarker = `flow-blocked-${markerKey}`;

const kindLabels: Record<DiagramKind, string> = isJapanese
  ? {
      trusted: "ホストが管理",
      untrusted: "信頼しない入力",
      control: "判断・制御",
      network: "通信",
      persistent: "永続状態",
      secret: "秘密情報",
      handle: "不透明なハンドル",
      allowed: "許可後",
      denied: "拒否",
      diagnostic: "確認・診断",
    }
  : {
      trusted: "Host-owned",
      untrusted: "Untrusted input",
      control: "Decision / control",
      network: "Network",
      persistent: "Persistent state",
      secret: "Secret material",
      handle: "Opaque handle",
      allowed: "After allow",
      denied: "Denied",
      diagnostic: "Review / diagnostic",
    };
const modeLabels = isJapanese
  ? {
      sequence: "処理の順序",
      relationship: "関係を読む順序",
      state: "状態の遷移",
    }
  : {
      sequence: "Processing order",
      relationship: "Relationship order",
      state: "State transitions",
    };
const ui = isJapanese
  ? {
      reading:
        "箱の分類ではなく、番号付きの矢印を追って、何がどこへ移動するかを確認します。",
      steps: "番号順に読む",
      blocked: "ここで停止",
      conceptual: "この図は理解のために経路を単純化しています。",
    }
  : {
      reading:
        "Follow the numbered arrows to see what moves where; the boxes only anchor each component or state.",
      steps: "Read in number order",
      blocked: "stops here",
      conceptual: "This view simplifies the route for explanation.",
    };

const nodeById = Object.fromEntries(
  diagram.nodes.map((node) => [node.id, node]),
);

const edgePairKey = (edge: DiagramEdge) =>
  edge.from === edge.to
    ? `self:${edge.from}`
    : [edge.from, edge.to].sort().join("|");
const edgeGroups = new Map<string, number[]>();
diagram.edges.forEach((edge, index) => {
  const key = edgePairKey(edge);
  edgeGroups.set(key, [...(edgeGroups.get(key) ?? []), index]);
});

const intersectBox = (
  center: Point,
  target: Point,
  width: number,
  height: number,
): Point => {
  const dx = target.x - center.x;
  const dy = target.y - center.y;
  const length = Math.hypot(dx, dy) || 1;
  const ux = dx / length;
  const uy = dy / length;
  const scale =
    1 / Math.max(Math.abs(ux) / (width / 2), Math.abs(uy) / (height / 2));
  return { x: center.x + ux * scale, y: center.y + uy * scale };
};

const quadraticPoint = (
  start: Point,
  control: Point,
  end: Point,
  t: number,
): Point => {
  const inverse = 1 - t;
  return {
    x:
      inverse * inverse * start.x + 2 * inverse * t * control.x + t * t * end.x,
    y:
      inverse * inverse * start.y + 2 * inverse * t * control.y + t * t * end.y,
  };
};

const routeGeometry = (edge: DiagramEdge, index: number) => {
  const fromPosition = layout.nodes[edge.from];
  const toPosition = layout.nodes[edge.to];
  if (!fromPosition || !toPosition) {
    throw new Error(
      `Missing node position for ${String(name)} edge ${edge.from} -> ${edge.to}`,
    );
  }
  const fromCenter = { x: fromPosition.x, y: fromPosition.y };
  const toCenter = { x: toPosition.x, y: toPosition.y };
  const fromWidth = fromPosition.width ?? 190;
  const fromHeight = fromPosition.height ?? 96;
  const toWidth = toPosition.width ?? 190;
  const toHeight = toPosition.height ?? 96;

  if (edge.from === edge.to) {
    const loopWidth = Math.max(72, fromWidth * 0.45);
    const loopHeight = Math.max(82, fromHeight * 0.92);
    const start = {
      x: fromCenter.x + fromWidth * 0.28,
      y: fromCenter.y - fromHeight / 2,
    };
    const end = {
      x: fromCenter.x - fromWidth * 0.28,
      y: fromCenter.y - fromHeight / 2,
    };
    const top = fromCenter.y - fromHeight / 2 - loopHeight;
    return {
      path: `M ${start.x} ${start.y} C ${start.x + loopWidth} ${top}, ${end.x - loopWidth} ${top}, ${end.x} ${end.y}`,
      marker: { x: fromCenter.x, y: top + 9 },
    };
  }

  const group = edgeGroups.get(edgePairKey(edge)) ?? [index];
  const positionInGroup = group.indexOf(index);
  const curveOffset = (positionInGroup - (group.length - 1) / 2) * 58;
  const [stableFromId, stableToId] = [edge.from, edge.to].sort();
  const stableFrom = layout.nodes[stableFromId];
  const stableTo = layout.nodes[stableToId];
  const stableDx = stableTo.x - stableFrom.x;
  const stableDy = stableTo.y - stableFrom.y;
  const stableLength = Math.hypot(stableDx, stableDy) || 1;
  const perpendicular = {
    x: -stableDy / stableLength,
    y: stableDx / stableLength,
  };
  const control = {
    x: (fromCenter.x + toCenter.x) / 2 + perpendicular.x * curveOffset,
    y: (fromCenter.y + toCenter.y) / 2 + perpendicular.y * curveOffset,
  };
  const startTarget = curveOffset === 0 ? toCenter : control;
  const endTarget = curveOffset === 0 ? fromCenter : control;
  const start = intersectBox(fromCenter, startTarget, fromWidth, fromHeight);
  const end = intersectBox(toCenter, endTarget, toWidth, toHeight);
  const marker =
    curveOffset === 0
      ? { x: (start.x + end.x) / 2, y: (start.y + end.y) / 2 }
      : quadraticPoint(start, control, end, 0.5);
  return {
    path:
      curveOffset === 0
        ? `M ${start.x} ${start.y} L ${end.x} ${end.y}`
        : `M ${start.x} ${start.y} Q ${control.x} ${control.y} ${end.x} ${end.y}`,
    marker,
  };
};

const routes = diagram.edges.map((edge, index) => ({
  edge,
  index,
  ...routeGeometry(edge, index),
}));
const stageMinWidth = Math.max(720, Math.round(layout.width * 0.72));
---

<figure
  class="concept-diagram"
  data-diagram={name}
  data-flow-mode={layout.mode}
>
  <figcaption>
    <span class="diagram-eyebrow">{modeLabels[layout.mode]}</span>
    <Heading>{diagram.title}</Heading>
    <p>{diagram.description}</p>
    <p class="diagram-reading">{ui.reading}</p>
    {diagram.conceptual && <p class="concept-note">{ui.conceptual}</p>}
  </figcaption>

  <div class="flow-map-scroll" tabindex="0">
    <div
      class="flow-map-stage"
      style={`--flow-min-width:${stageMinWidth}px;--flow-aspect:${layout.width}/${layout.height};`}
      aria-hidden="true"
    >
      <svg
        viewBox={`0 0 ${layout.width} ${layout.height}`}
        preserveAspectRatio="none"
      >
        <defs>
          <marker
            id={arrowMarker}
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto-start-reverse"
          >
            <path d="M 0 0 L 10 5 L 0 10 z"></path>
          </marker>
          <marker
            id={blockedMarker}
            viewBox="0 0 12 12"
            refX="8"
            refY="6"
            markerWidth="8"
            markerHeight="8"
            orient="auto"
          >
            <path d="M 3 1 L 3 11 M 7 1 L 7 11"></path>
          </marker>
        </defs>
        {
          routes.map(({ edge, path, marker, index }) => (
            <g
              class:list={[
                "flow-route",
                `kind-${edge.kind}`,
                edge.style && `route-${edge.style}`,
              ]}
            >
              <path
                d={path}
                marker-end={`url(#${edge.style === "blocked" ? blockedMarker : arrowMarker})`}
              />
              <g
                class="route-number"
                transform={`translate(${marker.x} ${marker.y})`}
              >
                <circle r="17" />
                <text text-anchor="middle" dominant-baseline="central">
                  {index + 1}
                </text>
              </g>
            </g>
          ))
        }
      </svg>

      {
        diagram.nodes.map((node) => {
          const position = layout.nodes[node.id];
          if (!position) return null;
          return (
            <article
              class:list={[
                "flow-node",
                `kind-${node.kind}`,
                `shape-${node.shape || "box"}`,
              ]}
              data-node={node.id}
              style={`--node-x:${(position.x / layout.width) * 100}%;--node-y:${(position.y / layout.height) * 100}%;--node-width:${((position.width ?? 190) / layout.width) * 100}%;`}
            >
              <span>{kindLabels[node.kind]}</span>
              <h3>{node.label}</h3>
              <p>{node.detail}</p>
            </article>
          );
        })
      }
    </div>
  </div>

  <section class="flow-step-section" aria-label={ui.steps}>
    <h3>{ui.steps}</h3>
    <ol class="flow-step-list">
      {
        diagram.edges.map((edge, index) => (
          <li
            class:list={[
              `kind-${edge.kind}`,
              edge.style && `route-${edge.style}`,
            ]}
          >
            <span class="step-number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <strong>
                {nodeById[edge.from]?.label ?? edge.from}
                <span aria-hidden="true">
                  {edge.style === "blocked" ? " ⊣ " : " → "}
                </span>
                {nodeById[edge.to]?.label ?? edge.to}
              </strong>
              <p>{edge.label}</p>
            </div>
            <span class="step-kind">
              {edge.style === "blocked" ? ui.blocked : kindLabels[edge.kind]}
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</figure>

<style>
  .concept-diagram {
    margin: 2rem 0;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
  }
  .concept-diagram figcaption {
    padding: clamp(1rem, 3vw, 1.35rem);
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  .diagram-eyebrow {
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .concept-diagram figcaption h2,
  .concept-diagram figcaption h3 {
    margin: 0.25rem 0 0.35rem;
  }
  .concept-diagram figcaption > p {
    max-width: 65rem;
    margin: 0.3rem 0 0;
    color: var(--sl-color-gray-2);
  }
  .diagram-reading {
    font-size: var(--sl-text-sm);
  }
  .concept-note {
    font-size: var(--sl-text-xs);
  }
  .flow-map-scroll {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }
  .flow-map-stage {
    position: relative;
    width: 100%;
    min-width: var(--flow-min-width);
    aspect-ratio: var(--flow-aspect);
    overflow: hidden;
    background-image:
      linear-gradient(var(--sl-color-gray-6) 1px, transparent 1px),
      linear-gradient(90deg, var(--sl-color-gray-6) 1px, transparent 1px);
    background-size: 2rem 2rem;
  }
  .flow-map-stage svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .flow-map-stage marker path {
    fill: context-stroke;
    stroke: context-stroke;
    stroke-width: 1.5;
  }
  .flow-route {
    color: var(--sl-color-gray-3);
  }
  .flow-route > path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.35;
    vector-effect: non-scaling-stroke;
  }
  .flow-route.route-dashed > path {
    stroke-dasharray: 8 6;
  }
  .flow-route.route-blocked > path {
    stroke-dasharray: 4 5;
    stroke-width: 3;
  }
  .route-number circle {
    fill: var(--sl-color-bg);
    stroke: currentColor;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .route-number text {
    fill: currentColor;
    font-family: var(--sl-font-mono);
    font-size: 14px;
    font-weight: 850;
  }
  .flow-node {
    position: absolute;
    z-index: 2;
    left: var(--node-x);
    top: var(--node-y);
    width: min(var(--node-width), 13.5rem);
    min-height: 6rem;
    margin: 0;
    padding: 0.75rem 0.8rem;
    transform: translate(-50%, -50%);
    border: 1.5px solid currentColor;
    background: var(--sl-color-bg);
    box-shadow: 0 0 0 0.28rem var(--sl-color-bg);
  }
  .flow-node.kind-untrusted,
  .flow-node.kind-handle,
  .flow-node.kind-diagnostic,
  .flow-node.shape-boundary {
    border-style: dashed;
  }
  .flow-node.kind-secret,
  .flow-node.kind-persistent,
  .flow-node.shape-store {
    border-block-start-style: double;
    border-block-start-width: 4px;
  }
  .flow-node > span {
    display: inline-block;
    color: inherit;
    font-family: var(--sl-font-mono);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .flow-node h3 {
    margin: 0.25rem 0 0;
    color: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1.25;
  }
  .flow-node p {
    display: -webkit-box;
    margin: 0.3rem 0 0;
    overflow: hidden;
    color: var(--sl-color-gray-2);
    font-size: 0.68rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .flow-step-section {
    padding: 1rem clamp(1rem, 3vw, 1.35rem) 1.25rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
  }
  .flow-step-section > h3 {
    margin: 0 0 0.7rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .flow-step-list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow-step-list li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: start;
    min-width: 0;
    padding: 0.65rem 0.75rem;
    border-inline-start: 0.24rem solid currentColor;
    background: var(--sl-color-gray-6);
  }
  .flow-step-list li.route-dashed {
    border-inline-start-style: dashed;
  }
  .flow-step-list li.route-blocked {
    border-inline-start-style: double;
  }
  .step-number {
    color: inherit;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 850;
  }
  .flow-step-list strong {
    display: block;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .flow-step-list p {
    margin: 0.16rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .step-kind {
    align-self: center;
    color: inherit;
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    text-align: end;
    text-transform: uppercase;
  }
  .kind-trusted {
    color: var(--tobari-trusted);
  }
  .kind-untrusted {
    color: var(--tobari-untrusted);
  }
  .kind-control {
    color: var(--tobari-control);
  }
  .kind-network {
    color: var(--tobari-network);
  }
  .kind-persistent {
    color: var(--tobari-persistent);
  }
  .kind-secret {
    color: var(--tobari-secret);
  }
  .kind-handle {
    color: var(--tobari-handle);
  }
  .kind-allowed {
    color: var(--tobari-allowed);
  }
  .kind-denied {
    color: var(--tobari-denied);
  }
  .kind-diagnostic {
    color: var(--tobari-diagnostic);
  }
  @media (max-width: 42rem) {
    .flow-step-list li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }
    .step-kind {
      grid-column: 2;
      justify-self: start;
      margin-top: 0.1rem;
      text-align: start;
    }
  }
  @media print {
    .concept-diagram,
    .flow-node,
    .flow-step-list li {
      color: #000 !important;
      border-color: #000 !important;
      background: transparent !important;
      box-shadow: none;
    }
    .flow-map-stage {
      min-width: 0;
      background: transparent;
    }
    .flow-route {
      color: #000 !important;
    }
  }
</style>
