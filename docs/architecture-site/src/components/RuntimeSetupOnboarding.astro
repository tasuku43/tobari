---
const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const t = <T,>(english: T, japanese: T) => (isJapanese ? japanese : english);
const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}${isJapanese ? "ja/" : ""}${path.replace(/^\//, "")}`;

const steps = t(
  [
    {
      title: "Create the managed Dockerfile",
      command: `tobari runtime init`,
      expected:
        "Tobari creates the runtime Dockerfile and reports its path. Nothing is built or switched yet.",
      note:
        "If the recipe already exists, keep and edit that file instead of initializing it again. The detailed runtime guide covers recovery when you no longer know the managed path.",
    },
    {
      title: "Add the coding agent and project tools",
      command: `<editor> <Dockerfile path printed by Tobari>`,
      expected:
        "Keep the generated base, entrypoint, and final `USER tobari`. Add installation commands between `USER root` and `USER tobari`.",
      note:
        "Pin versions where practical. Do not put tokens, cloud credentials, host credential files, or private package-manager configuration into the image.",
    },
    {
      title: "Build and validate the runtime",
      command: `tobari runtime build`,
      expected:
        "Tobari builds the image and checks the runtime interface. A compatible successful build is used on the next Workspace entry; a failed build leaves the previous runtime in place.",
      note:
        "The build runs on the host. Downloads performed by the Dockerfile do not pass through Workspace policy review, so review the base image and download sources.",
    },
    {
      title: "Enter a real project and verify the agent",
      command: `cd /path/to/your/project\ntobari\n\n# Inside the Workspace\ncommand -v <agent-command>\n<agent-command> --version`,
      expected:
        "The agent executable and project toolchain are available inside the Workspace. If the runtime changed, an existing Workspace may replace only its work container during entry.",
      note:
        "Installing the executable does not authenticate it and does not grant outbound network permission. Configure authentication next.",
    },
  ],
  [
    {
      title: "ランタイム用の Dockerfile を作る",
      command: `tobari runtime init`,
      expected:
        "Tobari がランタイム用 Dockerfile を作り、そのパスを表示します。この時点では、まだビルドも切り替えも行いません。",
      note:
        "すでに Dockerfile がある場合は、再初期化せず既存のファイルを編集します。管理対象のパスが分からなくなった場合の確認方法は、ランタイムの詳細設定で扱います。",
    },
    {
      title: "エージェントと開発ツールを追加する",
      command: `<エディタ> <Tobari が表示した Dockerfile のパス>`,
      expected:
        "生成済みのベース、エントリーポイント、最後の `USER tobari` を維持し、`USER root` と `USER tobari` の間にインストール処理を追加します。",
      note:
        "可能な範囲でバージョンを固定します。トークン、クラウド認証情報、ホスト側の認証ファイル、非公開のパッケージ設定はイメージへ入れません。",
    },
    {
      title: "ランタイムをビルドして検査する",
      command: `tobari runtime build`,
      expected:
        "Tobari がイメージをビルドし、ランタイムとして必要なインターフェースを検査します。互換性のあるビルドに成功した場合だけ、次の Workspace 入室で新しいランタイムが使われます。失敗した場合は、それまでのランタイムが変わりません。",
      note:
        "ビルドはホスト上で実行されます。Dockerfile がビルド中に行うダウンロードは Workspace のポリシーレビューを通らないため、ベースイメージと取得元を確認します。",
    },
    {
      title: "実際のプロジェクトへ入り、エージェントを確認する",
      command: `cd /path/to/your/project\ntobari\n\n# Workspace 内\ncommand -v <エージェントのコマンド>\n<エージェントのコマンド> --version`,
      expected:
        "Workspace 内でエージェントと必要な開発ツールを利用できます。ランタイムが変わった既存 Workspace では、入室時に作業コンテナだけを置き換えることがあります。",
      note:
        "実行ファイルを追加しても認証は完了せず、外部通信の許可も増えません。次に認証を設定します。",
    },
  ],
);

const flow = t(
  [
    "Create Dockerfile",
    "Add agent and tools",
    "Build and validate",
    "Enter project",
    "Verify agent",
  ],
  [
    "Dockerfile を作る",
    "エージェントとツールを追加",
    "ビルドして検査",
    "プロジェクトへ入る",
    "エージェントを確認",
  ],
);

const dockerfileExample = `# Keep the generated FROM line.\n\nUSER root\n\nRUN apt-get update \\\n    && apt-get install -y --no-install-recommends \\\n       nodejs npm ripgrep \\\n    && rm -rf /var/lib/apt/lists/*\n\n# Install your coding agent using its official method.\n# RUN ...\n\nUSER tobari`;
---

<div class="runtime-onboarding">
  <section class="runtime-core">
    <p class="eyebrow">
      {t("Make the Workspace useful", "実作業できる環境を作る")}
    </p>
    <h2>
      {
        t(
          "Add your coding agent to the minimal base runtime",
          "最小ランタイムに、使いたいエージェントと開発ツールを追加する",
        )
      }
    </h2>
    <p class="lead">
      {
        t(
          "Quickstart deliberately uses only `curl`. The standard base runtime is enough to learn Tobari's network boundary, but it is not a development environment. Keep the default setup for now and build one runtime containing the agent and tools you actually use.",
          "クイックスタートでは意図的に `curl` だけを使いました。標準ベースランタイムは Tobari の通信境界を試すには十分ですが、開発環境ではありません。ここでは初期設定をそのまま使い、利用するエージェントと開発ツールを入れたランタイムを一つ作ります。",
        )
      }
    </p>
    <p class="focus">
      <strong>{t("Learn only this:", "ここで覚えるのはこれだけです：")}</strong>
      {t(
        " Dockerfile → build → Workspace.",
        " Dockerfile を作る → ビルドする → Workspace で使う。",
      )}
    </p>

    <section class="runtime-flow" aria-label={t("Runtime setup flow", "ランタイム導入の流れ")}>
      <ol>
        {flow.map((label, index) => <li><span>{index + 1}</span><strong>{label}</strong></li>)}
      </ol>
    </section>

    <section class="runtime-steps">
      <h3>{t("Build your first usable runtime", "最初の実用ランタイムを作る")}</h3>
      <ol>
        {
          steps.map((step, index) => (
            <li class="runtime-step">
              <header><span>{String(index + 1).padStart(2, "0")}</span><h4>{step.title}</h4></header>
              <pre><code>{step.command}</code></pre>
              <dl>
                <div><dt>{t("Expected", "期待する結果")}</dt><dd>{step.expected}</dd></div>
                <div><dt>{t("Note", "補足")}</dt><dd>{step.note}</dd></div>
              </dl>
            </li>
          ))
        }
      </ol>
    </section>

    <details class="dockerfile-example">
      <summary>{t("Minimal Dockerfile shape", "Dockerfile の最小例")}</summary>
      <p>
        {t(
          "Keep Tobari's generated lines and add only what the selected agent and project need.",
          "Tobari が生成した行を維持し、利用するエージェントとプロジェクトに必要なものだけを追加します。",
        )}
      </p>
      <pre><code>{dockerfileExample}</code></pre>
    </details>

    <aside class="runtime-next">
      <strong>{t("Next: authenticate the tools you installed", "次へ：インストールしたツールの認証を設定する")}</strong>
      <p>
        {t(
          "The executable now exists, but account credentials are still separate. Configure the authentication required by the agent and external services before normal work.",
          "実行ファイルは使えるようになりましたが、アカウントの認証は別です。通常の作業へ進む前に、エージェントや外部サービスに必要な認証を設定します。",
        )}
      </p>
      <a href={withBase("/start/authentication-setup/")}>
        {t("Set up tool authentication", "ツールの認証を設定する")} →
      </a>
    </aside>
  </section>

  <aside class="runtime-advanced">
    <h3>{t("Later, when you need more than one setup", "あとで、設定を使い分けたくなったら")}</h3>
    <p>
      {t(
        "Tobari can group different runtimes, policy modes, and authentication settings into named Contexts. Learn that concept only when you need to switch environments or make one setup stricter.",
        "Tobari では、ランタイム、ポリシーモード、認証設定を Context という単位で分けて切り替えられます。環境を複数に分けたい、用途ごとに権限を厳しくしたい、という必要が出た段階で学べば十分です。",
      )}
    </p>
    <a href={withBase("/guides/contexts/")}>
      {t("Learn Contexts when you need them", "必要になったら Context を学ぶ")} →
    </a>
  </aside>
</div>

<style>
  .runtime-onboarding { display: grid; gap: 2rem; }
  .runtime-core, .runtime-advanced { min-width: 0; }
  .eyebrow { margin: 0 0 .45rem; font-size: .78rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; color: var(--sl-color-text-accent); }
  .runtime-core > h2 { margin: 0; font-size: clamp(1.55rem, 4vw, 2.25rem); line-height: 1.15; }
  .lead { max-width: 48rem; margin-top: 1rem; font-size: 1.04rem; }
  .focus, .runtime-next, .runtime-advanced { border: 1px solid var(--sl-color-gray-5); border-radius: .8rem; padding: 1rem 1.1rem; background: var(--sl-color-bg-nav); }
  .runtime-flow, .runtime-steps, .dockerfile-example, .runtime-next { margin-top: 2rem; }
  .runtime-flow ol { display: grid; grid-template-columns: repeat(5, minmax(9rem, 1fr)); gap: .6rem; padding: 0; list-style: none; overflow-x: auto; }
  .runtime-flow li { min-width: 9rem; border-top: 2px solid var(--sl-color-accent); padding: .8rem; }
  .runtime-flow li span { display: block; margin-bottom: .4rem; font-size: .75rem; color: var(--sl-color-text-accent); }
  .runtime-steps > ol { display: grid; gap: 1rem; padding: 0; list-style: none; }
  .runtime-step { border: 1px solid var(--sl-color-gray-5); border-radius: .8rem; padding: 1rem; }
  .runtime-step header { display: flex; gap: .7rem; align-items: center; }
  .runtime-step header span { font-size: .75rem; font-weight: 800; color: var(--sl-color-text-accent); }
  .runtime-step h4 { margin: 0; }
  .runtime-step pre { margin: .9rem 0; }
  .runtime-step dl, .runtime-step dl > div { display: grid; gap: .3rem; }
  .runtime-step dl { gap: .75rem; margin: 0; }
  .runtime-step dt { font-weight: 750; }
  .runtime-step dd { margin: 0; }
  .dockerfile-example { border-top: 1px solid var(--sl-color-gray-5); padding-top: 1rem; }
  .dockerfile-example summary { cursor: pointer; font-weight: 750; }
  .runtime-next { border-left: 3px solid var(--sl-color-accent); }
  .runtime-next p, .runtime-advanced p { margin: .45rem 0 .7rem; }
  .runtime-advanced { background: transparent; }
  .runtime-advanced h3 { margin: 0; font-size: 1rem; }
  @media (max-width: 42rem) {
    .runtime-flow ol { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: minmax(14rem, 78vw); }
  }
</style>
