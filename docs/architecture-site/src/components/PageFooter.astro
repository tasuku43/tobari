---
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";
import { getLearningPathContext } from "../learning-path.mjs";
import LearningProgress from "./LearningProgress.astro";

const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const labels = isJapanese
  ? {
      heading: "ドキュメントの生成元",
      summary: "このページのソース時点と根拠を確認する",
      builtFrom: "ドキュメントのビルド元",
      productSnapshot: "製品ソースのスナップショット",
      pageStatus: "ページの状態",
      current: "製品スナップショット時点で最新",
      snapshotTime: "ソーススナップショットの時刻",
      pageSource: "ページのソース",
      viewMdx: "この MDX ファイルを見る",
      explanation:
        "製品に関する説明は製品スナップショットに、ページのソースはドキュメントのビルドに固定されています。根拠となる契約、実装、テストは各ページの証拠リンクから確認できます。",
      projectLinks: "プロジェクトリンク",
      contributing: "参加方法",
      securityPolicy: "セキュリティポリシー",
    }
  : {
      heading: "Documentation provenance",
      summary: "Check this page's source snapshot and evidence",
      builtFrom: "Documentation built from",
      productSnapshot: "Product source snapshot",
      pageStatus: "Page status",
      current: "Current at the product snapshot",
      snapshotTime: "Source snapshot time",
      pageSource: "Page source",
      viewMdx: "View this MDX file",
      explanation:
        "Product claims are tied to the product snapshot; page source is tied to the documentation build. Follow each page’s evidence links for the governing contract, implementation, and tests.",
      projectLinks: "Project links",
      contributing: "Contributing",
      securityPolicy: "Security policy",
    };
const productCommit = __TOBARI_DOCS_COMMIT__;
const buildCommit = __TOBARI_DOCS_BUILD_COMMIT__;
const shortProductCommit = productCommit.slice(0, 12);
const shortBuildCommit = buildCommit.slice(0, 12);
const repository = __TOBARI_DOCS_REPOSITORY__;
const sourcePath = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, "/")
  .replace(/^\/+|\/+$/g, "");
const contentPath = sourcePath
  ? `${sourcePath}${sourcePath === "ja" ? "/index" : ""}.mdx`
  : "index.mdx";
const sourceUrl = `${repository}/blob/${buildCommit}/docs/architecture-site/src/content/docs/${contentPath}`;
const generatedAt = new Date(__TOBARI_DOCS_GENERATED_AT__).toLocaleString(
  isJapanese ? "ja-JP" : "en",
  {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "UTC",
  },
);
const learningContext = getLearningPathContext(
  Astro.url.pathname,
  import.meta.env.BASE_URL,
);
---

<footer class="page-footer sl-flex">
  <LearningProgress />
  {!learningContext && <Pagination />}
  <details class="provenance">
    <summary>
      <span>{labels.heading}</span>
      <small>{labels.summary}</small>
    </summary>
    <div class="provenance-body">
      <dl>
        <div>
          <dt>{labels.builtFrom}</dt><dd>
            <a href={`${repository}/commit/${buildCommit}`}
              ><code>{shortBuildCommit}</code></a
            >
          </dd>
        </div>
        <div>
          <dt>{labels.productSnapshot}</dt><dd>
            <a href={`${repository}/commit/${productCommit}`}
              ><code>{shortProductCommit}</code></a
            >
          </dd>
        </div>
        <div><dt>{labels.pageStatus}</dt><dd>{labels.current}</dd></div>
        <div><dt>{labels.snapshotTime}</dt><dd>{generatedAt} UTC</dd></div>
        <div>
          <dt>{labels.pageSource}</dt><dd>
            <a href={sourceUrl}>{labels.viewMdx}</a>
          </dd>
        </div>
      </dl>
      <p>{labels.explanation}</p>
    </div>
  </details>
  <div class="meta sl-flex"><EditLink /><LastUpdated /></div>
  <nav class="project-links" aria-label={labels.projectLinks}>
    <a href={repository}>GitHub</a>
    <a href={`${repository}/blob/${buildCommit}/CONTRIBUTING.md`}
      >{labels.contributing}</a
    >
    <a href={`${repository}/blob/${buildCommit}/SECURITY.md`}
      >{labels.securityPolicy}</a
    >
  </nav>
</footer>

<style>
  @layer starlight.core {
    .page-footer {
      flex-direction: column;
      gap: 1.5rem;
    }
    .provenance {
      margin-top: 1rem;
      border: 1px solid var(--sl-color-gray-5);
      font-size: var(--sl-text-sm);
    }
    .provenance summary {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1rem;
      cursor: pointer;
      list-style-position: inside;
    }
    .provenance summary span {
      font-weight: 750;
    }
    .provenance summary small {
      color: var(--sl-color-gray-3);
      text-align: end;
    }
    .provenance-body {
      padding: 0 1rem 1rem;
      border-block-start: 1px solid var(--sl-color-gray-5);
    }
    .provenance dl {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem 1.25rem;
      margin: 1rem 0 0;
    }
    .provenance dl div {
      min-width: 0;
    }
    .provenance dt {
      color: var(--sl-color-gray-3);
      font-weight: 600;
    }
    .provenance dd {
      margin: 0.15rem 0 0;
      overflow-wrap: anywhere;
    }
    .provenance p {
      margin: 0.8rem 0 0;
      color: var(--sl-color-gray-2);
    }
    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .project-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.25rem;
      padding-block: 1rem 2rem;
      font-size: var(--sl-text-sm);
    }
    @media (max-width: 38rem) {
      .provenance summary {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.25rem;
      }
      .provenance summary small {
        text-align: start;
      }
      .provenance dl {
        grid-template-columns: 1fr;
      }
    }
    @media print {
      .provenance {
        break-inside: avoid;
      }
      .provenance summary {
        display: none;
      }
      .provenance-body {
        display: block !important;
        border: 0;
      }
    }
  }
</style>
