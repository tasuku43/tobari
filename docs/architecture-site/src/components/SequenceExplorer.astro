---
import { sequenceScenarios } from "../data/sequences";
import {
  localizeSequenceScenarioJa,
  sequenceActorLabelsJa,
  sequenceTitleJa,
  sequenceUiJa,
} from "../data/sequences.ja";

interface Props {
  scenarios?: string[];
  initial?: string;
  compact?: boolean;
  title?: string;
}

const {
  scenarios: requestedIds,
  initial,
  compact = false,
  title: requestedTitle = "Request sequence explorer",
} = Astro.props;
const isJapanese = Astro.url.pathname.split("/").filter(Boolean).includes("ja");
// Localize the complete registry before filtering so a missing scenario or step
// translation fails the build even when a page renders only a subset.
const localizedScenarios = isJapanese
  ? sequenceScenarios.map(localizeSequenceScenarioJa)
  : sequenceScenarios;
const selected = requestedIds?.length
  ? localizedScenarios.filter((scenario) => requestedIds.includes(scenario.id))
  : localizedScenarios;
const initialId =
  initial && selected.some((scenario) => scenario.id === initial)
    ? initial
    : selected[0]?.id;
const initialScenario =
  selected.find((scenario) => scenario.id === initialId) ?? selected[0];
const serialized = JSON.stringify(selected);
const serializedActorLabels = JSON.stringify(
  isJapanese ? sequenceActorLabelsJa : {},
);
const title = isJapanese
  ? (sequenceTitleJa[requestedTitle] ?? requestedTitle)
  : requestedTitle;
const ui = isJapanese
  ? sequenceUiJa
  : {
      eyebrow: "Interactive sequence",
      introduction:
        "Nothing plays automatically. Choose a scenario, then move through the effect one decision at a time.",
      scenario: "Scenario",
      controlsLabel: "Sequence controls",
      previous: "Previous",
      next: "Next",
      play: "Play",
      pause: "Pause",
      restart: "Restart",
      sharedCluster: "Shared cluster",
      fixedActorMap: "Fixed actor map",
      sent: "Information sent",
      withheld: "Information not sent",
      owner: "Responsible component",
      failure: "If this step fails",
      keyboardHint:
        "Keyboard: focus this explorer and use Left or Right Arrow. Space toggles Play and Pause.",
      staticDisclosure: "Read the complete static transcript",
      staticHeading: "Static sequence descriptions",
      staticIntroduction:
        "These transcripts contain the same information as the controls above and remain available without JavaScript or animation.",
      staticSent: "Sent",
      staticWithheld: "Not sent",
      staticOwner: "Owner",
      staticFailure: "Failure",
    };
const staticActorLabel = (actor: string) =>
  isJapanese ? sequenceActorLabelsJa[actor] : actor;
const stepIndexLabel = isJapanese
  ? "処理の全体順序"
  : "Complete processing order";
const jumpToStepLabel = isJapanese ? "この段階を表示" : "Show this step";
---

<figure class:list={["sequence-explorer", { compact }]}>
  <figcaption>
    <span class="eyebrow">{ui.eyebrow}</span>
    <h2>{title}</h2>
    <p>{ui.introduction}</p>
  </figcaption>

  <tobari-sequence
    data-scenarios={serialized}
    data-initial={initialId}
    data-locale={isJapanese ? "ja" : "en"}
    data-actor-labels={serializedActorLabels}
    tabindex="0"
  >
    <section class="sequence-interactive" aria-label={title}>
      <div class="sequence-toolbar">
        <label>
          <span>{ui.scenario}</span>
          <select data-control="scenario">
            {
              selected.map((scenario) => (
                <option
                  value={scenario.id}
                  selected={scenario.id === initialId}
                >
                  {scenario.label}
                </option>
              ))
            }
          </select>
        </label>
        <div class="button-group" aria-label={ui.controlsLabel}>
          <button type="button" data-control="previous">{ui.previous}</button>
          <button type="button" data-control="next">{ui.next}</button>
          <button type="button" data-control="play">{ui.play}</button>
          <button type="button" data-control="pause" disabled>{ui.pause}</button
          >
          <button type="button" data-control="restart">{ui.restart}</button>
        </div>
      </div>

      <p class="scenario-summary" data-field="summary"></p>
      <ol
        class="sequence-step-index"
        data-field="step-index"
        aria-label={stepIndexLabel}
      >
        {
          initialScenario?.steps.map((step, index) => (
            <li>
              <button
                type="button"
                data-sequence-step={index}
                aria-current={index === 0 ? "step" : undefined}
                aria-label={`${jumpToStepLabel}: ${step.title}`}
                disabled
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{step.title}</strong>
                <small>
                  {staticActorLabel(step.from)} → {staticActorLabel(step.to)}
                </small>
              </button>
            </li>
          ))
        }
      </ol>
      <div
        class="lane-map"
        role="img"
        aria-label={ui.fixedActorMap}
        tabindex="0"
      >
        <div class="sequence-map-stage">
          <span class="sequence-cluster" aria-hidden="true"
            >{ui.sharedCluster}</span
          >
          <svg
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <defs>
              <marker
                id="sequence-arrow"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="7"
                markerHeight="7"
                orient="auto"
              >
                <path d="M 0 0 L 10 5 L 0 10 z"></path>
              </marker>
            </defs>
            <line data-field="route" marker-end="url(#sequence-arrow)"></line>
          </svg>
          <div class="actor-map" data-field="lanes"></div>
        </div>
      </div>
      <div class="step-status" aria-live="polite" aria-atomic="true">
        <p class="step-count" data-field="count"></p>
        <h3 data-field="title"></h3>
        <p data-field="explanation"></p>
      </div>
      <dl class="step-facts">
        <div><dt>{ui.sent}</dt><dd data-field="sent"></dd></div>
        <div><dt>{ui.withheld}</dt><dd data-field="withheld"></dd></div>
        <div><dt>{ui.owner}</dt><dd data-field="owner"></dd></div>
        <div><dt>{ui.failure}</dt><dd data-field="failure"></dd></div>
      </dl>
      <p class="keyboard-hint">{ui.keyboardHint}</p>
    </section>
  </tobari-sequence>

  <details class="static-sequence-disclosure" open>
    <summary>{ui.staticDisclosure}</summary>
    <section class="static-sequences" aria-labelledby={`static-${initialId}`}>
      <h3 id={`static-${initialId}`}>{ui.staticHeading}</h3>
      <p>{ui.staticIntroduction}</p>
      {
        selected.map((scenario, scenarioIndex) => (
          <details open={scenarioIndex === 0}>
            <summary>{scenario.label}</summary>
            <p>{scenario.summary}</p>
            <ol>
              {scenario.steps.map((step) => (
                <li>
                  <h4>{step.title}</h4>
                  <p>
                    <strong>
                      {staticActorLabel(step.from)} →{" "}
                      {staticActorLabel(step.to)}:
                    </strong>{" "}
                    {step.explanation}
                  </p>
                  <dl>
                    <div>
                      <dt>{ui.staticSent}</dt>
                      <dd>{step.sent}</dd>
                    </div>
                    <div>
                      <dt>{ui.staticWithheld}</dt>
                      <dd>{step.withheld}</dd>
                    </div>
                    <div>
                      <dt>{ui.staticOwner}</dt>
                      <dd>{step.owner}</dd>
                    </div>
                    <div>
                      <dt>{ui.staticFailure}</dt>
                      <dd>{step.failure}</dd>
                    </div>
                  </dl>
                </li>
              ))}
            </ol>
          </details>
        ))
      }
    </section>
  </details>
</figure>

<script>
  import type { SequenceScenario, SequenceStep } from "../data/sequences";

  interface DisplayStep extends SequenceStep {
    fromLabel?: string;
    toLabel?: string;
  }

  interface DisplayScenario extends Omit<SequenceScenario, "steps"> {
    steps: DisplayStep[];
  }

  const actorAliases: Record<string, string> = {
    "Workspace source endpoint": "Gateway",
    "OPA runtime": "OPA",
    "OPA / Upstream": "Upstream",
  };
  const actorPositions: Record<string, { x: number; y: number }> = {
    "Workspace process": { x: 17, y: 52 },
    Gateway: { x: 48, y: 52 },
    OPA: { x: 48, y: 16 },
    "DNS / resolver": { x: 82, y: 16 },
    Upstream: { x: 82, y: 52 },
    "Review store": { x: 82, y: 84 },
    "Host diagnostics": { x: 82, y: 84 },
    "Host operator": { x: 17, y: 84 },
    "Tobari CLI": { x: 47, y: 52 },
    "Policy validator": { x: 70, y: 18 },
  };
  const normalizeActor = (actor: string) => actorAliases[actor] || actor;

  class TobariSequence extends HTMLElement {
    scenarios: DisplayScenario[] = [];
    scenarioIndex = 0;
    stepIndex = 0;
    timer?: number;
    isJapanese = false;
    actorLabels: Record<string, string> = {};

    connectedCallback() {
      this.closest(".sequence-explorer")
        ?.querySelector<HTMLDetailsElement>(".static-sequence-disclosure")
        ?.removeAttribute("open");
      try {
        this.scenarios = JSON.parse(
          this.dataset.scenarios || "[]",
        ) as DisplayScenario[];
        this.actorLabels = JSON.parse(
          this.dataset.actorLabels || "{}",
        ) as Record<string, string>;
      } catch {
        return;
      }
      this.isJapanese = this.dataset.locale === "ja";
      const requested = this.dataset.initial;
      const found = this.scenarios.findIndex(({ id }) => id === requested);
      this.scenarioIndex = found >= 0 ? found : 0;
      this.querySelector('[data-control="scenario"]')?.addEventListener(
        "change",
        (event) => {
          if (!(event.currentTarget instanceof HTMLSelectElement)) return;
          const selectedValue = event.currentTarget.value;
          const index = this.scenarios.findIndex(
            ({ id }) => id === selectedValue,
          );
          if (index >= 0) {
            this.stop();
            this.scenarioIndex = index;
            this.stepIndex = 0;
            this.renderStepIndex();
            this.render();
          }
        },
      );
      this.querySelector('[data-control="previous"]')?.addEventListener(
        "click",
        () => this.previous(),
      );
      this.querySelector('[data-control="next"]')?.addEventListener(
        "click",
        () => this.next(),
      );
      this.querySelector('[data-control="play"]')?.addEventListener(
        "click",
        () => this.play(),
      );
      this.querySelector('[data-control="pause"]')?.addEventListener(
        "click",
        () => this.stop(),
      );
      this.querySelector('[data-control="restart"]')?.addEventListener(
        "click",
        () => {
          this.stop();
          this.stepIndex = 0;
          this.render();
        },
      );
      this.addEventListener("keydown", (event) => {
        if (
          event.target instanceof HTMLSelectElement ||
          event.target instanceof HTMLButtonElement
        )
          return;
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          this.previous();
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          this.next();
        } else if (event.key === " ") {
          event.preventDefault();
          this.timer ? this.stop() : this.play();
        }
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) this.stop();
      });
      this.renderStepIndex();
      this.render();
    }

    get scenario() {
      return this.scenarios[this.scenarioIndex];
    }

    displayActor(actor: string) {
      return this.actorLabels[actor] || actor;
    }

    setText(field: string, value: string) {
      const element = this.querySelector(`[data-field="${field}"]`);
      if (element) element.textContent = value;
    }

    renderStepIndex() {
      const scenario = this.scenario;
      const list = this.querySelector<HTMLOListElement>(
        '[data-field="step-index"]',
      );
      if (!scenario || !list) return;
      list.replaceChildren();
      scenario.steps.forEach((step, index) => {
        const item = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.sequenceStep = String(index);
        button.setAttribute(
          "aria-label",
          `${this.isJapanese ? "この段階を表示" : "Show this step"}: ${step.title}`,
        );
        const number = document.createElement("span");
        number.textContent = String(index + 1).padStart(2, "0");
        const title = document.createElement("strong");
        title.textContent = step.title;
        const route = document.createElement("small");
        route.textContent = `${step.fromLabel || this.displayActor(step.from)} → ${step.toLabel || this.displayActor(step.to)}`;
        button.append(number, title, route);
        button.addEventListener("click", () => {
          this.stop();
          this.stepIndex = index;
          this.render();
        });
        item.append(button);
        list.append(item);
      });
    }

    render() {
      const scenario = this.scenario;
      const step = scenario?.steps[this.stepIndex];
      if (!scenario || !step) return;
      this.setText("summary", scenario.summary);
      this.setText(
        "count",
        this.isJapanese
          ? `${scenario.steps.length} 段階中 ${this.stepIndex + 1} 段階目`
          : `Step ${this.stepIndex + 1} of ${scenario.steps.length}`,
      );
      this.setText("title", step.title);
      const fromLabel = step.fromLabel || this.displayActor(step.from);
      const toLabel = step.toLabel || this.displayActor(step.to);
      this.setText(
        "explanation",
        this.isJapanese
          ? `${fromLabel} → ${toLabel}。${step.explanation}`
          : `${step.from} → ${step.to}. ${step.explanation}`,
      );
      this.setText("sent", step.sent);
      this.setText("withheld", step.withheld);
      this.setText("owner", step.owner);
      this.setText("failure", step.failure);
      const lanes = this.querySelector('[data-field="lanes"]');
      if (lanes) {
        lanes.replaceChildren();
        const coreRequestActors = [
          "Workspace process",
          "Gateway",
          "OPA",
          "Upstream",
        ];
        const actors = Array.from(
          new Set([
            ...(scenario.id === "policy-review" ? [] : coreRequestActors),
            ...scenario.actors.map(normalizeActor),
            ...scenario.steps.flatMap(({ from, to }) => [
              normalizeActor(from),
              normalizeActor(to),
            ]),
          ]),
        );
        const source = normalizeActor(step.from);
        const target = normalizeActor(step.to);
        for (const actor of actors) {
          const lane = document.createElement("div");
          lane.className = "actor-lane";
          const position = actorPositions[actor] || { x: 50, y: 50 };
          lane.style.setProperty("--actor-x", String(position.x));
          lane.style.setProperty("--actor-y", String(position.y));
          const isSource = actor === source;
          const isTarget = actor === target;
          if (isSource) lane.dataset.state = "source";
          if (isTarget) lane.dataset.state = "target";
          if (isSource || isTarget) lane.classList.add(`tone-${step.tone}`);
          const label = document.createElement("span");
          label.className = "actor-label";
          label.textContent = this.displayActor(actor);
          lane.append(label);
          const track = document.createElement("span");
          track.className = "actor-track";
          track.setAttribute("aria-hidden", "true");
          lane.append(track);
          if (isSource || isTarget) {
            const marker = document.createElement("span");
            marker.className = `message-marker tone-${step.tone}`;
            marker.textContent =
              isSource && isTarget
                ? this.isJapanese
                  ? "内部"
                  : "●"
                : isSource
                  ? this.isJapanese
                    ? "送信"
                    : "SEND"
                  : this.isJapanese
                    ? "受信"
                    : "RECEIVE";
            marker.setAttribute("aria-hidden", "true");
            lane.append(marker);
          }
          lanes.append(lane);
        }
        const map = lanes.closest<HTMLElement>(".lane-map");
        map?.setAttribute(
          "aria-label",
          this.isJapanese
            ? `${step.title}：${fromLabel} から ${toLabel} へ送信`
            : `${step.title}: ${step.from} sends to ${step.to}`,
        );
        if (map)
          map.dataset.mapMode =
            scenario.id === "policy-review" ? "review" : "request";
        const sourcePosition = actorPositions[source] || { x: 50, y: 50 };
        const targetPosition = actorPositions[target] || { x: 50, y: 50 };
        const route = this.querySelector<SVGLineElement>(
          '[data-field="route"]',
        );
        if (route) {
          route.setAttribute("x1", String(sourcePosition.x));
          route.setAttribute("y1", String(sourcePosition.y));
          route.setAttribute("x2", String(targetPosition.x));
          route.setAttribute("y2", String(targetPosition.y));
          route.setAttribute("class", `tone-${step.tone}`);
          route.toggleAttribute("data-self-route", source === target);
        }
      }
      this.querySelectorAll<HTMLButtonElement>("[data-sequence-step]").forEach(
        (button) => {
          const active = Number(button.dataset.sequenceStep) === this.stepIndex;
          if (active) button.setAttribute("aria-current", "step");
          else button.removeAttribute("aria-current");
          button.classList.toggle("is-active", active);
        },
      );
      const previous = this.querySelector<HTMLButtonElement>(
        '[data-control="previous"]',
      );
      const next = this.querySelector<HTMLButtonElement>(
        '[data-control="next"]',
      );
      if (previous) previous.disabled = this.stepIndex === 0;
      if (next) next.disabled = this.stepIndex === scenario.steps.length - 1;
    }

    previous() {
      if (this.stepIndex > 0) {
        this.stop();
        this.stepIndex -= 1;
        this.render();
      }
    }

    next() {
      if (this.stepIndex < this.scenario.steps.length - 1) {
        this.stepIndex += 1;
        this.render();
      } else {
        this.stop();
      }
    }

    play() {
      if (this.timer || this.stepIndex >= this.scenario.steps.length - 1)
        return;
      const play = this.querySelector<HTMLButtonElement>(
        '[data-control="play"]',
      );
      const pause = this.querySelector<HTMLButtonElement>(
        '[data-control="pause"]',
      );
      if (play) play.disabled = true;
      if (pause) pause.disabled = false;
      const interval = matchMedia("(prefers-reduced-motion: reduce)").matches
        ? 5000
        : 3000;
      this.timer = window.setInterval(() => this.next(), interval);
    }

    stop() {
      if (this.timer) window.clearInterval(this.timer);
      this.timer = undefined;
      const play = this.querySelector<HTMLButtonElement>(
        '[data-control="play"]',
      );
      const pause = this.querySelector<HTMLButtonElement>(
        '[data-control="pause"]',
      );
      if (play)
        play.disabled =
          this.stepIndex >= (this.scenario?.steps.length || 1) - 1;
      if (pause) pause.disabled = true;
    }
  }

  if (!customElements.get("tobari-sequence"))
    customElements.define("tobari-sequence", TobariSequence);
</script>

<style>
  tobari-sequence {
    scroll-margin-block-start: 5rem;
  }
  .sequence-explorer {
    margin: 2rem 0;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.15rem;
    background: var(--sl-color-gray-7);
  }
  .sequence-explorer figcaption h2 {
    margin: 0.2rem 0 0.4rem;
  }
  .sequence-explorer figcaption p {
    margin: 0;
    color: var(--sl-color-gray-2);
  }
  .eyebrow {
    color: var(--tobari-control);
    font-size: var(--sl-text-xs);
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sequence-interactive {
    margin-top: 1.2rem;
  }
  .sequence-toolbar,
  .button-group {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.55rem;
  }
  .sequence-toolbar {
    justify-content: space-between;
  }
  .sequence-toolbar label {
    display: grid;
    gap: 0.3rem;
    width: min(100%, 19rem);
    min-width: 0;
    max-width: 100%;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 650;
  }
  .sequence-toolbar select,
  .sequence-toolbar button {
    min-height: 2.75rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.35rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font: inherit;
  }
  .sequence-toolbar select {
    width: 100%;
    min-width: 0;
    padding: 0.5rem 2rem 0.5rem 0.65rem;
  }
  .sequence-toolbar button {
    padding: 0.45rem 0.7rem;
    cursor: pointer;
  }
  .sequence-toolbar button:hover:not(:disabled) {
    border-color: var(--tobari-control);
  }
  .sequence-toolbar button:disabled {
    cursor: not-allowed;
    opacity: 0.48;
  }
  .scenario-summary {
    margin: 1rem 0 0.75rem;
    color: var(--sl-color-gray-2);
  }
  .sequence-step-index {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr));
    gap: 0.45rem;
    margin: 0 0 0.8rem;
    padding: 0;
    list-style: none;
  }
  .sequence-step-index li {
    min-width: 0;
    margin: 0;
  }
  .sequence-step-index button {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.15rem 0.55rem;
    width: 100%;
    min-height: 5.2rem;
    padding: 0.65rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .sequence-step-index button:disabled {
    cursor: default;
  }
  .sequence-step-index button:hover:not(:disabled),
  .sequence-step-index button:focus-visible,
  .sequence-step-index button.is-active,
  .sequence-step-index button[aria-current="step"] {
    border-color: var(--tobari-control);
    box-shadow: inset 0 -0.2rem var(--tobari-control);
    color: var(--sl-color-white);
  }
  .sequence-step-index span {
    grid-row: 1 / 3;
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 850;
  }
  .sequence-step-index strong,
  .sequence-step-index small {
    min-width: 0;
  }
  .sequence-step-index strong {
    font-size: var(--sl-text-xs);
    line-height: 1.35;
  }
  .sequence-step-index small {
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    overflow-wrap: anywhere;
  }
  .lane-map {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
  }
  .sequence-map-stage {
    position: relative;
    min-width: 42rem;
    height: 22rem;
    overflow: hidden;
    background-image:
      linear-gradient(var(--sl-color-gray-6) 1px, transparent 1px),
      linear-gradient(90deg, var(--sl-color-gray-6) 1px, transparent 1px);
    background-size: 2rem 2rem;
  }
  .sequence-map-stage svg,
  .actor-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
  }
  .sequence-map-stage svg {
    z-index: 1;
  }
  .sequence-map-stage line {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.7;
    vector-effect: non-scaling-stroke;
  }
  .sequence-map-stage line[data-self-route] {
    stroke-dasharray: 3 3;
  }
  .sequence-map-stage marker path {
    fill: context-stroke;
  }
  .sequence-cluster {
    position: absolute;
    z-index: 0;
    inset: 1rem 33% 1rem;
    padding: 0.35rem 0.45rem;
    border: 1px dashed var(--tobari-diagnostic);
