---
import versionData from "../generated/component-versions.json";

const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const ui = isJapanese
  ? {
      componentIdentities: "コンポーネントの識別情報",
      componentDescription:
        "この表は、リポジトリで管理する正本から生成しています。実行時の識別情報にはダイジェストを使います。分かりやすいバージョンは、リポジトリに宣言がある場合だけ表示します。",
      component: "コンポーネント",
      declaredVersion: "宣言されたバージョン",
      runtimeIdentity: "実行時の識別情報",
      authority: "正本",
      schemaIdentities: "スキーマと API のバージョン",
      contract: "契約",
      version: "バージョン",
      defaultRuntime: "既定ランタイムの契約",
      defaultSelector: "既定の選択子",
      selectorKind: "選択子の種類",
      localBuild: "CLI に埋め込まれた固定レシピからのローカルビルド",
      movingSelector: "更新されるタグ（不変なダイジェストではない）",
      immutableDigest: "不変なダイジェスト",
      runtimeApi: "ランタイム API",
      lifecycleCommand: "ライフサイクルコマンド",
      baseMetadataVersion: "ベースメタデータのバージョン",
      architectures: "対応アーキテクチャ",
    }
  : {
      componentIdentities: "Component identities",
      componentDescription:
        "This table is generated from committed repository authorities. A digest is the runtime identity; a friendly version is shown only when the repository declares one.",
      component: "Component",
      declaredVersion: "Declared version",
      runtimeIdentity: "Runtime identity",
      authority: "Authority",
      schemaIdentities: "Schema and API versions",
      contract: "Contract",
      version: "Version",
      defaultRuntime: "Default runtime contract",
      defaultSelector: "Default selector",
      selectorKind: "Selector kind",
      localBuild: "Local build from the CLI's pinned embedded recipe",
      movingSelector: "Moving tag — not an immutable digest",
      immutableDigest: "Immutable digest",
      runtimeApi: "Runtime API",
      lifecycleCommand: "Lifecycle command",
      baseMetadataVersion: "Base metadata version",
      architectures: "Architectures",
    };

// The generator remains the authority for values. These exact-key maps only
// localize its human-readable prose when the Japanese route renders it.
const componentNamesJa: Record<string, string> = {
  Go: "Go",
  OPA: "OPA",
  mitmproxy: "mitmproxy",
  Gateway: "Gateway",
  "Auth Broker": "Auth Broker",
  "Base runtime build image": "ベースランタイムのビルドイメージ",
  "Tobari CLI": "Tobari CLI",
};
const generatedPhrasesJa: Record<string, string> = {
  "digest identity": "ダイジェストによる識別",
  "release-generated V1": "リリース生成 V1",
  "injected immutable digest": "注入された不変ダイジェスト",
  "embedded-source V1": "埋め込みソース V1",
  "experimental embedded-source V1": "実験的な埋め込みソース V1",
  "source-derived local image": "ソース由来のローカルイメージ",
  "experimental source-derived local image":
    "実験的なソース由来のローカルイメージ",
  "dev unless release-injected": "リリース時に注入されない限り dev",
  "unpublished V1 snapshot": "未公開の V1 スナップショット",
  unpublished: "未公開",
  "documentation commit supplies source identity":
    "ドキュメントのコミットがソースの識別情報を示す",
  "Version is declared; runtime identity is the immutable digest.":
    "バージョンは宣言値です。実行時の識別情報には不変なダイジェストを使います。",
  "Version is declared; build base identity is the immutable digest.":
    "バージョンは宣言値です。ビルド元の識別情報には不変なダイジェストを使います。",
  "The repository does not invent a release version for ordinary builds.":
    "通常のビルドに対して、リポジトリがリリースバージョンを推測することはありません。",
};
const schemaNamesJa: Record<string, string> = {
  "Agent help": "エージェントヘルプ",
  "Workspace Manifest": "Workspace Manifest",
  "Public Workspace Manifest report": "公開 Workspace Manifest レポート",
  "Root index and Workspace instance": "ルート索引と Workspace インスタンス",
  "Owner provider manifest": "所有者のプロバイダーマニフェスト",
  "Normalized provider projection / reviewed built-in manifest":
    "正規化したプロバイダー投影／レビュー済み組み込みマニフェスト",
  "Project principal registry": "プロジェクトプリンシパル登録簿",
  "Gateway image API": "Gateway image API",
  "Gateway OPA input": "Gateway の OPA 入力",
  "Auth Broker image API": "Auth Broker image API",
  "Auth Broker control/runtime protocol and static vault":
    "Auth Broker の制御／ランタイムプロトコルと静的保管庫",
};
const requiredTranslation = (
  value: string,
  translations: Record<string, string>,
  field: string,
): string => {
  if (!isJapanese) return value;
  const translated = translations[value];
  if (!translated) {
    throw new Error(`Missing Japanese component-version ${field}: ${value}`);
  }
  return translated;
};
const localizeGenerated = (
  value: string,
  field: "version" | "identity" | "note",
): string => {
  if (!isJapanese) return value;
  const translated = generatedPhrasesJa[value];
  if (translated) return translated;
  const machineValue =
    (field === "version" && /^(?:\d|bookworm-)/.test(value)) ||
    (field === "identity" &&
      (value.startsWith("go ") || value.includes("@sha256:")));
  if (machineValue) return value;
  throw new Error(`Missing Japanese component-version ${field}: ${value}`);
};
---

<section class="version-reference" aria-labelledby="component-identities">
  <h2 id="component-identities">{ui.componentIdentities}</h2>
  <p>{ui.componentDescription}</p>
  <div class="responsive-table">
    <table>
      <thead
        ><tr
          ><th>{ui.component}</th><th>{ui.declaredVersion}</th><th
            >{ui.runtimeIdentity}</th
          ><th>{ui.authority}</th></tr
        ></thead
      >
      <tbody>
        {
          versionData.components.map((component) => (
            <tr>
              <th scope="row">
                {requiredTranslation(
                  component.component,
                  componentNamesJa,
                  "component",
                )}
              </th>
              <td data-label={ui.declaredVersion}>
                {localizeGenerated(component.version, "version")}
              </td>
              <td data-label={ui.runtimeIdentity}>
                <code>{localizeGenerated(component.identity, "identity")}</code>
                {component.note && (
                  <small>{localizeGenerated(component.note, "note")}</small>
                )}
              </td>
              <td data-label={ui.authority}>
                <code>{component.authority}</code>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="schema-identities">{ui.schemaIdentities}</h2>
  <div class="responsive-table narrow">
    <table>
      <thead
        ><tr
          ><th>{ui.contract}</th><th>{ui.version}</th><th>{ui.authority}</th
          ></tr
        ></thead
      >
      <tbody>
        {
          versionData.schemas.map((schema) => (
            <tr>
              <>
                <th scope="row">
                  {requiredTranslation(
                    schema.contract,
                    schemaNamesJa,
                    "schema contract",
                  )}
                </th>
                <td data-label={ui.version}>
                  <code>{schema.version}</code>
                </td>
                <td data-label={ui.authority}>
                  <code>{schema.authority}</code>
                </td>
              </>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <aside class="runtime-contract">
    <h2>{ui.defaultRuntime}</h2>
    <dl>
      <div>
        <dt>{ui.defaultSelector}</dt><dd>
          <code>{versionData.runtime.default_selector}</code>
        </dd>
      </div>
      <div>
        <dt>{ui.selectorKind}</dt><dd>
          {
            versionData.runtime.local_build
              ? ui.localBuild
              : versionData.runtime.moving_selector
                ? ui.movingSelector
                : ui.immutableDigest
          }
        </dd>
      </div>
      <div>
        <dt>{ui.runtimeApi}</dt><dd>
          <code>{versionData.runtime.runtime_api}</code>
        </dd>
      </div>
      <div>
        <dt>{ui.lifecycleCommand}</dt><dd>
          <code>{versionData.runtime.lifetime_command}</code>
        </dd>
      </div>
      <div>
        <dt>{ui.baseMetadataVersion}</dt><dd>
          <code>{versionData.runtime.metadata_version}</code>
        </dd>
      </div>
      <div>
        <dt>{ui.architectures}</dt><dd>
          {versionData.runtime.architectures.join(", ")}
        </dd>
      </div>
    </dl>
  </aside>
</section>

<style>
  .responsive-table {
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
  }
  table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  th,
  td {
    padding: 0.65rem;
    border: 1px solid var(--sl-color-gray-5);
    vertical-align: top;
    text-align: start;
  }
  thead th {
    background: var(--sl-color-gray-6);
  }
  code {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  small {
    display: block;
    margin-top: 0.35rem;
    color: var(--sl-color-gray-3);
  }
  .runtime-contract {
    margin-top: 1.5rem;
    padding: 1rem;
    border-inline-start: 0.3rem solid var(--tobari-warning);
    background: var(--sl-color-gray-6);
  }
  .runtime-contract h2 {
    margin-top: 0;
  }
  .runtime-contract dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.25rem;
  }
  .runtime-contract dt {
    color: var(--sl-color-gray-3);
    font-weight: 700;
  }
  .runtime-contract dd {
    margin: 0.2rem 0 0;
  }
  @media (max-width: 44rem) {
    .responsive-table table,
    .responsive-table tbody,
    .responsive-table tr,
    .responsive-table th,
    .responsive-table td {
      display: block;
    }
    .responsive-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .responsive-table tr {
      padding: 0.6rem;
      border-bottom: 1px solid var(--sl-color-gray-4);
    }
    .responsive-table tr:last-child {
      border-bottom: 0;
    }
    .responsive-table th,
    .responsive-table td {
      padding: 0.35rem;
      border: 0;
    }
    .responsive-table td::before {
      content: attr(data-label) ": ";
      color: var(--sl-color-gray-3);
      font-weight: 700;
    }
    .runtime-contract dl {
      grid-template-columns: 1fr;
    }
  }
</style>
