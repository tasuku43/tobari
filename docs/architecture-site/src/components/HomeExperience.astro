---
const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const t = <T,>(english: T, japanese: T) => (isJapanese ? japanese : english);
const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}${isJapanese ? "ja/" : ""}${path.replace(/^\//, "")}`;
const evidenceHref = (path: string) =>
  `${__TOBARI_DOCS_REPOSITORY__}/blob/${__TOBARI_DOCS_COMMIT__}/${path}`;

const steps = [
  {
    from: "Workspace",
    to: "Gateway",
    title: t("A request enters Gateway", "リクエストが Gateway に入る"),
    detail: t(
      "A tool in the project Workspace sends an HTTP or HTTPS request. The project-specific network gives that request only one supported path: Gateway.",
      "プロジェクトの Workspace から HTTP/HTTPS リクエストを送ります。プロジェクト専用ネットワークでは、Gateway が唯一の外向き経路です。",
    ),
    kind: "network",
  },
  {
    from: "Gateway",
    to: t("Upstream", "接続先"),
    title: t("An undeclared request stops here", "未許可の通信はここで止まる"),
    detail: t(
      "Gateway asks OPA before opening an external connection. If no matching permission exists, it returns a denial and records bounded review data.",
      "Gateway は外部接続を作る前に OPA へ問い合わせます。一致する許可がなければ拒否し、レビューに必要な範囲だけを記録します。",
    ),
    kind: "denied",
    blocked: true,
  },
  {
    from: t("Host review", "ホストでのレビュー"),
    to: t("Policy", "ポリシー"),
    title: t(
      "A person decides the exact permission",
      "通信条件を確認して許可を決める",
    ),
    detail: t(
      "On the trusted host, you inspect the destination, port, method, and path, then allow or deny that exact communication.",
      "信頼するホストで、宛先・ポート・メソッド・パスを確認し、その通信条件を許可するか拒否するか決めます。",
    ),
    kind: "control",
  },
  {
    from: "Gateway",
    to: t("Upstream", "接続先"),
    title: t(
      "Only a new authorized request proceeds",
      "許可後の新しいリクエストだけが進む",
    ),
    detail: t(
      "The previous request is never replayed. A new matching request is evaluated again, then Gateway opens the external connection after allow.",
      "拒否されたリクエストは再送しません。同じ条件の新しいリクエストを再評価し、許可後に Gateway が外部接続を作ります。",
    ),
    kind: "allowed",
  },
];

const tasks = [
  {
    href: "/start/quickstart/",
    title: t("I want to try it", "まず動かす"),
    detail: t(
      "Experience denial, review, allow, and deliberate retry in a synthetic project.",
      "拒否、レビュー、許可、再実行までを、練習用ディレクトリで確認します。",
    ),
  },
  {
    href: "/start/runtime-setup/",
    title: t(
      "I need my coding agent and toolchain",
      "エージェントと開発ツールを入れる",
    ),
    detail: t(
      "Build and validate a Context-owned runtime before using a real repository.",
      "実際のリポジトリで使う前に、Context 管理のランタイムをビルドして検証します。",
    ),
  },
  {
    href: "/start/first-denial/",
    title: t("A request was denied", "通信が拒否された"),
    detail: t(
      "Find why it stopped, where to review it, and what can be allowed.",
      "拒否理由と通信条件を確認し、何を許可するか判断します。",
    ),
  },
  {
    href: "/guides/authentication/",
    title: t(
      "I need GitHub or another supported login",
      "GitHub などの認証を設定する",
    ),
    detail: t(
      "Configure supported credentials without placing their primary value in the Workspace.",
      "認証情報の本体を Workspace に渡さず、対応するプロバイダーを設定します。",
    ),
  },
  {
    href: "/security/guarantees-and-limitations/",
    title: t("I need the security boundary", "セキュリティ境界を確認する"),
    detail: t(
      "Read each guarantee with its prerequisites, exclusions, and trusted components.",
      "保証が成立する前提と、Tobari が保護しない範囲を確認します。",
    ),
  },
  {
    href: "/reference/cli/",
    title: t("I need a command", "コマンドを調べる"),
    detail: t(
      "Choose a command by task, then open its generated contract.",
      "作業ごとに候補を絞り、Catalog から生成された入出力・前提条件・障害を確認します。",
    ),
  },
];

const protectedItems = t(
  [
    "Host files outside the selected project and Docker control",
    "Another Workspace's network and persistent home",
    "Unauthorized outbound HTTP/HTTPS and primary credentials managed by Broker",
  ],
  [
    "作業対象外のホストファイルと Docker の制御機能",
    "ほかの Workspace のネットワークと永続ホーム",
    "未許可の HTTP/HTTPS 通信と、Auth Broker が管理する認証情報の本体",
  ],
);
const excludedItems = t(
  [
    "Files inside the selected project",
    "Data sent to a destination you explicitly allow",
    "A compromised host, Docker, kernel, enforcement service, or communication outside ordinary HTTP/HTTPS",
  ],
  [
    "作業対象のディレクトリ内にあるファイル",
    "許可済みの接続先へ送るデータ",
    "ホスト、Docker、カーネル、強制機構の侵害、および HTTP/HTTPS 以外の通信",
  ],
);
const evidence = [
  [t("Product contract", "製品契約"), "docs/01_product_contract.md"],
  [t("Security model", "セキュリティモデル"), "docs/03_security_model.md"],
  [
    t("Supported network topology", "対応するネットワーク構成"),
    "internal/infra/runtimeassets/assets/compose.yaml",
  ],
  [
    t("End-to-end boundary tests", "一連の境界動作を確認するテスト"),
    "scripts/test-integration.sh",
  ],
] as const;
---

<div class="home-experience">
  <section class="home-hero">
    <div>
      <p class="home-eyebrow">
        {t("A coding-agent execution boundary", "隔離環境と外部通信の制御")}
      </p>
      <h2>
        {
          t(
            "Run a coding agent inside one selected project.",
            "コーディングエージェントを隔離環境で実行し、外部通信を制御する。",
          )
        }
      </h2>
      <p class="home-lead">
        {
          t(
            "Outbound HTTP and HTTPS communication starts denied. Review what the agent attempted, allow only the exact communication you need, and then issue a new request.",
            "Tobari は、作業対象のディレクトリをプロジェクト専用のコンテナへマウントし、未許可の HTTP/HTTPS 通信を Gateway で拒否します。拒否された通信をホスト側で確認し、宛先・ポート・メソッド・パスが一致する通信だけを許可できます。",
          )
        }
      </p>
      <div class="home-actions">
        <a class="primary" href={withBase("/start/quickstart/")}>
          {t("Try it in five minutes", "5分で試す")}
        </a>
        <a href="#basic-operation">
          {t("See how it works in 60 seconds", "基本動作を見る")}
        </a>
      </div>
      <p class="home-caveat">
        {
          t(
            "Important: files inside the selected project are not protected from the agent. The agent can read and write that mounted project.",
            "作業対象のディレクトリは、エージェントが読み書きできます。Tobari が隔離するのは、その外側にあるホスト環境と、未許可の外部通信です。",
          )
        }
      </p>
    </div>

    <aside
      class="home-example"
      aria-label={t("Example first denial", "未許可の通信が拒否される例")}
    >
      <p>{t("Example first denial", "未許可の通信が拒否される例")}</p>
      <ol>
        <li>
          <span>01</span><strong
            >{t("Agent requests", "外部通信を試みる")}</strong
          ><code>PUT example.com/quickstart</code>
        </li>
        <li>
          <span>02</span><strong>{t("Tobari denies", "Gateway が拒否")}</strong
          ><code class="denied">403 policy_denied</code>
        </li>
        <li>
          <span>03</span><strong>{t("Host reviews", "ホストでレビュー")}</strong
          ><code>tobari policy review</code>
        </li>
        <li>
          <span>04</span><strong
            >{t("User retries", "新しいリクエストを送る")}</strong
          ><code class="allowed">new request</code>
        </li>
      </ol>
    </aside>
  </section>

  <section class="home-section" id="basic-operation">
    <p class="home-eyebrow">
      {t("The basic operation in 60 seconds", "基本動作")}
    </p>
    <h2>
      {
        t(
          "Stop it, review it, then allow only what is needed",
          "未許可の通信を止め、ホスト側の判断で許可する",
        )
      }
    </h2>
    <p class="home-intro">
      {
        t(
          "Start with one request. The numbered route shows where it stops, who changes policy, and when a new request can continue.",
          "一つのリクエストを番号順に追います。どこで止まり、誰がポリシーを変更し、いつ新しいリクエストが先へ進むかを確認します。",
        )
      }
    </p>
    <ol class="home-flow">
      {
        steps.map((step, index) => (
          <li
            class:list={[`flow-${step.kind}`, step.blocked && "flow-blocked"]}
          >
            <span class="home-flow-number">
              {String(index + 1).padStart(2, "0")}
            </span>
            <p class="home-flow-route">
              <strong>{step.from}</strong>
              <b aria-hidden="true">{step.blocked ? "⊣" : "→"}</b>
              <strong>{step.to}</strong>
            </p>
            <h3>{step.title}</h3>
            <p class="home-flow-detail">{step.detail}</p>
          </li>
        ))
      }
    </ol>
    <p class="home-more">
      <a href={withBase("/how-it-works/request-journey/")}
        >{
          t(
            "See the complete component flow",
            "コンポーネントを含む処理順序を見る",
          )
        } →</a
      >
    </p>
  </section>

  <section class="home-section">
    <p class="home-eyebrow">
      {t("Start from your question", "目的別に読む")}
    </p>
    <h2>
      {t("Choose the entry closest to what you need now", "必要な情報へ進む")}
    </h2>
    <div class="home-tasks">
      {
        tasks.map((task) => (
          <a href={withBase(task.href)}>
            <>
              <h3>{task.title}</h3>
              <p>{task.detail}</p>
              <span aria-hidden="true">→</span>
            </>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <p class="home-eyebrow">
      {t("Know the scope early", "セキュリティ境界")}
    </p>
    <h2>
      {
        t(
          "What the boundary protects—and what it does not",
          "Tobari が保護する範囲と、保護しない範囲",
        )
      }
    </h2>
    <div class="home-boundaries">
      <section>
        <h3>
          {
            t(
              "Protected in the supported topology",
              "サポート対象の構成で制限するもの",
            )
          }
        </h3><ul>{protectedItems.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section class="excluded">
        <h3>{t("Not protected by Tobari", "保護しないもの")}</h3><ul>
          {excludedItems.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>
    <p class="home-more">
      <a href={withBase("/security/guarantees-and-limitations/")}
        >{
          t(
            "Read guarantees with their prerequisites",
            "保証の前提と制限を確認する",
          )
        } →</a
      >
    </p>
  </section>

  <section class="home-section home-evidence">
    <details>
      <summary
        >{
          t(
            "View current implementation status and evidence",
            "現在の実装と根拠を確認する",
          )
        }</summary
      >
      <div>
        <section>
          <h3>{t("Implemented now", "実装されている機能")}</h3><p>
            {
              t(
                "Project-bound Workspace lifecycle, shared Gateway, OPA, and Auth Broker services, default-deny exact policy learning, intercepted HTTP/HTTPS, supported credential paths, and Catalog-generated CLI contracts.",
                "プロジェクト単位の Workspace、共有の Gateway・OPA・Auth Broker、既定拒否から始まる完全一致ルール、HTTP/HTTPS の検査、対応する認証経路、Catalog から生成した CLI 契約です。",
              )
            }
          </p>
        </section>
        <section>
          <h3>{t("Pre-public V1", "公開前の V1")}</h3><p>
            {
              t(
                "Every Tobari-owned schema and component API is V1. Development snapshots have no migration or compatibility reader; recreate local state when the contract changes.",
                "Tobari 所有のスキーマとコンポーネント API はすべて V1 です。開発スナップショットには移行処理や互換読み取りがないため、契約変更時はローカル状態を作り直します。",
              )
            }
          </p>
        </section>
        <section>
          <h3>{t("Primary evidence", "主な根拠")}</h3><ul>
            {
              evidence.map(([label, path]) => (
                <li>
                  <a href={evidenceHref(path)}>{label}</a>
                </li>
              ))
            }
          </ul><a href={withBase("/reference/component-versions/")}
            >{t("View component versions", "コンポーネントのバージョンを見る")} →</a
          >
        </section>
      </div>
    </details>
  </section>
</div>

<style>
  :global(main:has(.home-experience) > .content-panel:first-child) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  :global(main:has(.home-experience) > .content-panel:last-child) {
    padding-top: 0;
  }
  .home-experience {
    --home-width: 70rem;
  }
  .home-hero,
  .home-section {
    width: min(100%, var(--home-width));
    margin-inline: auto;
  }
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding: clamp(3.5rem, 9vw, 7.5rem) clamp(1rem, 3vw, 2rem)
      clamp(3rem, 7vw, 6rem);
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  .home-eyebrow {
    margin: 0;
    color: var(--tobari-control);
    font-size: var(--sl-text-xs);
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .home-hero h2 {
    max-width: 48rem;
    margin: 0.9rem 0 1.25rem;
    font-size: clamp(2.35rem, 5.7vw, 5.2rem);
    font-weight: 790;
    letter-spacing: -0.055em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .home-lead {
    max-width: 43rem;
    margin: 0;
    font-size: clamp(1.06rem, 1rem + 0.35vw, 1.3rem);
    line-height: 1.65;
  }
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .home-actions a {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border: 1px solid var(--sl-color-gray-4);
    color: var(--sl-color-white);
    font-weight: 750;
    text-decoration: none;
  }
  .home-actions a:hover,
  .home-actions a:focus-visible {
    border-color: var(--tobari-control);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .home-actions .primary {
    border-color: var(--tobari-control);
    background: var(--tobari-control);
    color: var(--sl-color-bg);
  }
  .home-caveat {
    max-width: 43rem;
    margin: 1.25rem 0 0;
    padding-inline-start: 0.8rem;
    border-inline-start: 0.25rem solid var(--tobari-warning);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .home-example {
    min-width: 0;
    border: 1px solid var(--sl-color-gray-4);
  }
  .home-example > p {
    margin: 0;
    padding: 0.8rem 1rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .home-example ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-example li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.2rem 0.6rem;
    padding: 0.9rem 1rem;
    border-block-end: 1px dashed var(--sl-color-gray-5);
  }
  .home-example li:last-child {
    border-block-end: 0;
  }
  .home-example li > span {
    grid-row: 1 / 3;
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
  }
  .home-example strong {
    font-size: var(--sl-text-sm);
  }
  .home-example code {
    width: fit-content;
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    overflow-wrap: anywhere;
  }
  .home-example .denied {
    color: var(--tobari-denied);
  }
  .home-example .allowed {
    color: var(--tobari-allowed);
  }
  .home-section {
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1rem, 3vw, 2rem);
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  .home-section > h2 {
    max-width: 49rem;
    margin: 0.55rem 0 0;
    font-size: clamp(1.75rem, 4vw, 3rem);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .home-intro {
    max-width: 46rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
  }
  .home-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.4rem);
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .home-flow li {
    position: relative;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-block-start: 0.22rem solid currentColor;
    background: var(--sl-color-bg);
    color: var(--tobari-control);
  }
  .home-flow li:not(:last-child)::after {
    position: absolute;
    z-index: 2;
    inset: 3.25rem calc(-1 * clamp(1.5rem, 3vw, 2.4rem)) auto auto;
    width: clamp(1.5rem, 3vw, 2.4rem);
    border-block-start: 2px solid currentColor;
    content: "";
  }
  .home-flow li:not(:last-child)::before {
    position: absolute;
    z-index: 3;
    inset: calc(3.25rem - 0.28rem) -0.05rem auto auto;
    width: 0.55rem;
    height: 0.55rem;
    border-block-start: 2px solid currentColor;
    border-inline-end: 2px solid currentColor;
    content: "";
    transform: rotate(45deg);
  }
  .home-flow .flow-network {
    color: var(--tobari-network);
  }
  .home-flow .flow-denied {
    color: var(--tobari-denied);
  }
  .home-flow .flow-control {
    color: var(--tobari-control);
  }
  .home-flow .flow-allowed {
    color: var(--tobari-allowed);
  }
  .home-flow-number {
    color: inherit;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 850;
  }
  .home-flow-route {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.45rem;
    align-items: center;
    margin: 0.45rem 0 0;
    color: inherit;
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    line-height: 1.35;
  }
  .home-flow-route b {
    font-size: 1rem;
  }
  .home-flow h3 {
    margin: 0.8rem 0 0.45rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
  }
  .home-flow-detail {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .home-more {
    margin: 1.5rem 0 0;
    text-align: end;
  }
  .home-more a {
    font-weight: 750;
  }
  .home-tasks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-5);
  }
  .home-tasks a {
    position: relative;
    min-width: 0;
    min-height: 9rem;
    padding: 1.15rem 3rem 1.15rem 1.15rem;
    background: var(--sl-color-bg);
    color: inherit;
    text-decoration: none;
  }
  .home-tasks a:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    min-height: 7rem;
  }
  .home-tasks a:hover,
  .home-tasks a:focus-visible {
    box-shadow: inset 0 -0.25rem 0 var(--tobari-control);
  }
  .home-tasks h3 {
    margin: 0;
    font-size: var(--sl-text-lg);
  }
  .home-tasks p {
    max-width: 34rem;
    margin: 0.55rem 0 0;
    color: var(--sl-color-gray-2);
  }
  .home-tasks span {
    position: absolute;
    inset: auto 1rem 0.9rem auto;
    color: var(--tobari-control);
    font-size: 1.4rem;
  }
  .home-boundaries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 4vw, 3rem);
    margin-top: 2rem;
