---
const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const t = <T,>(english: T, japanese: T) => (isJapanese ? japanese : english);
const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}${isJapanese ? "ja/" : ""}${path.replace(/^\//, "")}`;
const evidenceHref = (path: string) =>
  `${__TOBARI_DOCS_REPOSITORY__}/blob/${__TOBARI_DOCS_COMMIT__}/${path}`;

const steps = [
  {
    title: t("The agent attempts a request", "エージェントが通信を試す"),
    detail: t(
      "A tool in the selected project's working environment sends an HTTP or HTTPS request to an external service.",
      "選んだプロジェクトの作業環境から、外部サービスへ HTTP または HTTPS リクエストを送ります。",
    ),
  },
  {
    title: t(
      "Tobari stops it and keeps review evidence",
      "Tobari が止めて、確認材料を残す",
    ),
    detail: t(
      "Tobari does not connect to an undeclared destination. It retains bounded, secret-free evidence such as destination, method, and path for host-side review.",
      "未許可の通信には接続せず、秘密情報を含まない範囲で、宛先・メソッド・パスなどを確認できるようにします。",
    ),
  },
  {
    title: t(
      "A person allows only the exact effect",
      "人が確認し、必要な通信だけを許可する",
    ),
    detail: t(
      "On the trusted host, you allow or deny the exact communication. Allowing policy does not replay the request; you deliberately issue a new one.",
      "信頼するホストで完全一致の通信を許可または拒否します。許可しても自動再送はせず、利用者が新しいリクエストを実行します。",
    ),
  },
];

const tasks = [
  {
    href: "/start/quickstart/",
    title: t("I want to try it", "まず動かしてみたい"),
    detail: t(
      "Experience denial, review, allow, and deliberate retry in a synthetic project.",
      "練習用プロジェクトで、拒否・確認・許可・再実行を一度体験します。",
    ),
  },
  {
    href: "/start/first-denial/",
    title: t("A request was denied", "通信が拒否された"),
    detail: t(
      "Find why it stopped, where to review it, and what can be allowed.",
      "なぜ止まったか、どこで確認し、何を許可できるかを調べます。",
    ),
  },
  {
    href: "/guides/authentication/",
    title: t(
      "I need GitHub or another supported login",
      "GitHub などの認証を使いたい",
    ),
    detail: t(
      "Configure supported credentials without placing their primary value in the Workspace.",
      "対応する認証情報を Workspace に実物の値を渡さず設定する方法を確認します。",
    ),
  },
  {
    href: "/security/guarantees-and-limitations/",
    title: t("I need the security boundary", "何が守られるか確認したい"),
    detail: t(
      "Read each guarantee with its prerequisites, exclusions, and trusted components.",
      "保証の前提、守らない範囲、信頼する部品を一緒に確認します。",
    ),
  },
  {
    href: "/reference/cli/",
    title: t("I need a command", "コマンドを調べたい"),
    detail: t(
      "Choose a command by task, then open its generated contract.",
      "やりたい作業からコマンドを選び、生成された正確な契約を開きます。",
    ),
  },
];

const protectedItems = t(
  [
    "Host files outside the selected project and Docker control",
    "Another Workspace's network and persistent home",
    "Unauthorized outbound HTTP/HTTPS and primary credentials managed by Broker",
  ],
  [
    "選んだプロジェクトの外にあるホストのファイルと Docker 制御",
    "別の Workspace のネットワークと永続ホーム",
    "許可されていない外向き HTTP/HTTPS 通信と、Broker が管理する実物の認証情報",
  ],
);
const excludedItems = t(
  [
    "Files inside the selected project",
    "Data sent to a destination you explicitly allow",
    "A compromised host, Docker, kernel, enforcement service, or communication outside ordinary HTTP/HTTPS",
  ],
  [
    "選んだプロジェクト内のファイル",
    "明示的に許可した宛先へ送るデータ",
    "侵害されたホスト、Docker、カーネル、境界を実施するサービス、または通常の HTTP/HTTPS 以外の通信",
  ],
);
const evidence = [
  [t("Product contract", "製品契約"), "docs/01_product_contract.md"],
  [t("Security model", "セキュリティモデル"), "docs/03_security_model.md"],
  [
    t("Supported network topology", "対応するネットワーク構成"),
    "internal/infra/runtimeassets/assets/compose.yaml",
  ],
  [
    t("End-to-end boundary tests", "一連の境界動作を確認するテスト"),
    "scripts/test-integration.sh",
  ],
] as const;
---

<div class="home-experience">
  <section class="home-hero">
    <div>
      <p class="home-eyebrow">
        {
          t(
            "A coding-agent execution boundary",
            "コーディングエージェントの実行境界",
          )
        }
      </p>
      <h2>
        {
          t(
            "Run a coding agent inside one selected project.",
            "コーディングエージェントを、選んだプロジェクトの中で動かす。",
          )
        }
      </h2>
      <p class="home-lead">
        {
          t(
            "Outbound HTTP and HTTPS communication starts denied. Review what the agent attempted, allow only the exact communication you need, and then issue a new request.",
            "外部への HTTP/HTTPS 通信は、最初に止めます。内容を確認し、必要な通信だけを完全一致で許可してから、もう一度実行します。",
          )
        }
      </p>
      <div class="home-actions">
        <a class="primary" href={withBase("/start/quickstart/")}>
          {t("Try it in five minutes", "5分で試す")}
        </a>
        <a href="#basic-operation">
          {t("See how it works in 60 seconds", "60秒で仕組みを見る")}
        </a>
      </div>
      <p class="home-caveat">
        {
          t(
            "Important: files inside the selected project are not protected from the agent. The agent can read and write that mounted project.",
            "重要: 選んだプロジェクト内のファイルは、Tobari の保護対象ではありません。エージェントはその範囲を読み書きできます。",
          )
        }
      </p>
    </div>

    <aside
      class="home-example"
      aria-label={t("Example first denial", "最初の拒否の例")}
    >
      <p>{t("Example first denial", "最初の拒否の例")}</p>
      <ol>
        <li>
          <span>01</span><strong
            >{t("Agent requests", "エージェントが通信")}</strong
          ><code>PUT example.com/quickstart</code>
        </li>
        <li>
          <span>02</span><strong>{t("Tobari denies", "Tobari が拒否")}</strong
          ><code class="denied">403 policy_denied</code>
        </li>
        <li>
          <span>03</span><strong>{t("Host reviews", "ホストで確認")}</strong
          ><code>tobari policy review</code>
        </li>
        <li>
          <span>04</span><strong>{t("User retries", "利用者が再実行")}</strong
          ><code class="allowed">new request</code>
        </li>
      </ol>
    </aside>
  </section>

  <section class="home-section" id="basic-operation">
    <p class="home-eyebrow">
      {t("The basic operation in 60 seconds", "60秒で分かる基本動作")}
    </p>
    <h2>
      {
        t(
          "Stop it, review it, then allow only what is needed",
          "止める、確認する、必要なものだけ通す",
        )
      }
    </h2>
    <p class="home-intro">
      {
        t(
          "You do not need to learn every component first. From the user's point of view, the loop has three stages.",
          "最初は部品名を覚える必要はありません。利用者から見える流れは三段階です。",
        )
      }
    </p>
    <ol class="home-flow">
      {
        steps.map((step, index) => (
          <li>
            <>
              <span>{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </>
          </li>
        ))
      }
    </ol>
    <p class="home-more">
      <a href={withBase("/how-it-works/request-journey/")}
        >{t("See the complete component flow", "部品を含む完全な流れを見る")} →</a
      >
    </p>
  </section>

  <section class="home-section">
    <p class="home-eyebrow">
      {t("Start from your question", "知りたいことから進む")}
    </p>
    <h2>
      {
        t(
          "Choose the entry closest to what you need now",
          "今の目的に近い入口を選ぶ",
        )
      }
    </h2>
    <div class="home-tasks">
      {
        tasks.map((task) => (
          <a href={withBase(task.href)}>
            <>
              <h3>{task.title}</h3>
              <p>{task.detail}</p>
              <span aria-hidden="true">→</span>
            </>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <p class="home-eyebrow">
      {t("Know the scope early", "先に知っておく範囲")}
    </p>
    <h2>
      {
        t(
          "What the boundary protects—and what it does not",
          "守るものと、守らないもの",
        )
      }
    </h2>
    <div class="home-boundaries">
      <section>
        <h3>
          {t("Protected in the supported topology", "対応する構成で守るもの")}
        </h3><ul>{protectedItems.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section class="excluded">
        <h3>{t("Not protected by Tobari", "Tobari が守らないもの")}</h3><ul>
          {excludedItems.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>
    <p class="home-more">
      <a href={withBase("/security/guarantees-and-limitations/")}
        >{
          t(
            "Read guarantees with their prerequisites",
            "保証と制限を前提条件から読む",
          )
        } →</a
      >
    </p>
  </section>

  <section class="home-section home-evidence">
    <details>
      <summary
        >{
          t(
            "View current implementation status and evidence",
            "現在の実装状態と根拠を見る",
          )
        }</summary
      >
      <div>
        <section>
          <h3>{t("Implemented now", "現在実装している範囲")}</h3><p>
            {
              t(
                "Project-bound Workspace lifecycle, shared Gateway, OPA, and Auth Broker services, default-deny exact policy learning, intercepted HTTP/HTTPS, supported credential paths, and Catalog-generated CLI contracts.",
                "プロジェクトに結び付く Workspace のライフサイクル、共有する Gateway・OPA・Auth Broker、デフォルト拒否から始まる完全一致のポリシー学習、検査対象となる HTTP/HTTPS、対応する認証経路、Catalog から生成する CLI 契約です。",
              )
            }
          </p>
        </section>
        <section>
          <h3>{t("Compatibility", "互換性")}</h3><p>
            {
              t(
                "Tobari is pre-v1. Schema versions and migration rules define current compatibility; not every external interface is frozen.",
                "Tobari は v1 より前です。現在の互換性はスキーマバージョンと移行規則で定めますが、すべての外部仕様が固定されたという約束ではありません。",
              )
            }
          </p>
        </section>
        <section>
          <h3>{t("Primary evidence", "主な根拠")}</h3><ul>
            {
              evidence.map(([label, path]) => (
                <li>
                  <a href={evidenceHref(path)}>{label}</a>
                </li>
              ))
            }
          </ul><a href={withBase("/reference/component-versions/")}
            >{t("View component versions", "コンポーネントバージョンを見る")} →</a
          >
        </section>
      </div>
    </details>
  </section>
</div>

<style>
  :global(main:has(.home-experience) > .content-panel:first-child) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  :global(main:has(.home-experience) > .content-panel:last-child) {
    padding-top: 0;
  }
  .home-experience {
    --home-width: 70rem;
  }
  .home-hero,
  .home-section {
    width: min(100%, var(--home-width));
    margin-inline: auto;
  }
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding: clamp(3.5rem, 9vw, 7.5rem) clamp(1rem, 3vw, 2rem)
      clamp(3rem, 7vw, 6rem);
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  .home-eyebrow {
    margin: 0;
    color: var(--tobari-control);
    font-size: var(--sl-text-xs);
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .home-hero h2 {
    max-width: 48rem;
    margin: 0.9rem 0 1.25rem;
    font-size: clamp(2.35rem, 5.7vw, 5.2rem);
    font-weight: 790;
    letter-spacing: -0.055em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .home-lead {
    max-width: 43rem;
    margin: 0;
    font-size: clamp(1.06rem, 1rem + 0.35vw, 1.3rem);
    line-height: 1.65;
  }
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .home-actions a {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border: 1px solid var(--sl-color-gray-4);
    color: var(--sl-color-white);
    font-weight: 750;
    text-decoration: none;
  }
  .home-actions a:hover,
  .home-actions a:focus-visible {
    border-color: var(--tobari-control);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .home-actions .primary {
    border-color: var(--tobari-control);
    background: var(--tobari-control);
    color: var(--sl-color-bg);
  }
  .home-caveat {
    max-width: 43rem;
    margin: 1.25rem 0 0;
    padding-inline-start: 0.8rem;
    border-inline-start: 0.25rem solid var(--tobari-warning);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .home-example {
    min-width: 0;
    border: 1px solid var(--sl-color-gray-4);
  }
  .home-example > p {
    margin: 0;
    padding: 0.8rem 1rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .home-example ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-example li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.2rem 0.6rem;
    padding: 0.9rem 1rem;
    border-block-end: 1px dashed var(--sl-color-gray-5);
  }
  .home-example li:last-child {
    border-block-end: 0;
  }
  .home-example li > span {
    grid-row: 1 / 3;
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 800;
  }
  .home-example strong {
    font-size: var(--sl-text-sm);
  }
  .home-example code {
    width: fit-content;
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    overflow-wrap: anywhere;
  }
  .home-example .denied {
    color: var(--tobari-denied);
  }
  .home-example .allowed {
    color: var(--tobari-allowed);
  }
  .home-section {
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1rem, 3vw, 2rem);
    border-block-end: 1px solid var(--sl-color-gray-5);
  }
  .home-section > h2 {
    max-width: 49rem;
    margin: 0.55rem 0 0;
    font-size: clamp(1.75rem, 4vw, 3rem);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .home-intro {
    max-width: 46rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
  }
  .home-flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .home-flow li {
    min-width: 0;
    padding-block-start: 1rem;
    border-block-start: 0.18rem solid var(--tobari-control);
  }
  .home-flow li > span {
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-weight: 800;
  }
  .home-flow h3 {
    margin: 0.7rem 0 0.45rem;
    font-size: var(--sl-text-lg);
  }
  .home-flow p {
    margin: 0;
    color: var(--sl-color-gray-2);
  }
  .home-more {
    margin: 1.5rem 0 0;
    text-align: end;
  }
  .home-more a {
    font-weight: 750;
  }
  .home-tasks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-5);
  }
  .home-tasks a {
    position: relative;
    min-width: 0;
    min-height: 9rem;
    padding: 1.15rem 3rem 1.15rem 1.15rem;
    background: var(--sl-color-bg);
    color: inherit;
    text-decoration: none;
  }
  .home-tasks a:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    min-height: 7rem;
  }
  .home-tasks a:hover,
  .home-tasks a:focus-visible {
    box-shadow: inset 0 -0.25rem 0 var(--tobari-control);
  }
  .home-tasks h3 {
    margin: 0;
    font-size: var(--sl-text-lg);
  }
  .home-tasks p {
    max-width: 34rem;
    margin: 0.55rem 0 0;
    color: var(--sl-color-gray-2);
  }
  .home-tasks span {
    position: absolute;
    inset: auto 1rem 0.9rem auto;
    color: var(--tobari-control);
    font-size: 1.4rem;
  }
  .home-boundaries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 4vw, 3rem);
    margin-top: 2rem;
  }
  .home-boundaries > section {
    padding-block-start: 1rem;
    border-block-start: 0.18rem solid var(--tobari-allowed);
  }
  .home-boundaries .excluded {
    border-block-start-color: var(--tobari-warning);
  }
  .home-boundaries h3 {
    margin: 0;
  }
  .home-boundaries ul {
    margin-bottom: 0;
    padding-inline-start: 1.25rem;
  }
  .home-boundaries li + li {
    margin-top: 0.65rem;
  }
  .home-evidence {
    border-block-end: 0;
  }
  .home-evidence details {
    border: 1px solid var(--sl-color-gray-5);
  }
  .home-evidence summary {
    padding: 1rem 1.1rem;
    cursor: pointer;
    font-weight: 750;
  }
  .home-evidence details > div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 0 1.1rem 1.1rem;
  }
  .home-evidence h3 {
    margin: 0 0 0.4rem;
    font-size: var(--sl-text-base);
  }
  .home-evidence p,
  .home-evidence ul {
    margin-top: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  @media (max-width: 52rem) {
    .home-hero,
    .home-flow,
    .home-boundaries,
    .home-evidence details > div {
      grid-template-columns: 1fr;
    }
    .home-hero {
      padding-top: 3rem;
    }
    .home-example {
      max-width: 36rem;
    }
  }
  @media (max-width: 38rem) {
    .home-actions {
      display: grid;
    }
    .home-actions a {
      width: 100%;
    }
    .home-tasks {
      grid-template-columns: 1fr;
    }
    .home-tasks a:last-child:nth-child(odd) {
      grid-column: auto;
    }
    .home-more {
      text-align: start;
    }
  }
  @media print {
    .home-actions,
    .home-tasks,
    .home-evidence {
      display: none;
    }
    .home-hero,
    .home-section {
      padding-inline: 0;
    }
    .home-example,
    .home-flow li,
    .home-boundaries > section {
      break-inside: avoid;
    }
  }
</style>
