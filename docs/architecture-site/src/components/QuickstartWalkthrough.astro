---
const isJapanese = Astro.locals.starlightRoute.locale === "ja";
const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}${isJapanese ? "ja/" : ""}${path.replace(/^\//, "")}`;
const repository = __TOBARI_DOCS_REPOSITORY__;
const productCommit = __TOBARI_DOCS_COMMIT__;
const evidenceHref = (path: string) =>
  `${repository}/blob/${productCommit}/${path}`;

const ui = isJapanese
  ? {
      intro:
        "練習用ディレクトリで、未許可の通信が拒否され、ホスト側のレビューを経て、新しいリクエストが外部へ届くまでを確認します。",
      prerequisite:
        "事前にインストールを完了し、対話型ターミナルを用意してください。このクイックスタートでは、標準のベースランタイムに含まれる `curl` だけを使って通信制御を確認します。コーディングエージェントや実際のリポジトリは必要ないため、空の練習用ディレクトリを使います。",
      install: "インストール手順を確認する",
      flowTitle: "このクイックスタートで追う通信経路",
      flowIntro:
        "コマンドを実行する前に、一つ目のリクエストがどこで止まり、ホスト側の操作後に新しいリクエストがどう進むかを番号順に確認します。",
      flowLabel: "横にスクロールできるクイックスタートの通信フロー",
      flowSteps: [
        {
          from: "Workspace",
          to: "Gateway",
          label: "未許可の PUT リクエストを送る",
          kind: "network",
        },
        {
          from: "Gateway",
          to: "接続先",
          label: "許可がないため、外部接続を作る前に拒否する",
          kind: "denied",
          blocked: true,
        },
        {
          from: "Gateway",
          to: "ホストでのレビュー",
          label: "通信条件を記録し、レビューコマンドを案内する",
          kind: "diagnostic",
        },
        {
          from: "ホストでのレビュー",
          to: "ポリシー",
          label: "完全一致の許可ルールを検証して有効化する",
          kind: "control",
        },
        {
          from: "Workspace",
          to: "Gateway",
          label: "同じ条件で新しいリクエストを送る",
          kind: "network",
        },
        {
          from: "Gateway",
          to: "接続先",
          label: "許可後に外部接続を作り、リクエストを中継する",
          kind: "allowed",
        },
      ],
      labels: {
        location: "実行場所",
        action: "操作",
        command: "コマンド",
        expected: "期待する結果",
        blocked: "進めないとき",
      },
      steps: [
        {
          title: "空の練習用ディレクトリで共有クラスターを起動する",
          location: "信頼するホスト",
          action:
            "空のディレクトリへ移動し、Gateway と OPA からなる共有クラスターを起動します。",
          command: `mkdir -p quickstart-example
cd quickstart-example
tobari cluster up`,
          expected:
            "共有クラスターが起動します。この時点では、プロジェクト用の Workspace はまだ作られません。",
          blocked:
            "`tobari doctor` と `tobari cluster status` を実行し、表示されたホスト側の前提条件を修正してから `tobari cluster up` を再実行します。",
        },
        {
          title: "Workspace から未許可のリクエストを送る",
          location: "ホスト → Workspace → ホスト",
          action:
            "ホストで `tobari` を実行し、推奨されるプロジェクト・Access・Tools・セッションを確認して Start Workspace を選びます。Workspace 内で練習用の PUT リクエストを送り、拒否を確認したら `exit` でホストへ戻ります。",
          command: `tobari

# Workspace 内
curl -sS -w '\\nhttp=%{http_code}\\n' \\
  -X PUT https://example.com/quickstart
exit`,
          expected:
            "初回はホスト設定を取り込まず、確認した default Workspace Manifest と Workspace を作成します。その後 HTTP 403 と `policy_denied` が表示され、ホスト側のレビューコマンドが案内されます。Gateway は接続先へ接続せず、リクエストを自動で許可・再送しません。`exit` 後も Workspace とその状態は残ります。",
          blocked:
            "`tobari` で Workspace に入るには、対話型ターミナルが必要です。イメージに関するエラーが出た場合は `tobari manifest show` を確認し、対応するランタイムを準備します。",
        },
        {
          title: "ホスト側で拒否内容をレビューし、完全一致で許可する",
          location: "信頼するホスト",
          action:
            "レビュー画面で Workspace Manifest、プロジェクト、ホスト、ポート、メソッド、パスを確認し、この通信条件だけを許可します。",
          command: `tobari review permissions --tail 100`,
          expected:
            "選択した通信条件の完全一致ルールが、ポリシー全体の検証後に有効になります。許可操作は、拒否された HTTP リクエストそのものを再送しません。",
          blocked:
            "候補が表示されない場合は、手順2で拒否が発生したことを確認してからレビューをやり直します。同じリクエストを無条件に繰り返し送らないでください。",
        },
        {
          title: "Workspace から同じ条件のリクエストを送り直す",
          location: "ホスト → Workspace → ホスト",
          action:
            "同じプロジェクトから Workspace へ入り直し、同じメソッドとパスの新しいリクエストを送ります。",
          command: `tobari

# Workspace 内
curl -sS -w '\\nhttp=%{http_code}\\n' \\
  -X PUT https://example.com/quickstart
exit`,
          expected:
            "今回は外部の接続先から HTTP 応答が返ります。`example.com` が返すステータスコード自体は保証しません。ここで確認するのは、許可した通信条件が外部への経路へ進んだことです。",
          blocked:
            "再び 403 になった場合は、Workspace Manifest、プロジェクト、ホスト、ポート、メソッド、パスが許可した条件と一致しているか確認し、`tobari review permissions --tail 100` を実行します。",
        },
        {
          title: "状態を確認して、練習用リソースを削除する",
          location: "信頼するホスト",
          action:
            "Workspace の状態を確認し、練習用 Workspace を削除してから、空になった共有クラスターを停止します。",
          command: `tobari status
tobari list
tobari delete
tobari cluster down --purge`,
          expected:
            "`delete` は Workspace の永続ホームと、Workspace が所有するランタイムリソースを削除します。練習用ディレクトリのファイルは削除しません。`cluster down --purge` は、共有 CA と有効なポリシーバンドルのボリュームも削除します。",
          blocked:
            "`cluster_not_empty` の場合は `tobari list` で残っている Workspace を確認し、それぞれを削除してから再実行します。接続中のセッションを意図的に終了する場合だけ `tobari delete --force` を使います。",
        },
      ],
      completionTitle: "確認できたこと",
      completion:
        "未許可の通信は接続先へ届く前に拒否されます。信頼するホストで通信条件をレビューし、完全一致で許可した後は、新しいリクエストとして同じ条件の通信を実行できます。",
      nextTitle: "次に、実作業用のランタイムを用意する",
      nextLinks: [
        [
          "カスタムランタイムを用意する（実作業の前に必要）",
          "/start/runtime-setup/",
        ],
        ["拒否された通信のレビュー", "/start/first-denial/"],
        ["リクエストを処理する順序", "/how-it-works/request-journey/"],
        ["保証が成立する前提と制限", "/security/guarantees-and-limitations/"],
        ["終了・削除・復旧後に残る状態", "/how-it-works/state-and-recovery/"],
      ],
      scriptSummary: "JSON の参照値を使って許可・拒否する",
      scriptIntro:
        "対話画面を使わない場合は、JSON に出力された不透明な ID を変更せず、そのまま許可・拒否コマンドへ渡します。表示順やリクエスト文字列から ID を再構成しないでください。",
      scriptCommand: `tobari review permissions --tail 100 --format json
tobari policy allow --id <exact-pcy-id-from-policy-review>`,
      scriptDeny:
        "拒否を確定する場合は、レビュー画面の拒否操作か `tobari policy deny --id <exact-pcy-id-from-policy-review>` を使います。",
      evidenceSummary: "手順の根拠を確認する",
      evidence: [
        ["Catalog にあるコマンド仕様", "internal/cli/runtime_catalog.go"],
        ["Catalog の契約テスト", "internal/cli/tobari_test.go"],
        ["公開クイックスタートの契約", "README.md"],
        ["一連の動作を確認する統合テスト", "scripts/test-integration.sh"],
      ],
    }
  : {
      intro:
        "Use a synthetic project to see one undeclared request stop, review and allow it on the host, and then send a new request that can reach the upstream path.",
      prerequisite:
        "Complete installation first and use an interactive terminal. This quickstart uses `curl` from the standard base runtime to exercise network control directly; it does not require a coding agent or a real repository. Use the empty synthetic directory below.",
      install: "Review installation",
      flowTitle: "The request path used in this quickstart",
      flowIntro:
        "Before running commands, follow where the first request stops and how a new request proceeds after the host-side policy change.",
      flowLabel: "Scrollable quickstart request flow",
      flowSteps: [
        {
          from: "Workspace",
          to: "Gateway",
          label: "Send one undeclared PUT request",
          kind: "network",
        },
        {
          from: "Gateway",
          to: "Upstream",
          label:
            "Stop before opening an external connection because no permission matches",
          kind: "denied",
          blocked: true,
        },
        {
          from: "Gateway",
          to: "Host review",
          label:
            "Record the communication dimensions and show the review command",
          kind: "diagnostic",
        },
        {
          from: "Host review",
          to: "Policy",
          label: "Validate and activate one exact allow rule",
          kind: "control",
        },
        {
          from: "Workspace",
          to: "Gateway",
          label: "Issue a new request with the same dimensions",
          kind: "network",
        },
        {
          from: "Gateway",
          to: "Upstream",
          label:
            "Open the external connection after allow and relay the request",
          kind: "allowed",
        },
      ],
      labels: {
        location: "Run this on",
        action: "What to do",
        command: "Command",
        expected: "Expected result",
        blocked: "If you cannot continue",
      },
      steps: [
        {
          title: "Create a synthetic project and start the shared cluster",
          location: "Trusted host",
          action:
            "Move into a dedicated empty directory and start the shared Gateway and OPA cluster.",
          command: `mkdir -p quickstart-example
cd quickstart-example
tobari cluster up`,
          expected:
            "The shared cluster starts and becomes ready. The project Workspace does not exist yet.",
          blocked:
            "Run `tobari doctor` and `tobari cluster status`, correct the reported host prerequisite, and then retry `tobari cluster up`.",
        },
        {
          title: "Enter the Workspace and send one request that will be denied",
          location: "Host → inside Workspace → host",
          action:
            "Run `tobari` on the host, review the recommended project/Access/Tools/session screen and choose Start Workspace, issue the synthetic PUT request inside the Workspace, then use `exit` to return to the host after observing the denial.",
          command: `tobari

# Inside the Workspace
curl -sS -w '\\nhttp=%{http_code}\\n' \\
  -X PUT https://example.com/quickstart
exit`,
          expected:
            "First use creates the reviewed default Workspace Manifest and Workspace without importing host configuration. You then receive HTTP 403 with `policy_denied` and a host-side review command. Tobari does not connect upstream, approve the request, or retry it. The Workspace and its state remain after `exit`.",
          blocked:
            "The root `tobari` entry requires an interactive terminal. For image errors, inspect `tobari manifest show` and prepare a compatible Runtime before entering again.",
        },
        {
          title: "Review the denial on the host and allow the exact effect",
          location: "Trusted host",
          action:
            "Inspect the Workspace Manifest, project, host, port, method, and path in the review screen, then allow only this exact communication.",
          command: `tobari review permissions --tail 100`,
          expected:
            "The exact rule becomes active after the complete policy is validated. The allow action does not replay the denied HTTP request.",
          blocked:
            "If no candidate appears, confirm that step 2 produced the denial and then review again. Do not loop the same request without checking its state.",
        },
        {
          title: "Re-enter the Workspace and issue a new request",
          location: "Host → inside Workspace → host",
          action:
            "Re-enter from the same project and deliberately send a new request with the same method and path.",
          command: `tobari

# Inside the Workspace
curl -sS -w '\\nhttp=%{http_code}\\n' \\
  -X PUT https://example.com/quickstart
exit`,
          expected:
            "The HTTP response now comes from the upstream. Tobari does not promise a particular status from `example.com`; this step shows that the authorized exact effect can reach the upstream path.",
          blocked:
            "If you receive 403 again, check that Workspace Manifest, project, host, port, method, and path match the reviewed effect, then run `tobari review permissions --tail 100`.",
        },
        {
          title: "Inspect state and remove the synthetic resources",
          location: "Trusted host",
          action:
            "Inspect the Workspace, delete the synthetic Workspace, and then stop the now-empty shared cluster.",
          command: `tobari status
tobari list
tobari delete
tobari cluster down --purge`,
          expected:
            "`delete` removes the Workspace persistent home and owned runtime resources, but not the synthetic project files. `cluster down --purge` also removes shared CA and active policy-bundle volumes.",
          blocked:
            "For `cluster_not_empty`, use `tobari list`, delete every remaining Workspace, and retry. Use `tobari delete --force` only when you intentionally want to terminate an attached session.",
        },
      ],
      completionTitle: "What you have now verified",
      completion:
        "You experienced Tobari denying an undeclared request, a person reviewing it on the host, an exact permission becoming active, and a deliberate new request reaching the upstream path.",
      nextTitle: "Next, prepare the runtime for real work",
      nextLinks: [
        [
          "Prepare a custom runtime (required before real project work)",
          "/start/runtime-setup/",
        ],
        ["What to inspect after a denial", "/start/first-denial/"],
        ["The complete request sequence", "/how-it-works/request-journey/"],
        ["Guarantees and exclusions", "/security/guarantees-and-limitations/"],
        [
          "State that survives exit, deletion, and recovery",
          "/how-it-works/state-and-recovery/",
        ],
      ],
      scriptSummary:
        "Use the JSON reference flow instead of the interactive screen",
      scriptIntro:
        "For redirected or scripted review, copy the opaque ID from JSON unchanged into the action. Do not derive an ID from row order or reconstruct it from request text.",
      scriptCommand: `tobari review permissions --tail 100 --format json
tobari policy allow --id <exact-pcy-id-from-policy-review>`,
      scriptDeny:
        "To keep the effect blocked, use the review UI's deny action or `tobari policy deny --id <exact-pcy-id-from-policy-review>`.",
      evidenceSummary: "View evidence for this walkthrough",
      evidence: [
        ["Catalog command specifications", "internal/cli/runtime_catalog.go"],
        ["Catalog contract tests", "internal/cli/tobari_test.go"],
        ["Public quickstart contract", "README.md"],
        ["End-to-end integration checks", "scripts/test-integration.sh"],
      ],
    };
---

<section class="quickstart-walkthrough">
  <p class="quickstart-intro">{ui.intro}</p>
  <aside class="quickstart-prerequisite">
    <p>{ui.prerequisite}</p>
    <a href={withBase("/start/install/")}>{ui.install} →</a>
  </aside>

  <section class="quickstart-flow-overview">
    <h2>{ui.flowTitle}</h2>
    <p>{ui.flowIntro}</p>
    <div class="quickstart-flow-scroll" tabindex="0" aria-label={ui.flowLabel}>
      <ol class="quickstart-flow">
        {
          ui.flowSteps.map((step, index) => (
            <li
              class:list={[`flow-${step.kind}`, step.blocked && "flow-blocked"]}
            >
              <span>{String(index + 1).padStart(2, "0")}</span>
              <small>
                <strong>{step.from}</strong>
                <b aria-hidden="true">{step.blocked ? "⊣" : "→"}</b>
                <strong>{step.to}</strong>
              </small>
              <p>{step.label}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <ol class="quickstart-steps">
    {
      ui.steps.map((step, index) => (
        <li class="quickstart-step">
          <header>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <small>{ui.labels.location}</small>
              <strong>{step.location}</strong>
              <h2>{step.title}</h2>
            </div>
          </header>
          <div class="quickstart-action">
            <h3>{ui.labels.action}</h3>
            <p>{step.action}</p>
          </div>
          <section class="quickstart-command">
            <h3>{ui.labels.command}</h3>
            <pre tabindex="0">
              <code>{step.command}</code>
            </pre>
          </section>
          <dl class="quickstart-result">
            <div>
              <dt>{ui.labels.expected}</dt>
              <dd>{step.expected}</dd>
            </div>
            <div>
              <dt>{ui.labels.blocked}</dt>
              <dd>{step.blocked}</dd>
            </div>
          </dl>
        </li>
      ))
    }
  </ol>

  <section class="quickstart-complete">
    <h2>{ui.completionTitle}</h2>
    <p>{ui.completion}</p>
  </section>

  <section class="quickstart-next">
    <h2>{ui.nextTitle}</h2>
    <ul>
      {
        ui.nextLinks.map(([label, path]) => (
          <li>
            <a href={withBase(path)}>{label} →</a>
          </li>
        ))
      }
    </ul>
  </section>

  <details class="quickstart-detail">
    <summary>{ui.scriptSummary}</summary>
    <p>{ui.scriptIntro}</p>
    <pre tabindex="0">
      <code>{ui.scriptCommand}</code>
    </pre>
    <p>{ui.scriptDeny}</p>
  </details>

  <details class="quickstart-detail">
    <summary>{ui.evidenceSummary}</summary>
    <ul>
      {
        ui.evidence.map(([label, path]) => (
          <li>
            <a href={evidenceHref(path)}>{label}</a>
          </li>
        ))
      }
    </ul>
  </details>
</section>

<style>
  .quickstart-walkthrough {
    max-width: 52rem;
  }
  .quickstart-intro {
    max-width: 48rem;
    font-size: clamp(1.05rem, 1rem + 0.2vw, 1.18rem);
    line-height: 1.72;
  }
  .quickstart-prerequisite {
    margin: 1.25rem 0 2.5rem;
    padding: 0.9rem 1rem;
    border-inline-start: 0.28rem solid var(--tobari-warning);
    background: var(--sl-color-gray-6);
  }
  .quickstart-prerequisite p {
    margin: 0;
  }
  .quickstart-prerequisite a {
    display: inline-block;
    margin-top: 0.55rem;
    font-weight: 750;
  }
  .quickstart-flow-overview {
    margin: 2.5rem 0 1rem;
    padding-block: 1.25rem 1.5rem;
    border-block: 1px solid var(--sl-color-gray-5);
  }
  .quickstart-flow-overview > h2 {
    margin: 0;
    font-size: var(--sl-text-xl);
  }
  .quickstart-flow-overview > p {
    max-width: 48rem;
    margin: 0.5rem 0 1rem;
    color: var(--sl-color-gray-2);
  }
  .quickstart-flow-scroll {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }
  .quickstart-flow {
    display: grid;
    grid-template-columns: repeat(6, minmax(10.5rem, 1fr));
    gap: 1.6rem;
    min-width: 72rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
  }
  .quickstart-flow li {
    position: relative;
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-block-start: 0.22rem solid currentColor;
    background: var(--sl-color-bg);
    color: var(--tobari-control);
  }
  .quickstart-flow li:not(:last-child)::after {
    position: absolute;
    z-index: 2;
    inset: 2.15rem -1.6rem auto auto;
    width: 1.6rem;
    border-block-start: 2px solid currentColor;
    content: "";
  }
  .quickstart-flow li:not(:last-child)::before {
    position: absolute;
    z-index: 3;
    inset: calc(2.15rem - 0.27rem) -0.05rem auto auto;
    width: 0.52rem;
    height: 0.52rem;
    border-block-start: 2px solid currentColor;
    border-inline-end: 2px solid currentColor;
    content: "";
    transform: rotate(45deg);
  }
  .quickstart-flow li > span {
    color: inherit;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 850;
  }
  .quickstart-flow small {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.35rem;
    align-items: center;
    margin-top: 0.35rem;
    color: inherit;
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    line-height: 1.35;
  }
  .quickstart-flow small b {
    font-size: 0.95rem;
  }
  .quickstart-flow p {
    margin: 0.65rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }
  .quickstart-flow .flow-network {
    color: var(--tobari-network);
  }
  .quickstart-flow .flow-denied {
    color: var(--tobari-denied);
  }
  .quickstart-flow .flow-diagnostic {
    color: var(--tobari-diagnostic);
  }
  .quickstart-flow .flow-control {
    color: var(--tobari-control);
  }
  .quickstart-flow .flow-allowed {
    color: var(--tobari-allowed);
  }
  .quickstart-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .quickstart-step {
    padding-block: clamp(2.2rem, 6vw, 4rem);
    border-block-start: 1px solid var(--sl-color-gray-5);
  }
  .quickstart-step > header {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
  }
  .quickstart-step > header > span {
    color: var(--tobari-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xl);
    font-weight: 850;
  }
  .quickstart-step header small,
  .quickstart-step header strong {
    display: block;
  }
  .quickstart-step header small {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
  }
  .quickstart-step header strong {
    margin-top: 0.1rem;
