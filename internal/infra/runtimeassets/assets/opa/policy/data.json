{
  "tobari": {
    "allowed_hosts": [
      "api.github.com",
      "example.com",
      "mock-upstream"
    ],
    "allowed_http_hosts": [
      "mock-upstream"
    ],
    "allowed_ports": {
      "https": [443],
      "http": [8080]
    },
    "read_methods": [
      "GET",
      "HEAD"
    ],
    "credentials": {
      "github-development": {
        "hosts": [
          "api.github.com"
        ]
      },
      "integration": {
        "hosts": [
          "mock-upstream"
        ]
      }
    },
    "deny_rules": [
      {
        "host": "api.github.com",
        "method": "POST",
        "path_prefix": "/repos/"
      },
      {
        "host": "mock-upstream",
        "method": "POST",
        "path_prefix": "/denied"
      },
      {
        "host": "mock-upstream",
        "method": "POST",
        "path_prefix": "/api/v1/"
      }
    ],
    "learned_allow_rules": []
  }
}
