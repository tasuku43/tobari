{
  "tobari": {
    "schema_version": 2,
    "boundary": {
      "ports": {
        "https": [443],
        "http": [8080]
      },
      "authorities": [
        {
          "scheme": "https",
          "host": "api.github.com",
          "ports": [443]
        },
        {
          "scheme": "https",
          "host": "example.com",
          "ports": [443]
        },
        {
          "scheme": "https",
          "host": "mock-upstream",
          "ports": [443]
        },
        {
          "scheme": "http",
          "host": "mock-upstream",
          "ports": [8080]
        }
      ],
      "graphql_endpoints": [
        {
          "scheme": "https",
          "host": "api.github.com",
          "port": 443,
          "path": "/graphql"
        },
        {
          "scheme": "http",
          "host": "mock-upstream",
          "port": 8080,
          "path": "/graphql"
        }
      ],
      "methods": {
        "read": [
          "GET",
          "HEAD"
        ],
        "write": [
          {
            "method": "POST",
            "exclude_path_prefixes": [
              "/repos/"
            ]
          }
        ]
      }
    },
    "credentials": {
      "github-development": {
        "hosts": [
          "api.github.com"
        ]
      },
      "integration": {
        "hosts": [
          "mock-upstream"
        ]
      }
    },
    "rules": {
      "baseline_denies": [
        {
          "host": "api.github.com",
          "method": "POST",
          "path_prefix": "/repos/"
        },
        {
          "host": "mock-upstream",
          "method": "POST",
          "path_prefix": "/denied"
        },
        {
          "host": "mock-upstream",
          "method": "POST",
          "path_prefix": "/api/v1/"
        }
      ],
      "learned_allows": [],
      "learned_denies": []
    }
  }
}
