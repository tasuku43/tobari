{
  "schema_version": 1,
  "host": "api.github.com",
  "authorities": [
    {"scheme": "https", "host": "api.github.com", "ports": [443]}
  ],
  "methods": {
    "read": ["GET", "HEAD"],
    "write": [
      {"method": "POST", "exclude_path_prefixes": ["/repos/"]}
    ]
  },
  "graphql_endpoints": [
    {"scheme": "https", "host": "api.github.com", "port": 443, "path": "/graphql"}
  ],
  "credential_profiles": [
    {"profile": "github-development", "host": "api.github.com"}
  ],
  "rules": []
}
