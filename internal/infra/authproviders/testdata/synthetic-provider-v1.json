{
  "schema_version": 1,
  "id": "example-token",
  "display_name": "Example API",
  "acquisition": {
    "mode": "stdin_import"
  },
  "credential": {
    "kind": "primary_secret"
  },
  "workspace_projections": [
    {
      "kind": "env",
      "name": "EXAMPLE_TOKEN",
      "template": "${HANDLE}"
    },
    {
      "kind": "complete_file",
      "path": ".config/example/auth.toml",
      "template": "provider = \"${PROVIDER_ID}\"\ndisplay_name = \"${DISPLAY_NAME}\"\ntoken = \"${HANDLE}\"\n"
    }
  ],
  "header_bindings": [
    {
      "target": {
        "scheme": "https",
        "host": "api.example.com",
        "port": 443
      },
      "source": {
        "header": "x-api-key",
        "formats": [
          "raw"
        ]
      },
      "destination": {
        "header": "x-api-key",
        "format": "raw",
        "secret_field": "primary_secret"
      },
      "secret_headers": [
        "x-api-key"
      ]
    }
  ]
}
