{
  "schema_version": 1,
  "id": "chatwork",
  "display_name": "Chatwork API for cwk",
  "acquisition": {
    "mode": "stdin_import"
  },
  "credential": {
    "kind": "primary_secret"
  },
  "workspace_projections": [
    {
      "kind": "env",
      "name": "CWK_API_TOKEN",
      "template": "${HANDLE}"
    }
  ],
  "header_bindings": [
    {
      "target": {
        "scheme": "https",
        "host": "api.chatwork.com",
        "port": 443
      },
      "source": {
        "header": "x-chatworktoken",
        "formats": [
          "raw"
        ]
      },
      "destination": {
        "header": "x-chatworktoken",
        "format": "raw",
        "secret_field": "primary_secret"
      },
      "secret_headers": [
        "x-chatworktoken"
      ]
    }
  ]
}
